    m_Localized: "<i>\u30A8\u30EB\u30C0\u30FC\u304C\u5C11\u3057\u304E\u3053\u3061\u306A\u304F\u54B3\u6255\u3044\u3092\u3059\u308B\u3002</i><br><br>\u30B4\u30DB\u30F3\u2026
      \u30C6\u30A4\u30DE\u30FC\u3088\u3002<br><br>\u623B\u3063\u3066\u304D\u3066\u304F\u308C\u3066\u3088\u304B\u3063\u305F\u3002\u304A\u524D\u306E\u304A\u304B\u3052\u3067\u3001\u3053\u306E\u5C0F\u3055\u306A\u6751\u306F\u6551\u308F\u308C\u305F\u3002\u8FD4\u3057\u304D\u308C\u306A\u3044\u501F\u308A\u304C\u3067\u304D\u305F\u306A\u3002"
