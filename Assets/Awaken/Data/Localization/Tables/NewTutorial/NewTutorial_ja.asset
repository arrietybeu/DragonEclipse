    m_Localized: "\u304A\u524D\u306E\u3053\u308C\u307E\u3067\u306E\u82E6\u52B4\u306B\u898B\u5408\u3046\u793C\u304C\u3067\u304D\u308C\u3070\u3044\u3044\u306E\u3060\u304C\u3001\u4ECA\u306F\u305D\u3046\u8C4A\u304B\u306A\u6642\u4EE3\u3068\u306F\u8A00\u3048\u3093\u2026<br><br>\u5730\u9707\u3068\u3042\u308C\u3060\u3051\u306E\u7834\u58CA\u306E\u5F8C\u3068\u306A\u308C\u3070\u2015\u2015"
