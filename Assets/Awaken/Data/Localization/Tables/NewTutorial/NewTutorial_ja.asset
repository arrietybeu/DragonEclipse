    m_Localized: "\u3046\u30FC\u3093\u3001\u78BA\u304B\u306B\u3002\u3060\u3051\u3069\u2026<br><br>\u6982\u306D\u5BFE\u51E6\u3067\u304D\u308B\u3068\u601D\u3046\u3088\u3002\u304D\u307F\u307B\u3069\u8155\u306E\u3044\u3044\u30C6\u30A4\u30DE\u30FC\u304C\u3064\u3044\u3066\u3044\u308B\u306E\u3060\u304B\u3089\u306D\u3002"
