    m_Localized: "<bounce w=0.7>\u8B1D\u8B1D\u4F60</bounce>\uFF0C\u8A13\u7DF4\u5BB6\u3002<br>\u6211\u5011\u90FD\u6B20\u4F60\u4E00\u547D\u3002<br><br>\u9858\u9F8D\u6307\u5F15\u4F60\u65B9\u5411\u3002"
