  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Barks_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: cd6dc0bc22391654f8b00bd60b61b07f, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8829885829830410400
  m_TableData:
  - m_Id: 328054419456
    m_Localized: "Il ne faut JAMAIS d\xE9ranger un Glarexus en train de m\xE9diter."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328100556800
    m_Localized: "Je me demande s'il est en train de r\xE9fl\xE9chir \xE0 quelque
      chose... ou s'il fait juste la sieste."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328100556801
    m_Localized: "Les Glarexus sont des \xEAtres hautement spirituels, tout comme
      les humains. "
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328100556802
    m_Localized: "Les Golomos sont des \xEAtres introvertis, qui ont tendance \xE0
      rester dans leur coin."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751104
    m_Localized: "Je me demande ce qu'il peut bien avoir en t\xEAte... si tant est
      qu'il soit capable de penser."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751105
    m_Localized: "Passer ses journ\xE9es assis \xE0 ne rien faire... Quelle vie\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751106
    m_Localized: "Les Icelings sont vraiment utiles en \xE9t\xE9. Ils aident \xE0
      garder les boissons fra\xEEches\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751107
    m_Localized: "On utilise les terriers des Icelings comme des r\xE9frig\xE9rateurs
      pour y stocker la nourriture. Malin, non\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751108
    m_Localized: "Les Icelings sont des cr\xE9atures timides, qui ont tendance \xE0
      rester dans leur repaire."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751109
    m_Localized: "Ce Pinequeak semble d\xE9termin\xE9 \xE0 d\xE9chiqueter ce mannequin."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751110
    m_Localized: "Je me demande si c'est parce qu'il a vraiment envie de s'entra\xEEner,
      ou s'il cherche juste \xE0 passer ses nerfs sur quelque chose."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751111
    m_Localized: "Heureusement que ce n'est pas moi qu'il frappe avec ses petits
      poings\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751112
    m_Localized: Les Pinequeaks sont toujours aussi dingues...
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751113
    m_Localized: "Les Prowlers transportent les lettres d'un village \xE0 l'autre."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751114
    m_Localized: "Quelqu'un a re\xE7u une lettre\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751115
    m_Localized: "Je ferais bien d'\xE9crire \xE0 ma tante, pour m'assurer que tout
      va bien dans son village."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523639820288
    m_Localized: "Y a-t-il encore du courrier \xE0 livrer\_? Parce que les Prowlers
      ne devraient pas tarder \xE0 se mettre en route..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523660791808
    m_Localized: "Si seulement les Prowlers pouvaient parler\_! Ils ont d\xFB en
      entendre, des potins, au cours de leurs voyages."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523660791809
    m_Localized: "Les Prowlers sont d'excellents travailleurs, qui sont pay\xE9s
      en or, comme les autres. Je me demande \xE0 quoi ils le d\xE9pensent..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751116
    m_Localized: "Ha\_! Il passe ses jours \xE0 p\xEAcher. \xC7a a l'air d'\xEAtre
      une vie paisible."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751117
    m_Localized: "Il a r\xE9ussi \xE0 attraper un poisson\_! Il va finir par me donner
      faim, \xE0 force..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751118
    m_Localized: "\xC7a fait plusieurs semaines que cet Eftus p\xEAche ici, mais
      jusque-l\xE0, je ne l'ai vu attraper que des bottes et des bo\xEEtes de conserve.
      Il en fait peut-\xEAtre collection..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751119
    m_Localized: "Ah, si je pouvais moi aussi \xEAtre un Fale et passer mes journ\xE9es
      \xE0 batifoler dans l'eau..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751120
    m_Localized: C'est vrai que les Fales sont craquants, mais il ne faut pas s'y
      tromper, leurs dents sont coupantes comme des rasoirs.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751121
    m_Localized: La langue des Fales sort toujours de leur bouche. Je me demande
      s'ils s'en servent comme d'une pagaie quand ils nagent...
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751122
    m_Localized: "Ce Bolb a l'air de bien s'amuser. J'aurais bien voulu qu'il m'invite
      \xE0 sa petite f\xEAte."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751123
    m_Localized: "Les Bolbs sont capables de se fondre dans la plupart des environnements.
      Quand ils se montrent, c'est g\xE9n\xE9ralement parce qu'ils nous appr\xE9cient."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751124
    m_Localized: "Je savais bien que ces Bolbs n'\xE9taient pas fain\xE9ants. Ils
      conservent juste leur \xE9nergie pour pouvoir danser\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523660791810
    m_Localized: "Quand on se sent surveill\xE9 dans les bois, c'est sans doute qu'un
      Bolb est en train de s'assurer qu'on ne veut aucun mal aux siens."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751125
    m_Localized: "Le souffle ardent de ce Frogmar tient les \u0153ufs du couvoir
      bien au chaud."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751126
    m_Localized: "Ce Frogmar fait tr\xE8s attention avec son souffle. \xC7a se voit
      qu'il prend son travail tr\xE8s au s\xE9rieux\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751127
    m_Localized: J'aimerais bien avoir un Frogmar pour chauffer l'eau de mon bain.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751128
    m_Localized: "Tout le monde participe \xE0 la vie et au bien-\xEAtre du village.
      Ce Frogmar veille \xE0 ce que la prochaine g\xE9n\xE9ration de Mystlings puisse
      \xE9clore comme pr\xE9vu."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751132
    m_Localized: "Moi aussi, j'\xE9tais dompteur, dans le temps, et puis... J'ai
      d\xE9j\xE0 entendu \xE7a quelque part."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751133
    m_Localized: "Je me r\xE9veille \xE0 4\_heures du matin, je fais un peu d'exercice,
      je prends mon petit-d\xE9jeuner, et apr\xE8s, c'est parti pour une journ\xE9e
      d'entra\xEEnement. Mais j'aimerais bien avoir des amis..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751134
    m_Localized: "Tu vois ce Pinequeak, l\xE0-bas\_? Quand on a autant de d\xE9termination
      que lui, on peut tout faire\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751135
    m_Localized: "Si on s'entra\xEEne dur, on aura une chance contre l'\xC9clipse."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751136
    m_Localized: "Tu as faim\_? Notre village a la meilleure cuisine de ce c\xF4t\xE9
      des montagnes\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751137
    m_Localized: "Tu es bien trop maigre\_! Viens, je vais te donner \xE0 manger."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751138
    m_Localized: "Viens go\xFBter notre plat du jour\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 328104751139
    m_Localized: "Ici, la nourriture est excellente, et la compagnie l'est tout autant\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523660791811
    m_Localized: "Tu ne manques pas de talent. La sagesse et la ma\xEEtrise viendront
      avec le temps."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523660791812
    m_Localized: "Savoir que le d\xE9fi est immense mais accepter de le relever quand
      m\xEAme, c'est \xE7a, le vrai courage."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 10483523660791813
    m_Localized: "Ah, il est presque l'heure de ma sieste d'avant d\xEEner. C'est
      que \xE7a fait d\xE9j\xE0 une heure que je me suis r\xE9veill\xE9 de ma sieste
      de l'apr\xE8s-midi..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 18157794981822464
    m_Localized: "Vas-y, prends donc une friandise pour tes Mystlings\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 18157794994405376
    m_Localized: "\xC7a me fait plaisir de te voir. Prends donc un petit quelque
      chose \xE0 manger pour la route."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 18157794994405377
    m_Localized: "Ah, tu arrives juste \xE0 temps\_! Tiens, j'ai fait \xE7a pour
      toi."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 18157794994405378
    m_Localized: "Bon app\xE9tit et bon voyage\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 18157794994405379
    m_Localized: "N'h\xE9site pas \xE0 revenir si tu as encore faim\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
  - m_Id: 18157794994405380
    m_Localized: "Bon voyage\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410400
