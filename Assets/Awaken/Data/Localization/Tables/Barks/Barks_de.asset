  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Barks_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: cd6dc0bc22391654f8b00bd60b61b07f, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8829885829830410401
  m_TableData:
  - m_Id: 328054419456
    m_Localized: "Du solltest einen meditierenden Glarexus NIEMALS st\xF6ren."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328100556800
    m_Localized: "Ich frage mich, ob er an etwas denkt ... oder einfach nur schl\xE4ft."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328100556801
    m_Localized: 'Glarexi sind sehr spirituelle Kreaturen, wie Menschen. '
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328100556802
    m_Localized: Golomos bleiben bevorzugt unter sich. Sie sind die Personifizierung
      von Introvertiertheit.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751104
    m_Localized: "Woran er wohl denkt? Falls er \xFCberhaupt denkt ..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751105
    m_Localized: "Einfach dazusitzen und den ganzen Tag nichts tun ... was f\xFCr
      ein Leben!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751106
    m_Localized: "Icelinge sind an Sommertagen \xE4u\xDFerst hilfreich, denn sie
      k\xFChlen deine Getr\xE4nke."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751107
    m_Localized: "Wir nutzen Iceling-H\xF6hlen als K\xFChlschrank f\xFCr unsere Lebensmittel.
      Fantastische Erfindung!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751108
    m_Localized: "Icelinge sind scheu und halten sich meist in ihrer H\xF6hle auf."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751109
    m_Localized: "Dieser Pinequeak ist damit besch\xE4ftigt, diese Attrappe in St\xFCcke
      zu rei\xDFen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751110
    m_Localized: "Ich frage mich, ob er verbissen trainiert oder vielleicht w\xFCtend
      ist."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751111
    m_Localized: Ich bin nur froh, dass nicht ich diese Fausthiebe abbekomme.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751112
    m_Localized: "Pinequeak, w\xFCtend wie immer."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751113
    m_Localized: "Prowler sind f\xFCr den Briefverkehr zwischen den D\xF6rfern verantwortlich."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751114
    m_Localized: Jemand hat einen Brief erhalten!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751115
    m_Localized: Ich sollte meiner Tante, die in einem anderen Dorf wohnt, schreiben
      und sie fragen, wie es ihr geht.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523639820288
    m_Localized: Gibt es noch mehr Post? Die Prowler brechen bald auf.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523660791808
    m_Localized: "Ich w\xFCnschte, die Prowler k\xF6nnten sprechen. Auf ihren Reisen
      schnappen sie bestimmt unheimlich viele Ger\xFCchte auf."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523660791809
    m_Localized: "Prowler sind gesch\xE4tzte Arbeiter und werden mit M\xFCnzen bezahlt.
      Ich frage mich nur, wof\xFCr sie ihr Geld ausgeben ..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751116
    m_Localized: Seht ihn euch an, er angelt den ganzen Tag. Sieht nach einem friedlichen
      Leben aus.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751117
    m_Localized: Er hat einen Fisch gefangen! Jetzt werde ich langsam hungrig.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751118
    m_Localized: "Ich sehe den Eftus hier seit Wochen angeln, aber er f\xE4ngt nur
      Schuhe und Dosen. Vielleicht hat er eine Sammlung angefangen ..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751119
    m_Localized: Oh, ein Fale zu sein und den ganzen Tag lang niedlich auszusehen
      und zu planschen ...
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751120
    m_Localized: "Aber lass dich nicht t\xE4uschen - sie sehen zwar niedlich aus,
      aber ihre Z\xE4hne sind spitz wie Nadeln."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751121
    m_Localized: "Dem Fale h\xE4ngt immer die Zunge raus. Nutzt er sie vielleicht
      zum Schwimmen?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751122
    m_Localized: "Dieser Bolb scheint eine Ein-Mann-Party zu feiern. Ich w\xFCnschte,
      ich w\xE4re eingeladen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751123
    m_Localized: "Bolbs verschmelzen meist problemlos mit ihrer Umgebung. Wenn sie
      aber ihr Versteck verlassen und herauskommen, dann scheinen sie dich zu m\xF6gen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751124
    m_Localized: "Ich wei\xDF, dass Bolbs nicht faul sind. Sie heben sich ihre Energie
      nur f\xFCr eine Tanzauff\xFChrung auf!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523660791810
    m_Localized: "Hast du das Gef\xFChl, der Wald hat Augen? Dann ist das nur ein
      Bolb, der dich beobachtet, um sich zu vergewissern, dass du keine Bedrohung
      bist."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751125
    m_Localized: "Der Feueratem der Frogmar versorgt die Brutst\xE4tte mit Energie.
      Die Eier haben es gem\xFCtlich und warm."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751126
    m_Localized: Dieser Frogmar ist mit seinem Atem sehr vorsichtig. Er nimmt seine
      Aufgabe sehr ernst.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751127
    m_Localized: "Ich w\xFCnschte, ich h\xE4tte einen Frogmar, um das Bad zu heizen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751128
    m_Localized: "Alle leisten ihren Beitrag zum Wohl des Dorfes. Dieser Frogmar
      sorgt daf\xFCr, dass eine neue Generation Mystlinge wohlbehalten schl\xFCpft."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751132
    m_Localized: "Fr\xFCher war ich auch ein B\xE4ndiger, aber dann ... Das hab ich
      schon mal irgendwo geh\xF6rt."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751133
    m_Localized: "Ich stehe um 4 Uhr auf, mache Fr\xFChsport, fr\xFChst\xFCcke und
      trainiere dann. Ich w\xFCnschte, ich h\xE4tte Freunde."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751134
    m_Localized: "Siehst du den Pinequeak dort dr\xFCben? Mit einer solchen Hingabe
      kannst du alles erreichen!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751135
    m_Localized: Trainiere hart, damit wir eine Chance gegen die Finsternis haben.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751136
    m_Localized: "Hunger? Wir haben die beste K\xFCche diesseits der Berge!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751137
    m_Localized: "Du bist viel zu d\xFCnn! Komm, ich hol dir was Leckeres!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751138
    m_Localized: Sieh dir unser Tagesgericht an!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 328104751139
    m_Localized: Fantastisches Essen und noch bessere Gesellschaft!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523660791811
    m_Localized: "Du bist sehr talentiert, junger B\xE4ndiger. Weisheit und F\xE4higkeiten
      kommen im Laufe der Zeit dazu."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523660791812
    m_Localized: "Zu wissen, dass die Herausforderung gro\xDF ist und sie dennoch
      anzunehmen ... das ist wahrer Mut."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 10483523660791813
    m_Localized: "Ah! Es ist schon fast wieder Zeit f\xFCr mein Nickerchen vor dem
      Abendessen. Es ist schon eine Stunde seit meinem Schl\xE4fchen nach dem Mittagessen
      vergangen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 18157794981822464
    m_Localized: "Los, nimm was Leckeres f\xFCr deine Mystlinge mit."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 18157794994405376
    m_Localized: "Wie sch\xF6n, dich zu sehen, B\xE4ndiger. Nimm dir was f\xFCr unterwegs
      mit."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 18157794994405377
    m_Localized: "Ah! Du kommst genau zur rechten Zeit. Hier, das hab ich f\xFCr
      dich gemacht."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 18157794994405378
    m_Localized: Lass es dir schmecken und gute Reise!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 18157794994405379
    m_Localized: Komm wieder her, wenn du einen Nachschlag haben willst!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
  - m_Id: 18157794994405380
    m_Localized: "Gute Reise, B\xE4ndiger!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410401
