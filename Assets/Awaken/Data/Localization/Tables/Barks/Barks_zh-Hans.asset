    m_Localized: "\u8FD9\u53EA\u5CA9\u6D46\u86D9\u55B7\u706B\u7684\u65F6\u5019\u975E\u5E38\u4ED4\u7EC6\uFF0C\u53EF\u4EE5\u770B\u5F97\u51FA\u5B83\u5DE5\u4F5C\u975E\u5E38\u8BA4\u771F\uFF01"
