  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Barks_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: cd6dc0bc22391654f8b00bd60b61b07f, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8829885829830410399
  m_TableData:
  - m_Id: 328054419456
    m_Localized: "NIGDY nie przeszkadzaj medytuj\u0105cemu Glarexusowi."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328100556800
    m_Localized: "Ciekawe, czy o czym\u015B rozmy\u015Bla... czy te\u017C zwyczajnie
      \u015Bpi."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328100556801
    m_Localized: "B\u0142yksusy s\u0105 stworzeniami g\u0142\u0119boko uduchowionymi,
      zupe\u0142nie jak ludzie. "
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328100556802
    m_Localized: "Golomy s\u0105 raczej zamkni\u0119te w sobie. To uosobienie introwertyzmu."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751104
    m_Localized: "Ciekawe, o czym my\u015Bli... je\u015Bli w og\xF3le my\u015Bli."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751105
    m_Localized: "Tylko ca\u0142y dzie\u0144 siedzie\u0107 i nic nie robi\u0107...
      co za \u017Cycie!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751106
    m_Localized: "Icelingi przydaj\u0105 si\u0119 w letnie dni \u2013 do sch\u0142adzania
      napoj\xF3w!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751107
    m_Localized: "Jam\u0119 Iceling\xF3w wykorzystujemy jako lod\xF3wk\u0119. Genialne!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751108
    m_Localized: "Icelingi s\u0105 nie\u015Bmia\u0142e i zazwyczaj trzymaj\u0105
      si\u0119 swojego legowiska."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751109
    m_Localized: "Ca\u0142\u0105 uwag\u0119 tego Pinequeaka poch\u0142ania rozdarcie
      manekina na strz\u0119py."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751110
    m_Localized: "Ciekawe, czy tak bardzo poch\u0142ania go trening, czy te\u017C
      si\u0119 na co\u015B w\u015Bciek\u0142."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751111
    m_Localized: "Ciesz\u0119 si\u0119, \u017Ce to nie mnie ok\u0142ada tymi drobnymi
      pi\u0105stkami."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751112
    m_Localized: "Pinequeak, w\u015Bciek\u0142y jak zwykle."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751113
    m_Localized: "To Prowlery zajmuj\u0105 si\u0119 przekazywaniem list\xF3w mi\u0119dzy
      wioskami."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751114
    m_Localized: "Kto\u015B dosta\u0142 list!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751115
    m_Localized: "Wypada\u0142oby napisa\u0107 do mieszkaj\u0105cej w innej wiosce
      ciotki i upewni\u0107 si\u0119, \u017Ce wszystko u niej w porz\u0105dku."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523639820288
    m_Localized: "Jeszcze co\u015B do wys\u0142ania? Te Prowlery wkr\xF3tce wyruszaj\u0105."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523660791808
    m_Localized: "\u017Ba\u0142uj\u0119, \u017Ce Prowlery nie m\xF3wi\u0105. Podczas
      swych podr\xF3\u017Cy musia\u0142y zebra\u0107 mn\xF3stwo ciekawych plotek."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523660791809
    m_Localized: "Prowlery to cenieni pracownicy, wynagradzani tak jak inni, w monetach.
      Ciekawe, na co je wydaj\u0105."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751116
    m_Localized: "Sp\xF3jrz na niego, ca\u0142y dzie\u0144 tylko \u0142owi. To chyba
      do\u015B\u0107 spokojne \u017Cycie."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751117
    m_Localized: "Z\u0142apa\u0142 ryb\u0119! Teraz zacz\u0119\u0142o mi burcze\u0107
      w brzuchu."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751118
    m_Localized: "Ten Eftus \u0142owi tu od tygodni, ale jak dot\u0105d wyci\u0105ga\u0142
      tylko buty i puszki. Mo\u017Ce je kolekcjonuje..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751119
    m_Localized: "Ach, by\u0107 Fale i ca\u0142y dzie\u0144 nic, tylko si\u0119 pluska\u0107
      i wygl\u0105da\u0107 uroczo..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751120
    m_Localized: "Niech ci\u0119 nie zmyli ich uroczy wygl\u0105d: z\u0119by maj\u0105
      ostre jak ig\u0142y."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751121
    m_Localized: "Fale zdaj\u0105 si\u0119 mie\u0107 zawsze wysuni\u0119te j\u0119zyki.
      Mo\u017Ce nimi wios\u0142uj\u0105?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751122
    m_Localized: "Ten Bolb zdaje si\u0119 mie\u0107 jednostworow\u0105 imprez\u0119.
      Szkoda, \u017Ce mnie nie zaprosi\u0142."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751123
    m_Localized: "Bolby najcz\u0119\u015Bciej bardzo \u0142atwo wtapiaj\u0105 si\u0119
      w otoczenie. Je\u015Bli zobaczysz, jak jaki\u015B wychodzi z ukrycia, to pewnie
      ci\u0119 polubi\u0142."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751124
    m_Localized: "A nie wierzyli mi, \u017Ce Bolby nie s\u0105 leniwe: po prostu
      oszcz\u0119dzaj\u0105 energi\u0119 na pokaz ta\u0144ca!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523660791810
    m_Localized: "Masz w lesie wra\u017Cenie, \u017Ce kto\u015B ci\u0119 obserwuje?
      To pewnie tylko Bolb si\u0119 upewnia, \u017Ce nie chcesz go skrzywdzi\u0107."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751125
    m_Localized: "Ciep\u0142o w wyl\u0119garni pochodzi z ognistych oddech\xF3w Frogmar\xF3w.
      Dzi\u0119ki temu jaja maj\u0105 jak u mamy."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751126
    m_Localized: "Ten Frogmar bardzo ostro\u017Cnie operuje oddechem. Wida\u0107,
      \u017Ce powa\u017Cnie podchodzi do swojego zadania!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751127
    m_Localized: "Szkoda, \u017Ce nie mam Frogmara do podgrzewania wody na k\u0105piel."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751128
    m_Localized: "Ka\u017Cdy robi co\u015B dla wioski. Ten Frogmar upewnia si\u0119,
      \u017Ce nowy miot mystling\xF3w wykluje si\u0119 zdrowy."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751132
    m_Localized: "Kiedy\u015B by\u0142em treserem, tak jak ty, ale potem... Gdzie\u015B
      ju\u017C to s\u0142ysza\u0142em."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751133
    m_Localized: "Budz\u0119 si\u0119 o czwartej nad ranem, \u0107wicz\u0119, jem
      \u015Bniadanie i zaczynam trening. \u017Ba\u0142uj\u0119, \u017Ce nie mam \u017Cadnych
      przyjaci\xF3\u0142."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751134
    m_Localized: "Widzisz tamtego Pinequeaka? Z takim zaanga\u017Cowaniem osi\u0105gniesz
      wszystko!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751135
    m_Localized: "Trenuj wytrwale, by\u015Bmy mieli szans\u0119 w starciu z za\u0107mieniem."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751136
    m_Localized: "G\u0142\xF3d doskwiera? Mamy najsmaczniejsz\u0105 kuchni\u0119
      po tej stronie g\xF3r!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751137
    m_Localized: "Ale z ciebie chudzina! Chod\u017A, dostaniesz co\u015B na z\u0105b."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751138
    m_Localized: "Skosztuj specjalno\u015Bci dnia!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 328104751139
    m_Localized: "Doskona\u0142e jedzenie i jeszcze lepsze towarzystwo!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523660791811
    m_Localized: "Masz wielki talent, jak na osob\u0119 tak m\u0142od\u0105. Wiedza
      i umiej\u0119tno\u015Bci przyjd\u0105 z czasem."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523660791812
    m_Localized: "Mie\u0107 \u015Bwiadomo\u015B\u0107, jak wielkie jest wyzwanie,
      i mimo to si\u0119 go podj\u0105\u0107 \u2013 oto prawdziwa odwaga."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 10483523660791813
    m_Localized: "Ach! Ju\u017C prawie czas na moj\u0105 przedobiedni\u0105 drzemk\u0119.
      Od tej polunchowej min\u0119\u0142a godzina..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 18157794981822464
    m_Localized: "Dalej, we\u017A co\u015B dla swoich mystling\xF3w!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 18157794994405376
    m_Localized: "Dobrze ci\u0119 widzie\u0107, treserze! We\u017A co\u015B na drog\u0119."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 18157794994405377
    m_Localized: "A! Przychodzisz w sam\u0105 por\u0119. Prosz\u0119, specjalnie
      dla ciebie."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 18157794994405378
    m_Localized: Jedz dobrze, a zajdziesz daleko!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 18157794994405379
    m_Localized: "Wr\xF3\u0107, kiedy b\u0119dziesz mie\u0107 ochot\u0119 na dok\u0142adk\u0119!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
  - m_Id: 18157794994405380
    m_Localized: Szerokiej drogi, treserze!
    m_Metadata:
      m_Items:
      - rid: 8829885829830410399
