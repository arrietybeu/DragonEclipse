  - m_Id: 43003040931848200
    m_Localized: Schatz
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43003040931848201
    m_Localized: Segensbaum
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43003040931848202
    m_Localized: Kartenkompendium
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43003040931848203
    m_Localized: Mystlingquartiere
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43003040931848204
    m_Localized: Reise beginnen
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43003040931848205
    m_Localized: "K\xFCche"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43003040931848206
    m_Localized: "Mystlingbrutst\xE4tte"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43061790419005440
    m_Localized: Normal
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43061790419005441
    m_Localized: Schnell
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 87262139168837632
    m_Localized: Sehr schnell
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43061790419005442
    m_Localized: Spielgeschwindigkeit
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 43061790419005443
    m_Localized: "Dr\xFCcken"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 45584566202777600
    m_Localized: Mach dich bereit, die Finsternis naht!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 50705766868434944
    m_Localized: Die Finsternis ist gekommen!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 52902852804354048
    m_Localized: KAUFEN
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 55334710897881088
    m_Localized: "Ausw\xE4hlen"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 56084385773387776
    m_Localized: "Neues Ei verf\xFCgbar"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 56084385790164992
    m_Localized: "Der neue Mystling ist geschl\xFCpft!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 56085848704679936
    m_Localized: "Neuer B\xE4ndiger freigeschaltet!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 56471210140631040
    m_Localized: "Ich w\xE4hle dich!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 58663897720233984
    m_Localized: <color=red>Akt I</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 58663897745399808
    m_Localized: "Durchsuche den Wald in der N\xE4he nach Anzeichen f\xFCr \xC4rger."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 58663897745399809
    m_Localized: <color=red>Akt II</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 58663897745399810
    m_Localized: "Suche in der W\xFCste nach dem Ursprung des Leidens des Drachenw\xE4chters."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 58663897745399811
    m_Localized: <color=red>Akt III</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 58663897745399812
    m_Localized: Suche nach Antworten in den kalten Bergen.
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 66277700972650496
    m_Localized: <color=red>Akt IV</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 66277701002010624
    m_Localized: Betritt das Schattenreich, um die Finsternis zu stoppen!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 83334956624977920
    m_Localized: <color=red>Akt V</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 83334956650143744
    m_Localized: Beende die Finsternis und rette dein Dorf!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 68042996217532416
    m_Localized: FREISCHALTEN
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 68090245530243072
    m_Localized: MERKEN
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 71302802550280192
    m_Localized: Bestenliste
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 71334537195409408
    m_Localized: Aktualisieren
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 71334537207992320
    m_Localized: "L\xE4dt ..."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 71706790756229120
    m_Localized: Top 10
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 71706790785589248
    m_Localized: Mein Highscore
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 73204834027421696
    m_Localized: Kompendium
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 73479797837209600
    m_Localized: "W\xE4hle ein Angriffsziel"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 73542654880632832
    m_Localized: 'Schaden:'
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 73542654901604352
    m_Localized: 'Runde:'
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 77091346304716800
    m_Localized: "Schwere K\xE4mpfe gewonnen:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 77091346317299712
    m_Localized: "Leichte K\xE4mpfe gewonnen:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 77092546836156416
    m_Localized: "Normale K\xE4mpfe gewonnen:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 84410561432985600
    m_Localized: Questkampf
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 84410561453957120
    m_Localized: Questgegenstand
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 87262139189809152
    m_Localized: Kampfbeginn
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 87262139189809153
    m_Localized: Kartenphase
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 87262139189809154
    m_Localized: Kampfphase
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 110071458889318400
    m_Localized: Bewegen
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 110071458910289920
    m_Localized: Loslassen
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617487
    m_Localized: ALLERGISCH!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617488
    m_Localized: Verkauft!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116674886805602304
    m_Localized: "KAMPFUNF\xC4HIG!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116674886839156736
    m_Localized: "Willst du das Kaufen wirklich \xFCberspringen?"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341423063040
    m_Localized: Tage bis zur <style="Purple">Finsternis</style>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617472
    m_Localized: Geschafft!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617473
    m_Localized: 'Akt:'
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617474
    m_Localized: "Klicke auf ein Ei, um es auszubr\xFCten."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617475
    m_Localized: Klicke weiter!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617476
    m_Localized: Und noch mal!
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617477
    m_Localized: "Klicke auf die Truhe, um sie zu \xF6ffnen."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617478
    m_Localized: Energie
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617479
    m_Localized: Zug beenden
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617480
    m_Localized: Ziehen
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617481
    m_Localized: Ablegen
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617482
    m_Localized: "Ersch\xF6pfen"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617483
    m_Localized: Kraft
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617484
    m_Localized: Platz
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617485
    m_Localized: Name
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116314341456617486
    m_Localized: Punkte
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
  - m_Id: 116965285130518528
    m_Localized: "W\xC4HLE EINE KARTE"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123720
