    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 43061790419005443
    m_Localized: Appuyer sur
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 45584566202777600
    m_Localized: "Pr\xE9parez-vous, l'\xC9clipse arrive\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 50705766868434944
    m_Localized: "L'\xC9clipse est l\xE0\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 52902852804354048
    m_Localized: ACHETER
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 55334710897881088
    m_Localized: Choisir
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 56084385773387776
    m_Localized: "Un nouvel \u0153uf est apparu\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 56084385790164992
    m_Localized: "Le nouveau Mystling est en train d'\xE9clore\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 56085848704679936
    m_Localized: "Nouveau dompteur d\xE9bloqu\xE9\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 56471210140631040
    m_Localized: "C'est toi que je choisis\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 58663897720233984
    m_Localized: <color=red>Acte I</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 58663897745399808
    m_Localized: "Fouillez la for\xEAt proche pour y trouver des signes que les choses
      vont mal."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 58663897745399809
    m_Localized: <color=red>Acte II</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 58663897745399810
    m_Localized: "Partez dans le d\xE9sert pour chercher la source du mal affligeant
      le Dragon Gardien."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 58663897745399811
    m_Localized: <color=red>Acte III</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 58663897745399812
    m_Localized: "Cherchez des r\xE9ponses dans le froid des montagnes."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 66277700972650496
    m_Localized: <color=red>Acte IV</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 66277701002010624
    m_Localized: "Aventurez-vous dans le Royaume des Ombres pour stopper l'\xC9clipse\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 83334956624977920
    m_Localized: <color=red>Acte V</color=red>
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 83334956650143744
    m_Localized: "Mettez un terme \xE0 l'\xC9clipse pour sauver votre village\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 68042996217532416
    m_Localized: "D\xC9BLOQUER"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 68090245530243072
    m_Localized: GELER
    m_Metadata:
      m_Items:
