  - m_Id: 110071458889318400
    m_Localized: "D\xE9placer"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 110071458910289920
    m_Localized: "Lib\xE9rer"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617487
    m_Localized: "ALLERGIQUE\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617488
    m_Localized: "Vendu\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116674886805602304
    m_Localized: "\xC9VANOUI\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116674886839156736
    m_Localized: "Voulez-vous vraiment passer la phase d'achat\_?"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341423063040
    m_Localized: "jours avant l'<style=\"Purple\">\xC9clipse</style>"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617472
    m_Localized: "Plus rien \xE0 d\xE9bloquer\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617473
    m_Localized: "Acte de l'histoire\_:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617474
    m_Localized: "Cliquez sur l'\u0153uf pour le faire \xE9clore."
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617475
    m_Localized: "Continuez de cliquer\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617476
    m_Localized: "Encore\_!"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617477
    m_Localized: Cliquez sur le coffre pour l'ouvrir.
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 116314341456617478
    m_Localized: "\xC9nergie"
