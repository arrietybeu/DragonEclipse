  - m_Id: 73479797837209600
    m_Localized: "S\xE9lectionner la cible de l'attaque"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 73542654880632832
    m_Localized: "D\xE9g\xE2ts\_:"
    m_Metadata:
