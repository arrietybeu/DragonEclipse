      - rid: 1479096558747123719
  - m_Id: 73542654901604352
    m_Localized: "Round\_:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 77091346304716800
    m_Localized: "Combats difficiles gagn\xE9s\_:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 77091346317299712
    m_Localized: "Combats faciles gagn\xE9s\_:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 77092546836156416
    m_Localized: "Combats normaux gagn\xE9s\_:"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 84410561432985600
    m_Localized: "Combat de qu\xEAte"
    m_Metadata:
      m_Items:
      - rid: 1479096558747123719
  - m_Id: 84410561453957120
    m_Localized: "Objet de qu\xEAte"
    m_Metadata:
