      - rid: 8099901647879405569
  - m_Id: 83334956624977920
    m_Localized: "<color=red>H\u1ED3i V</color=red>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 83334956650143744
    m_Localized: "Ch\u1EA5m d\u1EE9t Eclipse v\xE0 c\u1EE9u l\u1EA5y ng\xF4i l\xE0ng
      c\u1EE7a b\u1EA1n!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 84410561432985600
    m_Localized: "Tr\u1EADn Nhi\u1EC7m V\u1EE5"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 84410561453957120
    m_Localized: "V\u1EADt Ph\u1EA9m Nhi\u1EC7m V\u1EE5"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 87262139168837632
    m_Localized: "R\u1EA5t nhanh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 87262139189809152
    m_Localized: "B\u1EAFt \u0111\u1EA7u tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 87262139189809153
    m_Localized: "Pha L\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 87262139189809154
    m_Localized: "Pha Chi\u1EBFn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 89406086252433408
    m_Localized: "B\u1ECF qua tr\u1EADn B\u1EA3ng x\u1EBFp h\u1EA1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 96361969112301568
    m_Localized: "<i>R\u1EDDi \u0111i</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 110071458889318400
    m_Localized: "Di chuy\u1EC3n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 110071458910289920
    m_Localized: "Th\u1EA3"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341423063040
    m_Localized: "ng\xE0y \u0111\u1EBFn <style=\"Purple\">Eclipse</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617472
    m_Localized: "xong h\u1EBFt r\u1ED3i!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617473
    m_Localized: "H\u1ED3i truy\u1EC7n:"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617474
    m_Localized: "Nh\u1EA5n v\xE0o qu\u1EA3 tr\u1EE9ng \u0111\u1EC3 \u1EA5p n\u1EDF."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617475
    m_Localized: "nh\u1EA5n ti\u1EBFp \u0111i!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617476
    m_Localized: "L\u1EA7n n\u1EEFa!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617477
    m_Localized: "Nh\u1EA5n v\xE0o r\u01B0\u01A1ng \u0111\u1EC3 m\u1EDF."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617478
    m_Localized: "N\u0103ng l\u01B0\u1EE3ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617479
    m_Localized: "K\u1EBFt th\xFAc l\u01B0\u1EE3t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617480
    m_Localized: "R\xFAt"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617481
    m_Localized: "B\u1ECF b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617482
    m_Localized: "Thi\xEAu h\u1EE7y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617483
    m_Localized: "S\u1EE9c m\u1EA1nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617484
    m_Localized: "H\u1EA1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617485
    m_Localized: "T\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617486
    m_Localized: "\u0110i\u1EC3m"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617487
    m_Localized: "D\u1ECA \u1EE8NG!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116314341456617488
    m_Localized: "\u0110\xE3 b\xE1n!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116674886805602304
    m_Localized: "NG\u1EA4T X\u1EC8U!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116674886839156736
    m_Localized: "B\u1EA1n c\xF3 ch\u1EAFc mu\u1ED1n b\u1ECF qua vi\u1EC7c mua s\u1EAFm
      kh\xF4ng?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 116965285130518528
    m_Localized: "CH\u1ECCN M\u1ED8T L\xC1 B\xC0I"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
