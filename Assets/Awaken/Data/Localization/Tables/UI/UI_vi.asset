    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 58663897745399808
    m_Localized: "L\xF9ng s\u1EE5c khu r\u1EEBng g\u1EA7n \u0111\xF3 \u0111\u1EC3
      t\xECm d\u1EA5u hi\u1EC7u b\u1EA5t th\u01B0\u1EDDng."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 58663897745399809
    m_Localized: "<color=red>H\u1ED3i II</color=red>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 58663897745399810
    m_Localized: "T\xECm ngu\u1ED3n c\u01A1n tai \u01B0\u01A1ng c\u1EE7a R\u1ED3ng
      H\u1ED9 M\u1EC7nh gi\u1EEFa sa m\u1EA1c."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 58663897745399811
    m_Localized: "<color=red>H\u1ED3i III</color=red>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 58663897745399812
    m_Localized: "T\xECm c\xE2u tr\u1EA3 l\u1EDDi gi\u1EEFa gi\xE1 l\u1EA1nh c\u1EE7a
      nh\u1EEFng ng\u1ECDn n\xFAi."
