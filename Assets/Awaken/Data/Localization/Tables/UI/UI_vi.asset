      m_Items:
      - rid: 8099901647879405569
  - m_Id: 56085848704679936
    m_Localized: "\u0110\xE3 m\u1EDF kh\xF3a Tamer m\u1EDBi!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 56471210140631040
    m_Localized: "Ta ch\u1ECDn ng\u01B0\u01A1i!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 56843005608443904
    m_Localized: "Totem Sinh L\u1EF1c"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57895615610298368
    m_Localized: "C\u1EA3nh b\xE1o!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57895615635464192
    m_Localized: "Do nh\u1EEFng thay \u0111\u1ED5i trong n\u1ED9i dung game, ch\xFAng
      t\xF4i bu\u1ED9c ph\u1EA3i \u0111\u1EB7t l\u1EA1i C\u1EA5p \u0111\u1ED9 Tamer
      c\u1EE7a b\u1EA1n. \u0110\u1EEBng lo, ch\xFAng t\xF4i s\u1EBD \u0111\u1EC1n
      b\xF9 cho b\u1EA1n \u0111\xFAng s\u1ED1 \u0110i\u1EC3m Kinh Nghi\u1EC7m m\xE0
      b\u1EA1n \u0111\xE3 c\xF3 tr\u01B0\u1EDBc b\u1EA3n c\u1EADp nh\u1EADt."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57895615635464193
    m_Localized: "Chi\u1EBFn th\u1EAFng \u0111\u1EA7u ti\xEAn!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57895615635464194
    m_Localized: "Ch\xFAc m\u1EEBng, b\u1EA1n v\u1EEBa th\u1EAFng l\u01B0\u1EE3t
      ch\u01A1i \u0111\u1EA7u ti\xEAn c\u1EE7a m\xECnh! Nh\u01B0ng h\xE0nh tr\xECnh
      ch\u01B0a d\u1EEBng l\u1EA1i \u1EDF \u0111\xE2y \u0111\xE2u. B\u1EA1n v\u1EEBa
      m\u1EDF kh\xF3a m\u1ED9t m\u1EE9c \u0111\u1ED9 kh\xF3 cao h\u01A1n."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57895615635464195
    m_Localized: "C\u1EA3m \u01A1n b\u1EA1n!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57895615635464196
    m_Localized: "Ch\xFAc m\u1EEBng! B\u1EA1n \u0111\xE3 \u0111\u1EA1t c\u1EA5p Tamer
      t\u1ED1i \u0111a.<br>C\u1EA3m \u01A1n b\u1EA1n \u0111\xE3 \u0111\u1ED3ng h\xE0nh
      c\xF9ng tr\xF2 ch\u01A1i c\u1EE7a ch\xFAng t\xF4i!<br>Nh\u01B0ng game v\u1EABn
      ch\u01B0a k\u1EBFt th\xFAc \u0111\xE2u! H\xE3y th\u1EED m\u1ECDi t\u1ED5 h\u1EE3p
      Tamer v\xE0 Mystling r\u1ED3i ch\u1EB7n \u0111\u1EE9ng Eclipse!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405569
  - m_Id: 57944457445711872
