    m_Localized: <color=red>Act I</color=red>
    m_Metadata:
      m_Items:
      - rid: 5093883885410844676
  - m_Id: 58663897745399808
    m_Localized: Search the nearby forest for signs of trouble.
    m_Metadata:
      m_Items:
      - rid: 5093883885410844676
  - m_Id: 58663897745399809
    m_Localized: <color=red>Act II</color=red>
    m_Metadata:
      m_Items:
      - rid: 5093883885410844676
  - m_Id: 58663897745399810
    m_Localized: Look for the source of Dragon Guardian's affliction in the desert.
    m_Metadata:
      m_Items:
      - rid: 5093883885410844676
  - m_Id: 58663897745399811
    m_Localized: <color=red>Act III</color=red>
    m_Metadata:
      m_Items:
      - rid: 5093883885410844676
  - m_Id: 58663897745399812
    m_Localized: Look for answers in the cold of the mountains.
