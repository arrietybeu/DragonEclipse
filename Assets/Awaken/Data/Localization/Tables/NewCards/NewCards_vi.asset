    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584140
    m_Localized: "L\xF4ng V\u0169 S\u1EAFc"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584141
    m_Localized: "G\xE2y ({Effect0.ValueInt}) s\xE1t th\u01B0\u01A1ng l\xEAn k\u1EBB
      \u0111\u1ECBch \u0111\u01B0\u1EE3c ch\u1ECDn. (B\u1EB1ng s\u1ED1 l\xE1 b\xE0i
      tr\xEAn tay)"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584152
    m_Localized: "\u0110\xF4i C\xE1nh Cu\u1ED3ng N\u1ED9"
