  m_TableData:
  - m_Id: 359614801584128
    m_Localized: "C\u01A1n Gi\u1EADn M\xF9 Qu\xE1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584129
    m_Localized: "D\xF9ng m\u1ED9t Mystling ng\u1EABu nhi\xEAn T\u1EA5n c\xF4ng m\u1ED9t
      K\u1EBB \u0111\u1ECBch ng\u1EABu nhi\xEAn v\u1EDBi {Effect0.Attack.PowerModifier}%
      S\u1EE9c m\u1EA1nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584130
    m_Localized: "D\xF9ng m\u1ED9t Mystling ng\u1EABu nhi\xEAn T\u1EA5n c\xF4ng m\u1ED9t
      K\u1EBB \u0111\u1ECBch ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584131
    m_Localized: "\xC1nh S\xE1ng Xoa D\u1ECBu"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584132
    m_Localized: "<style=\"Blue\">H\u1ED3i</style> {Effect0.ValueInt} M\xE1u cho
      Mystling \u0111\u01B0\u1EE3c ch\u1ECDn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584134
    m_Localized: "B\xE3o \u0110\xE1"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584135
    m_Localized: "T\u1EA5n c\xF4ng {Effect1.Attack.Repeat} l\u1EA7n v\u1EDBi {Effect1.Attack.PowerModifier}%
      S\u1EE9c m\u1EA1nh. <smallcaps><style=\"Blue\">G\xE2y Th\u01B0\u01A1ng</style></smallcaps>
      {Effect0.ValueInt} s\xE1t th\u01B0\u01A1ng l\xEAn Mystling n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584137
    m_Localized: "Qu\u1EA3 C\u1EA7u Tuy\u1EBFt"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405578
  - m_Id: 359614801584138
    m_Localized: "<smallcaps><style=\"Blue\">Cho\xE1ng</style></smallcaps> K\u1EBB
