  m_TableData:
  - m_Id: 359614801584141
    m_Localized: "Zadaje wskazanemu wrogowi <style=\"Blue\">obra\u017Cenia</style>
      r\xF3wne liczbie kart w r\u0119ce ({Effect0.ValueInt})"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 47827012764639237
    m_Localized: "P\xF3ki jeste\u015B na tej pozycji, wszystkie otrzymywane <style=\"Blue\">obra\u017Cenia</style>
      s\u0105 zmniejszane o {Effect0.AuraDamageReduction}\n"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584128
    m_Localized: "\u015Alepy gniew"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584129
    m_Localized: Losowy mystling atakuje losowego wroga z {Effect0.Attack.PowerModifier}%
      mocy
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584130
    m_Localized: Losowy mystling atakuje losowego wroga
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584131
    m_Localized: "Koj\u0105ca \u015Bwiat\u0142o\u015B\u0107"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584132
    m_Localized: <style="Blue">Leczy</style> wskazanemu mystlingowi {Effect0.ValueInt}
      PZ
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584134
    m_Localized: Grad kamieni
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584135
    m_Localized: "Mystling atakuje {Effect1.Attack.Repeat} razy z {Effect1.Attack.PowerModifier}%
      mocy, po czym odnosi {Effect0.ValueInt} p. <smallcaps><style=\"Blue\">obra\u017Ce\u0144</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 17388664405434368
    m_Localized: "Mystling atakuje {Effect1.Attack.Repeat} razy, po czym odnosi {Effect0.ValueInt}
      p. <smallcaps><style=\"Blue\">obra\u017Ce\u0144</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584137
    m_Localized: "\u015Anie\u017Cka"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584138
    m_Localized: "<smallcaps><style=\"Blue\">Og\u0142usza</style></smallcaps> wskazanego
      wroga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12235921051205632
    m_Localized: "<smallcaps><style=\"Blue\">Og\u0142usza</style></smallcaps> wskazanego
      wroga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584140
    m_Localized: "Ostre pi\xF3ro"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12315208664072192
    m_Localized: "Zadaje wskazanemu wrogowi <style=\"Blue\">obra\u017Cenia</style>
      r\xF3wne dwukrotno\u015Bci liczby kart w r\u0119ce ({Effect0.ValueInt})"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 6068234742775808
    m_Localized: Mgnienie oka
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584152
    m_Localized: "Skrzyd\u0142a furii"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584153
    m_Localized: "Brak efektu a\u017C do ewolucji drosithii"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 359614801584154
    m_Localized: Wskazany mystling <style="Blue">atakuje</style> {Effect0.Strike.Repeat}
      razy
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12608167498334208
    m_Localized: "Wytrwa\u0142o\u015B\u0107"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12608167527694336
    m_Localized: "Zwi\u0119ksza maks. zdrowie o {Effect0.ValueInt} p."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12608167527694337
    m_Localized: "To bola\u0142o!"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12608167527694338
    m_Localized: "Wskazany wr\xF3g otrzymuje {Effect0.ValueInt} p. <smallcaps><style=\"Blue\">bezbronno\u015Bci</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654807
  - m_Id: 12608167527694340
    m_Localized: Dobry falun!
