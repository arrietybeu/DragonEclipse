    m_Metadata:
      m_Items:
      - rid: 8829885829830410415
  - m_Id: 12259629631389697
    m_Localized: "Wirke {Effect1.ValueInt} <smallcaps><style=\"Blue\">St\xE4rke</style></smallcaps>
      auf einen ausgew\xE4hlten Mystling, dann wird er <smallcaps><style=\"Blue\">verwundet</style></smallcaps>
      und erleidet {Effect0.ValueInt} Schaden."
