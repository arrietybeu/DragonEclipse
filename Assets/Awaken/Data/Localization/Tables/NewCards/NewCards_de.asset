  - m_Id: 359614801584291
    m_Localized: "Wirke {Effect0.ValueInt} <smallcaps><style=\"Blue\">St\xE4rke</style></smallcaps>
      auf einen ausgew\xE4hlten Mystling."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410415
  - m_Id: 30734404603199488
    m_Localized: "Gezackte R\xE4nder"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410415
  - m_Id: 30734404603199489
    m_Localized: "<style=\"Blue\">Lege</style> die gesamte Kartenhand <style=\"Blue\">ab</style>.
      Bewirke {Effect0.DiscardAllVulnerableValue} <smallcaps><style=\"Blue\">Verwundbarkeit</style></smallcaps>
      f\xFCr jede abgelegte Karte bei ausgew\xE4hltem Gegner."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410415
  - m_Id: 30734404603199490
    m_Localized: "<style=\"Blue\">Lege</style> die gesamte Kartenhand <style=\"Blue\">ab</style>.
