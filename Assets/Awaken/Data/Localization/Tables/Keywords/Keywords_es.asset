  m_Name: Keywords_es
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 0a017febadd476040bcc53a62978373b, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2105433060097654803
  m_TableData:
  - m_Id: 2103540039680
    m_Localized: "Bumer\xE1n"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 2305462222848
    m_Localized: Regresa a la mano del jugador tras jugarla.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 2503508869120
    m_Localized: Clon
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 2596051992576
    m_Localized: "C\xF3piala y m\xE9zclala en la pila de descartes."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 3445264334848
    m_Localized: Sobrecarga
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 3569226989568
    m_Localized: Se ejecuta tantas veces como cartas se hayan jugado en esta ronda.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 3958399680512
    m_Localized: Agotar
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 4067308978176
    m_Localized: Se retira hasta el final de la batalla.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 5756648800256
    m_Localized: Marcada
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 5860579459072
    m_Localized: Se roba en la primera ronda de la batalla.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 5978716225536
    m_Localized: Retener
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 6061062995968
    m_Localized: Se queda en la mano del jugador tras el final de la ronda.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 6165513748480
    m_Localized: Rapidez
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 6298116669440
    m_Localized: "Si no se roba al inicio de la ronda, su coste de energ\xEDa es
      0."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 6405587320832
    m_Localized: "Yoy\xF3"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
  - m_Id: 6498130444288
    m_Localized: 'Tras jugarla, se mezcla en la pila de robos en vez de en la pila
      de descartes. '
    m_Metadata:
      m_Items:
      - rid: 2105433060097654803
