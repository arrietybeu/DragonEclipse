    m_Metadata:
      m_Items:
      - rid: 2105433060097654799
  - m_Id: 55826999063973888
    m_Localized: Every time this card is played, increase its value by <smallcaps><style="Blue">Grow</style></smallcaps>
      count until the end of Battle
    m_Metadata:
      m_Items:
      - rid: 2105433060097654799
  - m_Id: 55827172670410752
    m_Localized: Every time this card is played, decrease its value by <smallcaps><style="Blue">Wither</style></smallcaps>
