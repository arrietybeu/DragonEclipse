  m_Name: Keywords_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 0a017febadd476040bcc53a62978373b, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8099901647879405580
  m_TableData:
  - m_Id: 2103540039680
    m_Localized: <style="Blue">Bumerang</style>
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 2305462222848
    m_Localized: "Tr\u1EDF l\u1EA1i tay b\xE0i ngay l\u1EADp t\u1EE9c sau khi \u0111\xE1nh
      ra"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 2503508869120
    m_Localized: "<style=\"Blue\">Nh\xE2n b\u1EA3n</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 2596051992576
    m_Localized: "T\u1EA1o m\u1ED9t b\u1EA3n sao c\u1EE7a l\xE1 b\xE0i n\xE0y v\xE0
      x\xE1o n\xF3 v\xE0o Ch\u1ED3ng b\u1ECF"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 3445264334848
    m_Localized: "<smallcaps><style=\"Blue\">Qu\xE1 t\u1EA3i</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 3569226989568
    m_Localized: "\u0110\xE1nh l\xE1 b\xE0i n\xE0y s\u1ED1 l\u1EA7n b\u1EB1ng s\u1ED1
      l\xE1 b\xE0i \u0111\xE3 \u0111\xE1nh trong v\xF2ng n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 3958399680512
    m_Localized: "<smallcaps><style=\"Blue\">Thi\xEAu h\u1EE7y</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 4067308978176
    m_Localized: "Sau khi \u0111\xE1nh ra, lo\u1EA1i kh\u1ECFi b\u1ED9 b\xE0i cho
      \u0111\u1EBFn khi k\u1EBFt th\xFAc Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 5756648800256
    m_Localized: "<style=\"Blue\">\u0110\xE1nh d\u1EA5u</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 5860579459072
    m_Localized: "\u0110\u01B0\u1EE3c r\xFAt \u1EDF V\xF2ng \u0111\u1EA7u ti\xEAn
      c\u1EE7a Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 5978716225536
    m_Localized: "<style=\"Blue\">Tr\u1EE5 l\u1EA1i</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 6061062995968
    m_Localized: "\u1EDE l\u1EA1i tr\xEAn tay b\xE0i c\u1EE7a b\u1EA1n sau khi k\u1EBFt
      th\xFAc V\xF2ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 6165513748480
    m_Localized: "<style=\"Blue\">Nhanh nh\u1EB9n</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 6298116669440
    m_Localized: "N\u1EBFu kh\xF4ng \u0111\u01B0\u1EE3c r\xFAt v\xE0o \u0111\u1EA7u
      V\xF2ng, l\xE1 n\xE0y t\u1ED1n 0 N\u0103ng l\u01B0\u1EE3ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 6405587320832
    m_Localized: <style="Blue">Yoyo</style>
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 6498130444288
    m_Localized: "Sau khi \u0111\xE1nh ra, x\xE1o l\xE1 b\xE0i n\xE0y tr\u1EDF l\u1EA1i
      Ch\u1ED3ng r\xFAt thay v\xEC Ch\u1ED3ng b\u1ECF"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 34068222202462208
    m_Localized: "<style=\"Blue\">\u0110\u1ED9 b\u1EC1n</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 34068222215045120
    m_Localized: "M\u1ED7i l\u1EA7n l\xE1 b\xE0i n\xE0y \u0111\u01B0\u1EE3c \u0111\xE1nh
      ra, gi\u1EA3m 1 \u0110\u1ED9 b\u1EC1n. Khi v\u1EC1 0, l\xE1 b\xE0i n\xE0y b\u1ECB
      ph\xE1 h\u1EE7y cho \u0111\u1EBFn khi k\u1EBFt th\xFAc Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 55826930826842112
    m_Localized: "<smallcaps><style=\"Blue\">T\u0103ng ti\u1EBFn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 55827062259552256
    m_Localized: "<smallcaps><style=\"Blue\">Suy t\xE0n</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 55826999063973888
    m_Localized: "M\u1ED7i l\u1EA7n l\xE1 b\xE0i n\xE0y \u0111\u01B0\u1EE3c \u0111\xE1nh
      ra, t\u0103ng gi\xE1 tr\u1ECB c\u1EE7a n\xF3 theo s\u1ED1 \u0111i\u1EC3m <smallcaps><style=\"Blue\">T\u0103ng
      ti\u1EBFn</style></smallcaps> cho \u0111\u1EBFn khi k\u1EBFt th\xFAc Tr\u1EADn
      \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 55827172670410752
    m_Localized: "M\u1ED7i l\u1EA7n l\xE1 b\xE0i n\xE0y \u0111\u01B0\u1EE3c \u0111\xE1nh
      ra, gi\u1EA3m gi\xE1 tr\u1ECB c\u1EE7a n\xF3 theo s\u1ED1 \u0111i\u1EC3m <smallcaps><style=\"Blue\">Suy
      t\xE0n</style></smallcaps> cho \u0111\u1EBFn khi v\u1EC1 0. \u0110\u1EB7t l\u1EA1i
      m\u1ED7i Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 86266413391618048
    m_Localized: "<smallcaps><style=\"Blue\">Ph\xF9 Ph\xE9p V\u1ECB Tr\xED</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
  - m_Id: 86266413412589568
    m_Localized: "\xC1p m\u1ED9t <style=\"Blue\">Ph\xF9 Ph\xE9p</style> l\xEAn m\u1ED9t
      <style=\"Blue\">V\u1ECB Tr\xED</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405580
