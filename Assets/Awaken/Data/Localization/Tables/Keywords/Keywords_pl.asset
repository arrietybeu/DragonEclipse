  m_Name: Keywords_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 0a017febadd476040bcc53a62978373b, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2105433060097654800
  m_TableData:
  - m_Id: 2103540039680
    m_Localized: Bumerang
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 2305462222848
    m_Localized: "Po u\u017Cyciu wraca na r\u0119k\u0119 gracza."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 2503508869120
    m_Localized: Klonowanie
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 2596051992576
    m_Localized: "Wtasowuje kopi\u0119 karty do stosu kart odrzuconych."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 3445264334848
    m_Localized: <smallcaps><style="Blue">Kaskada</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 3569226989568
    m_Localized: "Zagraj t\u0119 kart\u0119 tyle razy, ile w tej rundzie zagrano
      dot\u0105d innych kart"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 3958399680512
    m_Localized: <smallcaps><style="Blue">Wyczerpanie</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 4067308978176
    m_Localized: "Po zagraniu karta jest usuwana z talii do ko\u0144ca walki"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 5756648800256
    m_Localized: Znaczona
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 5860579459072
    m_Localized: Dobierana w pierwszej rundzie walki.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 5978716225536
    m_Localized: Zostaje
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 6061062995968
    m_Localized: "Po zako\u0144czeniu rundy zostaje w r\u0119ce gracza."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 6165513748480
    m_Localized: "P\u0119d"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 6298116669440
    m_Localized: "Niedobranie na pocz\u0105tku rundy zmniejsza koszt do 0."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 6405587320832
    m_Localized: Jojo
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 6498130444288
    m_Localized: "Po u\u017Cyciu wtasowujesz t\u0119 kart\u0119 do stosu kart do
      dobrania. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 55826930826842112
    m_Localized: <smallcaps><style="Blue">Wzrost</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 55826999063973888
    m_Localized: "Po ka\u017Cdym zagraniu tej karty jej warto\u015B\u0107 ro\u015Bnie
      do ko\u0144ca walki o warto\u015B\u0107 <smallcaps><style=\"Blue\">wzrostu</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 55827062259552256
    m_Localized: <smallcaps><style="Blue">Usychanie</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 55827172670410752
    m_Localized: "Po ka\u017Cdym zagraniu tej karty jej warto\u015B\u0107 maleje
      do ko\u0144ca walki o warto\u015B\u0107 <smallcaps><style=\"Blue\">usychania</style></smallcaps>
      (a\u017C do zera)"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 86266413391618048
    m_Localized: <smallcaps><style="Blue">Zaczarowanie pozycji</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
  - m_Id: 86266413412589568
    m_Localized: "Zmienia <style=\"Blue\">pozycj\u0119</style> w <style=\"Blue\">zaczarowan\u0105</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654800
