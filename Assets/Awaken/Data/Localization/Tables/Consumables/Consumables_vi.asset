  m_TableData:
  - m_Id: 43425364957011968
    m_Localized: "B\xEDt T\u1EBFt S\u1ED1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566400
    m_Localized: "\xC1p {Effect0.ValueInt} <style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style>
      l\xEAn Mystling \u0111\xE3 ch\u1ECDn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566401
    m_Localized: "B\xE1nh Ph\xF4 Mai M\xE2m X\xF4i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566402
    m_Localized: "\xC1p {Effect0.ValueInt} <style=\"Blue\">Khi\xEAn</style> l\xEAn
      Mystling \u0111\xE3 ch\u1ECDn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566403
    m_Localized: "S\xFAp B\u1ED5 D\u01B0\u1EE1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566404
    m_Localized: "H\u1ED3i {Effect0.ValueInt} M\xE1u cho Mystling \u0111\xE3 ch\u1ECDn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566405
    m_Localized: "M\xF3n Tr\xE1ng Mi\u1EC7ng Sang Ch\u1EA3nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566406
    m_Localized: "\xC1p {Effect0.ValueInt} <style=\"Blue\">H\u1ED3i Sinh</style>
      l\xEAn Mystling \u0111\xE3 ch\u1ECDn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566407
    m_Localized: "M\xF3n \u0103n c\xE2n b\u1EB1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566408
    m_Localized: "Nh\u1EADn {Effect0.ValueInt} V\u1EADt Ph\u1EA9m Ti\xEAu Hao ng\u1EABu
      nhi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566409
    m_Localized: "\u0110\u1ED3 U\u1ED1ng N\xF3ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566410
    m_Localized: "T\u0103ng v\u0129nh vi\u1EC5n {Effect0.ValueInt} S\u1EE9c m\u1EA1nh
      cho Mystling \u0111\xE3 ch\u1ECDn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566411
    m_Localized: "Salad Tr\xE1i C\xE2y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566412
    m_Localized: "T\u0103ng v\u0129nh vi\u1EC5n {Effect0.ValueInt} M\xE1u T\u1ED1i
