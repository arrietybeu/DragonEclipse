      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566413
    m_Localized: "Rau Xanh T\u01B0\u01A1i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405574
  - m_Id: 43425364990566414
