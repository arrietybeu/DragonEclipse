    m_Localized: "\u5B9D\u7BB1\u548C\u5BF9\u6218\u4F1A\u4EE4\u4F60\u83B7\u5F97\u4E24\u7C7B\u57FA\u7840\u901A\u8D27\uFF1A\n<b>\u91D1\u5E01\uFF1A</b>\u53EF\u4EE5\u5728\u573A\u666F\u4E2D\u7684\u5546\u94FA\u8D2D\u4E70\u65B0\u724C\u6216\u8005\u6D88\u8017\u54C1\uFF0C\u4E5F\u53EF\u4EE5\u7528\u5728\u5947\u7075\u57F9\u80B2\u5C4B\u6062\u590D\u5947\u7075\u751F\u529B\u3001\u590D\u82CF\u5947\u7075\u6216\u8005\u8BAD\u7EC3\u5947\u7075\u3002\n<b>\u5947\u8393\uFF1A</b>\u53EA\u80FD\u7528\u5728\u5BF9\u6218\u4E4B\u540E\u7684\u80DC\u5229\u754C\u9762\uFF0C\u8D2D\u4E70\u65B0\u724C\u548C\u5947\u7075\u7684\u5E87\u4F51\uFF0C\u4E5F\u53EF\u4EE5\u7528\u6765\u590D\u82CF\u660F\u53A5\u7684\u5947\u7075\u3002"
