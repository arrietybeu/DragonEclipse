%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Compendium_de
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: de
  m_SharedData: {fileID: 11400000, guid: 98a8d947820b5a3448a76aaf025ea69e, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8829885829830410406
  m_TableData:
  - m_Id: 54475884666880
    m_Localized: Kampfgrundlagen
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231424
    m_Localized: Werte
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231425
    m_Localized: "Sowohl Mystlinge als auch Gegner gelten als Kreaturen.\n<b>Gesundheit:</b>
      Wenn eine Kreatur keine Gesundheit mehr hat, wird sie kampfunf\xE4hig und aus
      dem Kampf entfernt. Sowohl Mystlinge als auch Gegner haben Gesundheit.\n<b>Kraft:</b>
      Bestimmt den Schaden, den ein Mystling im Kampf bewirkt. Dieser Wert kann durch
      andere Effekte wie Karten- oder Statuseffekte beeinflusst werden. Nur Mystlinge
      nutzen Kraft.\n<b>Aktivierung:</b> Jeder Mystling besitzt eine einzigartige
      F\xE4higkeit, die in der Kreaturenphase ausgel\xF6st wird, vorausgesetzt dieser
      Mystling steht nicht an vorderster Position.\n<b>Talent:</b> Jeder Mystling
      besitzt eine einzigartige passive F\xE4higkeit, die unter bestimmten Voraussetzungen
      ausgel\xF6st wird, wie beispielsweise Schaden zu erleiden oder einen Gegner
      zu besiegen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231426
    m_Localized: Karten und Energie
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231427
    m_Localized: "Benutze Karten, um deinen Mystlingen Befehle zu erteilen und Gegner
      zu besiegen. Ziehe eine Karte auf einen Mystling oder einen Gegner, um ihren
      Effekt zu aktivieren.\n\nDas Spielen von Karten kostet Energie. Du beginnst
      jede Runde mit 3 Energie. Wenn du nicht genug Energie hast, um eine Karte in
      deiner Hand spielen zu k\xF6nnen, wird es Zeit, deinen Zug zu beenden.\n\nZu
      Beginn jeder Runde wird dein Energiepool aufgefrischt und es werden neue Karten
      vom Nachziehstapel gezogen."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055488
    m_Localized: Rundenphase
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055489
    m_Localized: Jede Runde besteht aus der Spielerphase und der Kreaturenphase.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231430
    m_Localized: Spielerphase
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231431
    m_Localized: "In dieser Phase kannst du Karten spielen, deine Mystlinge neu positionieren
      und Verbrauchsgegenst\xE4nde benutzen. Wenn du \"Zug beenden\" ausw\xE4hlst,
      endet die Spielerphase und die Kreaturenphase beginnt."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231432
    m_Localized: Mystlinge bewegen
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231433
    m_Localized: "Du kannst deine Mystlinge im Kampf frei umpositionieren, indem
      du sie auf die gew\xFCnschte Position ziehst. Denk daran, dass die Position
      bestimmt, welcher Mystling seine Aktivierungsf\xE4higkeiten nutzt und welcher
      angreift.\n\nDu kannst deine Mystlinge auf der Weltkarte neu positionieren,
      indem du auf die Pfeile bei ihren Portr\xE4ts dr\xFCckst."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231434
    m_Localized: Kreaturenphase
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231435
    m_Localized: "Nachdem du deinen Zug beendet hast, handeln nacheinander alle Kreaturen.
      Gegner handeln dabei stets vor Mystlingen.\n\nGegner zeigen ihre Absicht \xFCber
      ihrem Kopf. Du kannst mit der Maus dar\xFCberfahren, um mehr Details \xFCber
      die bevorstehende Aktion zu sehen. Das Ziel dieser Aktion wird durch einen
      Umriss markiert.\n\nAlle Gegner f\xFChren nacheinander von hinten (RECHTS)
      nach vorne (LINKS) ihre jeweilige Absicht aus.\n\nDeine Mystlinge handeln dann
      direkt im Anschluss nacheinander von hinten (LINKS) nach vorne (RECHTS). Der
      Mystling ganz vorne greift an, w\xE4hrend der Rest seine Aktivierungsf\xE4higkeiten
      einsetzt."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231436
    m_Localized: Segensaktivierung
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231437
    m_Localized: "Segen und Talente haben bestimmte Bedingungen, um ihre Effekte
      auszul\xF6sen. Sie k\xF6nnen die gewohnte Abfolge einer Runde unterbrechen.\nLies
      dir den Tooltip jedes Segens genau durch, um deinen Build so effektiv wie m\xF6glich
      zu gestalten."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231438
    m_Localized: "Verbrauchsgegenst\xE4nde"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231439
    m_Localized: "Verbrauchsgegenst\xE4nde sind einmalig nutzbare Gegenst\xE4nde,
      die verschiedene Effekte ausl\xF6sen k\xF6nnen. Du kannst sie im Kampf nur
      benutzen, indem du sie auf das gew\xFCnschte Ziel ziehst (oder einfach auf
      sie klickst, wenn sie kein Ziel erfordern)."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231440
    m_Localized: "B\xE4ndigerf\xE4higkeit"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 17316704231441
    m_Localized: "Jeder B\xE4ndiger besitzt eine Spezialf\xE4higkeit. Manche sind
      im Kampf von Nutzen und manche au\xDFerhalb. Wenn ein B\xE4ndiger eine F\xE4higkeit
      im Kampf einsetzt, erhalten deine Mystlinge einen speziellen Statuseffekt,
      der durch ein Symbol mit gr\xFCnem Hintergrund dargestellt wird."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055490
    m_Localized: Fortschritt
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055491
    m_Localized: "W\xE4hrungen"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055492
    m_Localized: "Schatztruhen und K\xE4mpfe belohnen dich mit zwei grundlegenden
      W\xE4hrungen:\n<b>Gold:</b> Kann im Laden auf der Karte ausgegeben werden,
      um neue Karten oder Verbrauchsgegenst\xE4nde zu kaufen, oder in der Mystlingstation,
      um deine Mystlinge zu heilen, wiederzubeleben oder zu trainieren.\n<b>Mystbeeren:</b>
      K\xF6nnen nur nach K\xE4mpfen dazu genutzt werden, neue Karten und Segen f\xFCr
      deine Mystlinge zu kaufen. Du kannst mit ihnen au\xDFerdem kampfunf\xE4hige
      Mystlinge wiederbeleben."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055493
    m_Localized: Segen
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055494
    m_Localized: "Segen sind spezielle passive F\xE4higkeiten von Mystlingen, die
      mit Mystbeeren erworben werden k\xF6nnen. Jeder Segen besitzt einen einzigartigen
      Effekt und einen Ausl\xF6ser.\n\nDer Preis eines Segens erh\xF6ht sich f\xFCr
      jeden Segen, den ein Mystling bereits besitzt, um 2."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055495
    m_Localized: Entwicklung
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055496
    m_Localized: "Sobald ein Mystling 4 Segen besitzt, entwickelt er sich zu einer
      noch m\xE4chtigeren Gestalt.\n\nEntwickelte Mystlinge haben eine verbesserte
      Karte. Du kannst au\xDFerdem eins von drei Talenten ausw\xE4hlen. Manche davon
      k\xF6nnten das urspr\xFCngliche Talent \xFCberschreiben."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055497
    m_Localized: Stufenaufstieg
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055498
    m_Localized: "Nach jedem Run - erfolgreich oder nicht - erh\xE4ltst du Erfahrungspunkte.
      Wenn du ausreichend Punkte gesammelt hast, erklimmst du die Stufenleiter und
      schaltest neue Mystlinge, B\xE4ndigerkarten und Segen frei.\n\nFreigeschaltete
      Mystlinge und B\xE4ndiger k\xF6nnen vor dem Start eines neuen Runs ausgew\xE4hlt
      werden. Neue Karten und Segen erscheinen w\xE4hrend der Runs in L\xE4den."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055499
    m_Localized: Finsternis-Timer
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055500
    m_Localized: "Runs sind zeitlich begrenzt. Die Zahl der K\xE4mpfe, die du bestreiten
      kannst, bevor die Finsternis kommt, h\xE4ngt von der Schwierigkeitsstufe ab.
      Wenn der Timer null erreicht, beginnt der Bosskampf."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055501
    m_Localized: Dorf
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055502
    m_Localized: Freies Spiel
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055503
    m_Localized: "Das Dorf ist dein Zuhause und deine Operationsbasis. Nach Abschluss
      eines Runs kehrst du immer ins Dorf zur\xFCck.\n\nDu kannst mit Mystlingen
      und Dorfbewohnern interagieren, um mehr \xFCber sie zu erfahren. Behalte deine
      Z\xF6glinge im Auge, denn manchmal ben\xF6tigen sie bei einem Problem deine
      Hilfe."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055504
    m_Localized: "K\xFCche"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055505
    m_Localized: "Bevor du zu deinem n\xE4chsten Abenteuer aufbrichst, kannst du
      einen zuf\xE4lligen Verbrauchsgegenstand in der K\xFCche bestellen. Aber keine
      Sorge, das geht aufs Haus."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055506
    m_Localized: Effekte
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055507
    m_Localized: Statuseffekte
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055508
    m_Localized: "<b>Schilde:</b> Sch\xFCtzen Gesundheit bis zur n\xE4chsten Runde
      vor eingehendem Schaden."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055512
    m_Localized: "<b>Ausweichen:</b> Verhindert, dass die Kreatur Schaden erleidet.
      Statusz\xE4hler wird nach jedem ausgewichenen Angriff um 1 gesenkt."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055511
    m_Localized: "<b>Abschirmen:</b> Reduziere den n\xE4chsten eingehenden Schaden
      auf 1."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055515
    m_Localized: "<b>Wiederbeleben:</b> Belebe diese Kreatur sofort mit 50 % ihrer
      max. Gesundheit wieder, nachdem sie kampfunf\xE4hig wurde. Senkt den Statuswert
      um 1."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055520
    m_Localized: <b>Abwehrhaltung:</b> Reduziere den erlittenen Schaden um 50 %.
      Wird in jeder Runde verringert.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055509
    m_Localized: "<b>Zorn:</b> Erh\xF6ht die Kraft bis zum Kampfende."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055510
    m_Localized: "<b>St\xE4rke:</b> Erh\xF6ht die Kraft bis zum Ende der Runde."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055513
    m_Localized: "<b>Mehrfachangriff:</b> Erh\xF6he die Anzahl der Angriffe f\xFCr
      jeden gekonterten Mehrfachangriff um 1."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055514
    m_Localized: "<b>Permanenter Mehrfachangriff:</b> Erh\xF6he die Anzahl der Angriffe
      f\xFCr jeden gekonterten Mehrfachangriff bis zum Kampfende."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055516
    m_Localized: "<b>Dornen:</b> Verursache Schaden in H\xF6he des Dornenwerts des
      Angreifers, wenn du angegriffen wirst. Status verschwindet direkt danach."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055517
    m_Localized: "<b>Verwundbarkeit:</b> Wenn diese Kreatur Schaden beliebiger Art
      aus beliebiger Quelle erleidet, erleidet sie zus\xE4tzlichen Schaden in H\xF6he
      der Verwundbarkeit. Reduziere den Statuswert nach jedem Treffer."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055518
    m_Localized: "<b>Schw\xE4che:</b> Senkt die Kraft f\xFCr jeden Schw\xE4chekonter."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055519
    m_Localized: '<b>Lebensraub:</b> Angriff: Heile dich selbst um den bei einem
      Gegner bewirkten Schaden.'
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055521
    m_Localized: "<b>Ungesch\xFCtzt:</b> Erh\xF6he den erlittenen Schaden um 100
      %. Wird jede Runde verringert."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055522
    m_Localized: "<b>Bet\xE4uben:</b> Kreatur kann weder aktiviert werden noch angreifen.
      Wird zu Beginn nach jeder Runde um 1 verringert."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055523
    m_Localized: "Ausl\xF6ser"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 67300346634240
    m_Localized: "<b>Verletzt:</b> Wenn die Kreatur Gesundheit verliert.\n<b>Angegriffen:</b>
      Wenn die Kreatur Schaden erleidet, selbst wenn sie keine Gesundheit verliert.\n<b>K.
      o.:</b> Wenn die Kreatur eine andere Kreatur besiegt.\n<b>Kampfunf\xE4hig:</b>
      Wenn die Gesundheit der Kreatur auf null sinkt."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055528
    m_Localized: "Schl\xFCsselw\xF6rter"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 67405132931072
    m_Localized: "<b>Ersch\xF6pfen:</b> Wird nach dem Ausspielen bis nach dem Kampf
      aus dem Deck entfernt.\n<b>\xDCberladen:</b> Spiele diese Karte so oft wie
      die Anzahl der in dieser Runde gespielten Karten.\n<b>Anwachsen:</b> Jedes
      Mal, wenn diese Karte gespielt wird, erh\xF6ht sich ihr Wert bis zum Kampfende
      um die Anzahl von Anwachsen.\n<b>Verwelken:</b> Jedes Mal, wenn diese Karte
      gespielt wird, sinkt ihr Wert um die Anzahl von Verwelken bis zum Kampfende.\n<b>Position
      verzaubern:</b> Wirke eine Verzauberung auf eine Position."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055534
    m_Localized: Karten
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055535
    m_Localized: Segen
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055536
    m_Localized: "Verbrauchsgegenst\xE4nde"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055537
    m_Localized: "<b>Rohes Fleisch:</b> Wirke St\xE4rke auf einen ausgew\xE4hlten
      Mystling."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055538
    m_Localized: "<b>Himbeer-K\xE4sekuchen:</b> Wirke Schilde auf einen ausgew\xE4hlten
      Mystling."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055539
    m_Localized: "<b>Kr\xE4ftige Suppe:</b> Heile einen ausgew\xE4hlten Mystling."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055540
    m_Localized: "<b>K\xF6stliche Nachspeise:</b> Wirke Wiederbeleben auf einen ausgew\xE4hlten
      Mystling."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055541
    m_Localized: "<b>Ausgewogene Mahlzeit:</b> Erhalte 2 zuf\xE4llige Verbrauchsgegenst\xE4nde."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055542
    m_Localized: "<b>Hei\xDFgetr\xE4nk:</b> Erh\xF6he die Kraft eines ausgew\xE4hlten
      Mystlings permanent."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055543
    m_Localized: "<b>Obstsalat:</b> Erh\xF6he die max. Gesundheit eines ausgew\xE4hlten
      Mystlings permanent."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055544
    m_Localized: "<b>Blattgem\xFCse:</b> Wirke Ausweichen auf einen ausgew\xE4hlten
      Mystling."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055545
    m_Localized: <b>Schale mit Knoblauch:</b> Ziehe Karten.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 54475893055546
    m_Localized: <b>Starker Tee:</b> Erhalte 2 Energie.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410406
  - m_Id: 264007820933885952
    m_Localized: Mystling Eggs
    m_Metadata:
      m_Items: []
  - m_Id: 264007820933885953
    m_Localized: 'To gain a new Mystling, you need to hatch its Egg first. Every
      new unlocked Egg will show up in the Hatchery building in your village.

      To
      hatch it you will have to complete a challenge. You can check your progress
      in the Hatchery building in between runs.

      Once your challenge is completed
      your Egg will hatch a new Mystlign will be available for a new run.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
