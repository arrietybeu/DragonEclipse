      - rid: 8829885849422266434
  - m_Id: 54475893055543
    m_Localized: "<b>\u30D5\u30EB\u30FC\u30C4\u30B5\u30E9\u30C0\uFF1A</b>\u9078\u629E\u3057\u305F\u30DF\u30B9\u30C8\u30EA\u30F3\u30B0\u306E\u6700\u5927\u4F53\u529B\u304C\u6C38\u7D9A\u7684\u306B\u4E0A\u6607"
    m_Metadata:
      m_Items:
      - rid: 8829885849422266434
  - m_Id: 54475893055544
    m_Localized: "<b>\u65B0\u9BAE\u306A\u91CE\u83DC\uFF1A</b>\u9078\u629E\u3057\u305F\u30DF\u30B9\u30C8\u30EA\u30F3\u30B0\u306B\u56DE\u907F\u3092\u4ED8\u4E0E"
    m_Metadata:
      m_Items:
      - rid: 8829885849422266434
  - m_Id: 54475893055545
    m_Localized: "<b>\u30DC\u30A6\u30EB\u4E00\u676F\u306E\u30CB\u30F3\u30CB\u30AF\uFF1A</b>\u30AB\u30FC\u30C9\u3092\u5F15\u304F"
