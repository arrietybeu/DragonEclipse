    m_Localized: "\u30DF\u30B9\u30C8\u30EA\u30F3\u30B0\u3068\u6575\u306E\u4E21\u65B9\u3092\u300C\u751F\u304D\u7269\u300D\u3068\u3059\u308B\u3002\n<b>\u4F53\u529B\uFF1A</b>
