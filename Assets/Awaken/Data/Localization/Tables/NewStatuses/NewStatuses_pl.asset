--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NewStatuses_pl
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: pl
  m_SharedData: {fileID: 11400000, guid: 34301eff957f73749b54541df78e6573, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2105433060097654818
  m_TableData:
  - m_Id: 2817150533632
    m_Localized: Trucizna
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533633
    m_Localized: "Stw\xF3r traci na pocz\u0105tku rundy 1 PZ. -1 p. po ka\u017Cdym
      trafieniu."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533634
    m_Localized: Gniew
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533635
    m_Localized: "Zwi\u0119ksza moc. -1 p. po ka\u017Cdym trafieniu."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533636
    m_Localized: <smallcaps><style="Blue">Gniew</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533637
    m_Localized: "Zwi\u0119ksza <style=\"Blue\">moc</style> do <style=\"Blue\">ko\u0144ca
      walki</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533638
    m_Localized: "<smallcaps><style=\"Blue\">Os\u0142ona</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533639
    m_Localized: "Zapobiega <style=\"Blue\">obra\u017Ceniom</style> do nast\u0119pnej
      tury"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533640
    m_Localized: Kontratak
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533641
    m_Localized: "Po trafieniu mystlingi kontratakuj\u0105. -1 p. po ka\u017Cdym
      trafieniu."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533642
    m_Localized: <smallcaps><style="Blue">Unik</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533643
    m_Localized: "<style=\"Blue\">Chroni</style> stwora przed otrzymaniem <style=\"Blue\">obra\u017Ce\u0144</style>.
      <smallcaps><style=\"Blue\">Unik</style></smallcaps> maleje o 1 punkt po ka\u017Cdym
      <style=\"Blue\">trafieniu</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533644
    m_Localized: <smallcaps><style="Blue">Ciernie</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533645
    m_Localized: "Kiedy ten stw\xF3r zostanie <style=\"Blue\">trafiony</style>, zadaje
      napastnikowi <style=\"Blue\">obra\u017Cenia</style> r\xF3wne liczbie punkt\xF3w
      <smallcaps><style=\"Blue\">cierni</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533648
    m_Localized: <smallcaps><style="Blue">Wielocios</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533649
    m_Localized: "Na jedn\u0105 tur\u0119 zwi\u0119ksza liczb\u0119 atak\xF3w o liczb\u0119
      punkt\xF3w <smallcaps><style=\"Blue\">wielociosu</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533650
    m_Localized: "<smallcaps><style=\"Blue\">Os\u0142abienie</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533652
    m_Localized: "Niewra\u017Cliwo\u015B\u0107"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533653
    m_Localized: "Chroni przed karami. -1 p. za ka\u017Cd\u0105 kar\u0119."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727936
    m_Localized: Pech
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727937
    m_Localized: "Uniemo\u017Cliwia przyznawanie premii. -1 p. za ka\u017Cd\u0105
      premi\u0119."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727938
    m_Localized: Dezorientacja
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727939
    m_Localized: "Stw\xF3r atakuje sojusznika. Efekt ten znika pod koniec rundy."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727940
    m_Localized: "<smallcaps><style=\"Blue\">Si\u0142a</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727941
    m_Localized: "Zwi\u0119ksza <style=\"Blue\">moc</style> do ko\u0144ca rundy"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727942
    m_Localized: "Os\u0142ony na moc"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727943
    m_Localized: "Do ko\u0144ca rundy zamienia p. os\u0142ony na p. mocy."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727944
    m_Localized: "Zm\u0119czenie"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727945
    m_Localized: "Zmniejsza moc do ko\u0144ca walki."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727946
    m_Localized: "\u0141adowanie"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727947
    m_Localized: "Zyskujesz p. energii r\xF3wne warto\u015Bci efektu."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727948
    m_Localized: "<smallcaps><style=\"Blue\">Bezbronno\u015B\u0107</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727949
    m_Localized: "Stw\xF3r otrzymuje dodatkowe <style=\"Blue\">obra\u017Cenia</style>
      r\xF3wne liczbie punkt\xF3w <smallcaps><style=\"Blue\">bezbronno\u015Bci</style></smallcaps>.
      Po ka\u017Cdym <style=\"Blue\">otrzymanym ciosie</style> liczba punkt\xF3w
      maleje"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727950
    m_Localized: "<smallcaps><style=\"Blue\">O\u017Cywienie</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817154727951
    m_Localized: "Je\u015Bli ten stw\xF3r ma <style=\"Blue\">omdle\u0107</style>,
      zamiast tego natychmiast <style=\"Blue\">ulecz</style> go do 50% maks. zdrowia."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 11577478002884608
    m_Localized: "<smallcaps><style=\"Blue\">Og\u0142uszony</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 11577478036439040
    m_Localized: "W nast\u0119pnej turze stw\xF3r <style=\"Blue\">nie mo\u017Ce si\u0119
      aktywowa\u0107</style> ani <style=\"Blue\">atakowa\u0107</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 2817150533651
    m_Localized: "Zmniejsza <style=\"Blue\">moc</style> o liczb\u0119 punkt\xF3w
      <smallcaps><style=\"Blue\">os\u0142abienia</style></smallcaps>. <smallcaps><style=\"Blue\">Os\u0142abienie</style></smallcaps>
      znika po wyprowadzeniu <style=\"Blue\">ataku</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 64893457373667328
    m_Localized: "Je\u015Bli ten stw\xF3r ma <style=\"Blue\">omdle\u0107</style>,
      zamiast tego natychmiast <style=\"Blue\">ulecz</style> go do pe\u0142ni zdrowia."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 9029693395288064
    m_Localized: <smallcaps><style="Blue">Izolacja</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 9029693412065280
    m_Localized: "Zmniejsza otrzymywane <style=\"Blue\">obra\u017Cenia</style> o
      1"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 16331961937240064
    m_Localized: <style="Blue">Moc</style>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 16331961954017280
    m_Localized: "Zwi\u0119ksza moc do ko\u0144ca walki"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 25039761924276224
    m_Localized: <smallcaps><style="Blue">Garda</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 25039761949442048
    m_Localized: "Zmniejsza otrzymywane <style=\"Blue\">obra\u017Cenia</style> o
      50%. Z ka\u017Cd\u0105 <style=\"Blue\">tur\u0105</style> liczba punkt\xF3w
      <smallcaps><style=\"Blue\">gardy</style></smallcaps> maleje o 1."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 64830575973834752
    m_Localized: "Zmniejsza otrzymywane <style=\"Blue\">obra\u017Cenia</style> o
      50%."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 25039761949442049
    m_Localized: "<smallcaps><style=\"Blue\">Ods\u0142oni\u0119cie</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 25039761949442050
    m_Localized: "Zwi\u0119ksza otrzymywane <style=\"Blue\">obra\u017Cenia</style>
      o 100%."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 26428515930939392
    m_Localized: "<smallcaps><style=\"Blue\">Wyssanie \u017Cycia</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 26428515956105216
    m_Localized: "Stw\xF3r <style=\"Blue\">leczy</style> si\u0119 o liczb\u0119 zadanych
      <style=\"Blue\">obra\u017Ce\u0144</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 37357454379524096
    m_Localized: "<smallcaps><style=\"Blue\">Cz\u0119\u015Bciowe wyssanie \u017Cycia</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 37357454404689920
    m_Localized: "Atak: leczy si\u0119 o po\u0142ow\u0119 zadanych obra\u017Ce\u0144"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 27119552156516352
    m_Localized: "<smallcaps><style=\"Blue\">Wielocios na sta\u0142e</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 27119552181682176
    m_Localized: "Zwi\u0119ksza na sta\u0142e liczb\u0119 atak\xF3w o liczb\u0119
      punkt\xF3w <smallcaps><style=\"Blue\">wielociosu</smallcaps></style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 37357454404689921
    m_Localized: "<smallcaps><style=\"Blue\">Cienista posta\u0107</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 37357454404689922
    m_Localized: "<style=\"Blue\">Przekierowuje</style> otrzymywane <style=\"Blue\">obra\u017Cenia</style>
      na sojusznika za sob\u0105. Mo\u017Ce otrzymywa\u0107 efekty stanu"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 44573523078881280
    m_Localized: <smallcaps><style="Blue">Dezorientacja</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 44573523099852800
    m_Localized: Kiedy <style="Blue">atakuje</style>, zamiast mystlinga na cel wybierze
      <style="Blue">losowego</style> sojusznika (lub siebie)
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 47868807976394752
    m_Localized: "<smallcaps><style=\"Blue\">Niezniszczalno\u015B\u0107</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 47868808005754880
    m_Localized: "Stw\xF3r jest <style=\"Blue\">niewra\u017Cliwy</style> na <style=\"Blue\">obra\u017Cenia</style>.
      Z ka\u017Cd\u0105 <style=\"Blue\">tur\u0105</style> liczba punkt\xF3w <style=\"Blue\">niezniszczalno\u015Bci</style>
      maleje o 1."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 47868808005754881
    m_Localized: <smallcaps><style="Blue">Kwas</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 47868808005754882
    m_Localized: "Pocz\u0105tek rundy: otrzymuje 1 p. obra\u017Ce\u0144 za ka\u017Cdy
      punkt <smallcaps><style=\"Blue\">kwasu</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 54352449930076160
    m_Localized: "<smallcaps><style=\"Blue\">Smoczy \u0142adunek</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
  - m_Id: 54352449955241984
    m_Localized: "Po zebraniu 5 smoczych \u0142adunk\xF3w do ko\u0144ca rundy przekszta\u0142ca
      si\u0119 w smoka.\nPosta\u0107 smoka: zyskuje 5 p. <style=\"Blue\">si\u0142y</style>
      i 20 p. <style=\"Blue\">os\u0142ony</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654818
