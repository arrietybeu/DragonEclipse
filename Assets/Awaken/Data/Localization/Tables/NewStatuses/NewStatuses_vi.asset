  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NewStatuses_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 34301eff957f73749b54541df78e6573, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8099901647879405572
  m_TableData:
  - m_Id: 2817150533632
    m_Localized: "<style=\"Blue\">\u0110\u1ED9c</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533633
    m_Localized: "\u0110\u1EA7u v\xF2ng, sinh v\u1EADt m\u1EA5t 1 M\xE1u. Gi\u1EA3m
      1 sau m\u1ED7i \u0111\xF2n tr\xFAng."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533634
    m_Localized: "<style=\"Blue\">Th\u1ECBnh N\u1ED9</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533635
    m_Localized: "T\u0103ng S\u1EE9c m\u1EA1nh. Gi\u1EA3m 1 sau m\u1ED7i \u0111\xF2n
      tr\xFAng."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533636
    m_Localized: "<smallcaps><style=\"Blue\">Th\u1ECBnh N\u1ED9</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533637
    m_Localized: "T\u0103ng <style=\"Blue\">S\u1EE9c m\u1EA1nh</style> \u0111\u1EBFn
      <style=\"Blue\">h\u1EBFt Tr\u1EADn \u0111\u1EA5u</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533638
    m_Localized: "<smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533639
    m_Localized: "Ch\u1EB7n <style=\"Blue\">S\xE1t th\u01B0\u01A1ng</style> \u0111\u1EBFn
      L\u01B0\u1EE3t ti\u1EBFp theo."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533640
    m_Localized: "<style=\"Blue\">Ph\u1EA3n \u0110\xF2n</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533641
    m_Localized: "Mystling b\u1ECB t\u1EA5n c\xF4ng s\u1EBD \u0111\xE1nh tr\u1EA3.
      Gi\u1EA3m 1 sau m\u1ED7i \u0111\xF2n tr\xFAng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533642
    m_Localized: "<smallcaps><style=\"Blue\">N\xE9 Tr\xE1nh</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533643
    m_Localized: "<style=\"Blue\">Ng\u0103n</style> Sinh v\u1EADt <style=\"Blue\">nh\u1EADn
      s\xE1t th\u01B0\u01A1ng</style>. <smallcaps><style=\"Blue\">N\xE9 Tr\xE1nh</style></smallcaps>
      gi\u1EA3m 1 sau m\u1ED7i <style=\"Blue\">\u0110\xF2n tr\xFAng</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533644
    m_Localized: <smallcaps><style="Blue">Gai</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533645
    m_Localized: "Khi Sinh v\u1EADt n\xE0y <style=\"Blue\">b\u1ECB \u0111\xE1nh tr\xFAng</style>,
      n\xF3 g\xE2y <style=\"Blue\">S\xE1t th\u01B0\u01A1ng</style> l\xEAn k\u1EBB
      t\u1EA5n c\xF4ng b\u1EB1ng gi\xE1 tr\u1ECB <smallcaps><style=\"Blue\">Gai</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533648
    m_Localized: "<smallcaps><style=\"Blue\">\u0110a K\xEDch</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533649
    m_Localized: "T\u0103ng s\u1ED1 \u0111\xF2n t\u1EA5n c\xF4ng theo m\u1ED7i t\u1EA7ng
      <smallcaps><style=\"Blue\">\u0110a K\xEDch</style></smallcaps> trong 1 l\u01B0\u1EE3t."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533650
    m_Localized: "<smallcaps><style=\"Blue\">Suy Y\u1EBFu</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533651
    m_Localized: "Gi\u1EA3m <style=\"Blue\">S\u1EE9c m\u1EA1nh</style> theo gi\xE1
      tr\u1ECB <smallcaps><style=\"Blue\">Suy Y\u1EBFu</style></smallcaps>. <smallcaps><style=\"Blue\">Suy
      Y\u1EBFu</style></smallcaps> bi\u1EBFn m\u1EA5t sau m\u1ED9t \u0111\xF2n <style=\"Blue\">T\u1EA5n
      c\xF4ng</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533652
    m_Localized: "<style=\"Blue\">Mi\u1EC5n Nhi\u1EC5m</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817150533653
    m_Localized: "Ng\u0103n Debuff b\u1ECB \xE1p l\xEAn. Gi\u1EA3m 1 m\u1ED7i khi
      ch\u1EB7n \u0111\u01B0\u1EE3c m\u1ED9t Debuff"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727936
    m_Localized: "<style=\"Blue\">V\u1EADn R\u1EE7i</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727937
    m_Localized: "Ng\u0103n Buff \u0111\u01B0\u1EE3c \xE1p l\xEAn. Gi\u1EA3m 1 m\u1ED7i
      khi ch\u1EB7n \u0111\u01B0\u1EE3c m\u1ED9t Buff"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727938
    m_Localized: "<style=\"Blue\">H\u1ED7n Lo\u1EA1n</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727939
    m_Localized: "Sinh v\u1EADt s\u1EBD \u0111\xE1nh tr\xFAng \u0111\u1ED3ng minh
      c\u1EE7a ch\xEDnh m\xECnh. Bi\u1EBFn m\u1EA5t sau m\u1ED9t \u0111\xF2n t\u1EA5n
      c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727940
    m_Localized: "<smallcaps><style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727941
    m_Localized: "T\u0103ng <style=\"Blue\">S\u1EE9c m\u1EA1nh</style> \u0111\u1EBFn
      h\u1EBFt V\xF2ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727942
    m_Localized: "<style=\"Blue\">Khi\xEAn H\xF3a S\u1EE9c M\u1EA1nh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727943
    m_Localized: "Chuy\u1EC3n Khi\xEAn th\xE0nh S\u1EE9c m\u1EA1nh \u0111\u1EBFn
      h\u1EBFt v\xF2ng."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727944
    m_Localized: "<style=\"Blue\">M\u1EC7t M\u1ECFi</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727945
    m_Localized: "Gi\u1EA3m S\u1EE9c m\u1EA1nh. Bi\u1EBFn m\u1EA5t sau m\u1ED9t \u0111\xF2n
      t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727946
    m_Localized: "<style=\"Blue\">T\xEDch N\u0103ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727947
    m_Localized: "L\u01B0\u1EE3t sau nh\u1EADn N\u0103ng l\u01B0\u1EE3ng b\u1EB1ng
      gi\xE1 tr\u1ECB tr\u1EA1ng th\xE1i."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727948
    m_Localized: <smallcaps><style="Blue">Mong Manh</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727949
    m_Localized: "Sinh v\u1EADt ch\u1ECBu th\xEAm <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      b\u1EB1ng gi\xE1 tr\u1ECB <smallcaps><style=\"Blue\">Mong Manh</style></smallcaps>.
      Gi\u1EA3m gi\xE1 tr\u1ECB tr\u1EA1ng th\xE1i sau m\u1ED7i <style=\"Blue\">\u0111\xF2n
      tr\xFAng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727950
    m_Localized: "<smallcaps><style=\"Blue\">H\u1ED3i Sinh</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 2817154727951
    m_Localized: "L\u1EADp t\u1EE9c <style=\"Blue\">h\u1ED3i</style> Sinh v\u1EADt
      n\xE0y v\u1EC1 50% M\xE1u T\u1ED1i \u0110a thay v\xEC <style=\"Blue\">g\u1EE5c</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 9029693395288064
    m_Localized: "<smallcaps><style=\"Blue\">Gi\u1EA3m Ch\u1EA5n</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 9029693412065280
    m_Localized: "Gi\u1EA3m \u0111\xF2n <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      ti\u1EBFp theo xu\u1ED1ng c\xF2n 1"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 11577478002884608
    m_Localized: "<smallcaps><style=\"Blue\">Cho\xE1ng</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 11577478036439040
    m_Localized: "Sinh v\u1EADt <style=\"Blue\">kh\xF4ng th\u1EC3 k\xEDch ho\u1EA1t</style>
      hay <style=\"Blue\">t\u1EA5n c\xF4ng</style> \u1EDF L\u01B0\u1EE3t sau."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 16331961937240064
    m_Localized: "<style=\"Blue\">S\u1EE9c M\u1EA1nh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 16331961954017280
    m_Localized: "T\u0103ng S\u1EE9c m\u1EA1nh \u0111\u1EBFn h\u1EBFt Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 25039761924276224
    m_Localized: "<smallcaps><style=\"Blue\">Ph\xF2ng B\u1ECB</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 25039761949442048
    m_Localized: "Gi\u1EA3m 50% <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style> nh\u1EADn
      v\xE0o. <smallcaps><style=\"Blue\">Ph\xF2ng B\u1ECB</style></smallcaps> gi\u1EA3m
      1 m\u1ED7i <style=\"Blue\">L\u01B0\u1EE3t</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 25039761949442049
    m_Localized: "<smallcaps><style=\"Blue\">S\u01A1 H\u1EDF</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 25039761949442050
    m_Localized: "T\u0103ng 100% <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      nh\u1EADn v\xE0o."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 26428515930939392
    m_Localized: "<smallcaps><style=\"Blue\">H\xFAt M\xE1u</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 26428515956105216
    m_Localized: "Sinh v\u1EADt <style=\"Blue\">h\u1ED3i m\xE1u</style> cho b\u1EA3n
      th\xE2n b\u1EB1ng gi\xE1 tr\u1ECB <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 27119552156516352
    m_Localized: "<smallcaps><style=\"Blue\">\u0110a K\xEDch V\u0129nh Vi\u1EC5n</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 27119552181682176
    m_Localized: "T\u0103ng v\u0129nh vi\u1EC5n s\u1ED1 \u0111\xF2n t\u1EA5n c\xF4ng
      theo m\u1ED7i t\u1EA7ng <smallcaps><style=\"Blue\">\u0110a K\xEDch</smallcaps></style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 37357454379524096
    m_Localized: "<smallcaps><style=\"Blue\">B\xE1n H\xFAt M\xE1u</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 37357454404689920
    m_Localized: "T\u1EA5n c\xF4ng: H\u1ED3i m\xE1u cho b\u1EA3n th\xE2n b\u1EB1ng
      m\u1ED9t n\u1EEDa s\xE1t th\u01B0\u01A1ng g\xE2y l\xEAn k\u1EBB \u0111\u1ECBch"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 37357454404689921
    m_Localized: "<smallcaps><style=\"Blue\">D\u1EA1ng B\xF3ng T\u1ED1i</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 37357454404689922
    m_Localized: "<style=\"Blue\">Chuy\u1EC3n h\u01B0\u1EDBng</style> <style=\"Blue\">s\xE1t
      th\u01B0\u01A1ng</style> nh\u1EADn v\xE0o sang \u0111\u1ED3ng minh ph\xEDa
      sau. V\u1EABn c\xF3 th\u1EC3 nh\u1EADn Tr\u1EA1ng th\xE1i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 44573523078881280
    m_Localized: "<smallcaps><style=\"Blue\">M\xEA Lo\u1EA1n</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 44573523099852800
    m_Localized: "Khi <style=\"Blue\">t\u1EA5n c\xF4ng</style>, s\u1EBD nh\u1EAFm
      v\xE0o \u0111\u1ED3ng minh <style=\"Blue\">ng\u1EABu nhi\xEAn</style> (ho\u1EB7c
      ch\xEDnh m\xECnh) thay v\xEC m\u1ED9t Mystling"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 47868807976394752
    m_Localized: "<smallcaps><style=\"Blue\">B\u1EA5t Ho\u1EA1i</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 47868808005754880
    m_Localized: "Sinh v\u1EADt <style=\"Blue\">Mi\u1EC5n nhi\u1EC5m</style> v\u1EDBi
      <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>.  <style=\"Blue\">B\u1EA5t
      Ho\u1EA1i</style> gi\u1EA3m 1 m\u1ED7i <style=\"Blue\">L\u01B0\u1EE3t</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 47868808005754881
    m_Localized: <smallcaps><style="Blue">Axit</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 47868808005754882
    m_Localized: "\u0110\u1EA7u V\xF2ng: G\xE2y 1 s\xE1t th\u01B0\u01A1ng cho m\u1ED7i
      t\u1EA7ng <smallcaps><style=\"Blue\">Axit</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 54352449930076160
    m_Localized: "<smallcaps><style=\"Blue\">Long Kh\xED</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 54352449955241984
    m_Localized: "Khi t\xEDch \u0111\u1EE7 5 Long Kh\xED, bi\u1EBFn th\xE0nh D\u1EA1ng
      R\u1ED3ng \u0111\u1EBFn h\u1EBFt V\xF2ng.\nD\u1EA1ng R\u1ED3ng: Nh\u1EADn 5
      <style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style> v\xE0 20 <style=\"Blue\">Khi\xEAn</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 64830575973834752
    m_Localized: "Gi\u1EA3m 50% <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style> nh\u1EADn
      v\xE0o."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
  - m_Id: 64893457373667328
    m_Localized: "L\u1EADp t\u1EE9c <style=\"Blue\">h\u1ED3i</style> Sinh v\u1EADt
      n\xE0y v\u1EC1 M\xE1u T\u1ED1i \u0110a thay v\xEC <style=\"Blue\">g\u1EE5c</style>."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405572
