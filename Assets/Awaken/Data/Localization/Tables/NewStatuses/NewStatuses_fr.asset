  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: NewStatuses_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: 34301eff957f73749b54541df78e6573, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2105433060097654819
  m_TableData:
  - m_Id: 2817150533632
    m_Localized: Poison
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533633
    m_Localized: "Au d\xE9but du round, la cr\xE9ature perd 1 en sant\xE9. Diminue
      de 1 apr\xE8s chaque coup au but."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533634
    m_Localized: "Col\xE8re"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533635
    m_Localized: "Augmente la Puissance. Diminue de 1 apr\xE8s chaque coup au but."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533636
    m_Localized: "<smallcaps><style=\"Blue\">Col\xE8re</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533637
    m_Localized: "Augmente la <style=\"Blue\">Puissance</style> jusqu'\xE0 la <style=\"Blue\">fin
      du combat</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533638
    m_Localized: <smallcaps><style="Blue">Boucliers</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533639
    m_Localized: "Contre autant de <style=\"Blue\">d\xE9g\xE2ts</style> que votre
      nombre de <style=\"Blue\">boucliers</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533640
    m_Localized: Contre-attaque
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533641
    m_Localized: "Le Mystling touch\xE9 riposte. Diminue de 1 apr\xE8s chaque coup
      au but."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533642
    m_Localized: <smallcaps><style="Blue">Esquive</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533643
    m_Localized: "<style=\"Blue\">Emp\xEAche</style> la cr\xE9ature de subir des
      <style=\"Blue\">d\xE9g\xE2ts</style>. La valeur d'<smallcaps><style=\"Blue\">Esquive</style></smallcaps>
      diminue de 1 apr\xE8s chaque <style=\"Blue\">coup re\xE7u</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533644
    m_Localized: "<smallcaps><style=\"Blue\">\xC9pines</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533645
    m_Localized: "Quand cette cr\xE9ature est <style=\"Blue\">touch\xE9e</style>,
      elle inflige des <style=\"Blue\">d\xE9g\xE2ts</style> en retour \xE0 l'attaquant,
      ceux-ci \xE9tant \xE9gaux \xE0 sa valeur d'<smallcaps><style=\"Blue\">\xC9pines</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533648
    m_Localized: <smallcaps><style="Blue">Attaques multiples</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533649
    m_Localized: "Augmente pendant 1\_tour le nombre d'attaques par incr\xE9ment
      d'<smallcaps><style=\"Blue\">Attaques multiples</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533650
    m_Localized: <smallcaps><style="Blue">Faiblesse</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533652
    m_Localized: "Immunit\xE9"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533653
    m_Localized: "Prot\xE8ge contre les d\xE9buffs. Diminue de 1 \xE0 chaque d\xE9buff
      \xE9vit\xE9."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727936
    m_Localized: Malchance
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727937
    m_Localized: "Emp\xEAche les buffs d'\xEAtre appliqu\xE9s. Diminue de 1 \xE0
      chaque buff non appliqu\xE9."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727938
    m_Localized: Confusion
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727939
    m_Localized: "La cr\xE9ature attaque un alli\xE9. Expire totalement apr\xE8s
      1\_coup au but."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727940
    m_Localized: <smallcaps><style="Blue">Force</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727941
    m_Localized: "Augmente la <style=\"Blue\">Puissance</style> jusqu'\xE0 la fin
      du round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727942
    m_Localized: Bouclier de Puissance
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727943
    m_Localized: "Convertit le Bouclier en Puissance jusqu'\xE0 la fin du round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727944
    m_Localized: Fatigue
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727945
    m_Localized: "R\xE9duit la Puissance jusqu'\xE0 la fin du combat. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727946
    m_Localized: Charge
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727947
    m_Localized: "Gagne de l'\xE9nergie au tour suivant en fonction de la valeur
      de l'\xE9tat."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727948
    m_Localized: "<smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727949
    m_Localized: "La cr\xE9ature subit des <style=\"Blue\">d\xE9g\xE2ts</style> suppl\xE9mentaires
      \xE9gaux \xE0 sa valeur de <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>.
      La valeur de cet \xE9tat diminue de 1 apr\xE8s chaque <style=\"Blue\">coup</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727950
    m_Localized: <smallcaps><style="Blue">Ranimation</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817154727951
    m_Localized: "Au lieu de <style=\"Blue\">s'\xE9vanouir</style>, cette cr\xE9ature
      est instantan\xE9ment <style=\"Blue\">soign\xE9e</style> et revient \xE0 50\_%
      de son maximum de <style=\"Blue\">sant\xE9</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 11577478002884608
    m_Localized: "<smallcaps><style=\"Blue\">\xC9tourdi</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 11577478036439040
    m_Localized: "La cr\xE9ature ne peut pas <style=\"Blue\">s'activer</style> ni
      <style=\"Blue\">attaquer</style> lors du tour suivant."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 2817150533651
    m_Localized: "R\xE9duit la <style=\"Blue\">Puissance</style> d'un montant \xE9gal
      \xE0 la valeur de <smallcaps><style=\"Blue\">Faiblesse</style></smallcaps>.
      Se dissipe apr\xE8s une <style=\"Blue\">attaque</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 64893457373667328
    m_Localized: "Au lieu de <style=\"Blue\">s'\xE9vanouir</style>, cette cr\xE9ature
      est instantan\xE9ment <style=\"Blue\">soign\xE9e</style> et revient \xE0 son
      maximum de <style=\"Blue\">sant\xE9</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 9029693395288064
    m_Localized: "<smallcaps><style=\"Blue\">\xC9cran</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 9029693412065280
    m_Localized: "\xC9cran\_: r\xE9duit les prochains <style=\"Blue\">d\xE9g\xE2ts</style>
      subis \xE0 1."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 16331961937240064
    m_Localized: <style="Blue">Puissance</style>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 16331961954017280
    m_Localized: "Augmente la Puissance jusqu'\xE0 la fin du combat."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 25039761924276224
    m_Localized: <smallcaps><style="Blue">Garde</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 25039761949442048
    m_Localized: "R\xE9duit les <style=\"Blue\">d\xE9g\xE2ts</style> subis de 50\_%.
      L'effet <smallcaps><style=\"Blue\">Garde</style></smallcaps> diminue de 1 par
      <style=\"Blue\">round</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 64830575973834752
    m_Localized: "R\xE9duit les <style=\"Blue\">d\xE9g\xE2ts</style> subis de 50\_%."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 25039761949442049
    m_Localized: "<smallcaps><style=\"Blue\">Sans d\xE9fense</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 25039761949442050
    m_Localized: "Augmente les <style=\"Blue\">d\xE9g\xE2ts</style> subis de 100\_%."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 26428515930939392
    m_Localized: <smallcaps><style="Blue">Vol de vie</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 26428515956105216
    m_Localized: "La cr\xE9ature <style=\"Blue\">se soigne</style> d'un nombre de
      <style=\"Blue\">PV</style> \xE9gal aux <style=\"Blue\">d\xE9g\xE2ts</style>
      qu'elle inflige."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 37357454379524096
    m_Localized: <smallcaps><style="Blue">Semi-Vol de vie</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 37357454404689920
    m_Localized: "Quand cette cr\xE9ature attaque, elle se soigne d'un montant \xE9gal
      \xE0 la moiti\xE9 des <style=\"Blue\">d\xE9g\xE2ts</style> inflig\xE9s \xE0
      l'ennemi."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 27119552156516352
    m_Localized: <smallcaps><style="Blue">Attaques multiples permanentes</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 27119552181682176
    m_Localized: "Augmente de mani\xE8re permanente le nombre d'attaques par incr\xE9ment
      d'<smallcaps><style=\"Blue\">Attaques multiples</smallcaps></style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 37357454404689921
    m_Localized: <smallcaps><style="Blue">Forme d'ombre</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 37357454404689922
    m_Localized: "<style=\"Blue\">Redirige</style> les <style=\"Blue\">d\xE9g\xE2ts</style>
      subis vers l'alli\xE9 situ\xE9 <style=\"Blue\">juste derri\xE8re</style>. Subit
      tout de m\xEAme les effets d'\xE9tat."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 44573523078881280
    m_Localized: <smallcaps><style="Blue">Confusion</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 44573523099852800
    m_Localized: "Si cette cr\xE9ature <style=\"Blue\">attaque</style>, elle s'en
      prend \xE0 l'un de ses alli\xE9s <style=\"Blue\">au hasard</style> (ou \xE0
      elle-m\xEAme) plut\xF4t qu'\xE0 un Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 47868807976394752
    m_Localized: <smallcaps><style="Blue">Indestructible</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 47868808005754880
    m_Localized: "La cr\xE9ature est <style=\"Blue\">immunis\xE9e</style> contre
      les <style=\"Blue\">d\xE9g\xE2ts</style>. L'effet <style=\"Blue\">Indestructible</style>
      diminue de 1 par <style=\"Blue\">round</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 47868808005754881
    m_Localized: <smallcaps><style="Blue">Acide</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 47868808005754882
    m_Localized: "D\xE9but du round\_: inflige 1\_de <style=\"Blue\">d\xE9g\xE2ts</style>
      par incr\xE9ment d'<smallcaps><style=\"Blue\">Acide</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 54352449930076160
    m_Localized: <smallcaps><style="Blue">Charge draconique</style></smallcaps>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
  - m_Id: 54352449955241984
    m_Localized: "\xC0 5\_Charges draconiques, transformation en Forme de dragon
      jusqu'\xE0 la fin du round.\nForme de dragon\_: +5 en <style=\"Blue\">Force</style>,
      +20\_<style=\"Blue\">boucliers</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654819
