%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Quests_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 7da6eead7207e9142bcf8d54df453f90, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8099901647879405568
  m_TableData:
  - m_Id: 4674111479809
    m_Localized: "Tr\xE1i Tim M\xF9a \u0110\xF4ng \xE0? C\u1EADu nghe \u0111\u01B0\u1EE3c
      chuy\u1EC7n \u0111\xF3 \u1EDF \u0111\xE2u v\u1EADy?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479808
    m_Localized: "<i>Iceling nh\u1EA3y c\u1EABng l\xEAn \u0111\u1EA7y ph\u1EA5n kh\xEDch
      ngay khi v\u1EEBa tr\xF4ng th\u1EA5y b\u1EA1n.</i><br><br><wave>Liiiiing!</wave>
      Ling Ling?<br><br><i>C\u1EADu ta b\u1EAFt \u0111\u1EA7u khua ch\xE2n m\xFAa
      tay d\u1EEF d\u1ED9i, r\xF5 r\xE0ng \u0111ang c\u1ED1 n\xF3i v\u1EDBi b\u1EA1n
      \u0111i\u1EC1u g\xEC \u0111\xF3 r\u1EA5t quan tr\u1ECDng.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479810
    m_Localized: "<i>Tr\xE1i Tim M\xF9a \u0110\xF4ng l\xE0 vi\xEAn b\u1EA3o ng\u1ECDc
      huy\u1EC1n tho\u1EA1i ch\u1EE9a \u0111\u1EF1ng tinh t\xFAy thu\u1EA7n khi\u1EBFt
      nh\u1EA5t c\u1EE7a s\u1EE9c m\u1EA1nh nguy\xEAn t\u1ED1 b\u0103ng gi\xE1. <br><br>Ng\u01B0\u1EDDi
      ta \u0111\u1ED3n r\u1EB1ng c\u1ED5 v\u1EADt \u0111\u1EA7y quy\u1EC1n n\u0103ng
      \u1EA5y \u0111\xE3 th\u1EA5t l\u1EA1c t\u1EEB nhi\u1EC1u th\u1EBF k\u1EF7 tr\u01B0\u1EDBc...
      n\u1EBFu nh\u01B0 n\xF3 t\u1EEBng th\u1EF1c s\u1EF1 t\u1ED3n t\u1EA1i.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479811
    m_Localized: "<i>Ti\u1EBFp t\u1EE5c</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479812
    m_Localized: "Ling Ling! <br><br><i>Iceling b\u1EAFt \u0111\u1EA7u k\xE9o tay
      b\u1EA1n, ch\u1EC9 v\u1EC1 ph\xEDa khu r\u1EEBng.</i> <br><br><wave>LING! LING!</wave> "
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479813
    m_Localized: "T\u1EDB kh\xF4ng ngh\u0129 ch\xFAng ta s\u1EBD t\xECm \u0111\u01B0\u1EE3c
      c\u1ED5 v\u1EADt huy\u1EC1n tho\u1EA1i ngay sau v\u01B0\u1EDDn nh\xE0 \u0111\xE2u,
      nh\xF3c \xE0..."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479819
    m_Localized: "<bounce>LING LING!</bounce> <br><br><i>C\xF3 v\u1EBB \u0111\xE2y
      \u0111\xFAng l\xE0 th\u1EE9 Iceling h\u1EB1ng mong m\u1ECFi. B\u1EA1n \u0111\xE3
      c\xF3 th\u1EC3 th\u1EA5y Mystling n\xE0y r\u1EF1c s\xE1ng v\u1EDBi m\u1ED9t
      s\u1EE9c m\u1EA1nh ch\u01B0a t\u1EEBng th\u1EA5y \u1EDF c\u1EADu ta... ch\u01B0a
      k\u1EC3 c\xF2n r\u1EA1ng ng\u1EDDi ni\u1EC1m vui!</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 4674111479820
    m_Localized: "<i>Ti\u1EBFp t\u1EE5c</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1037743229444096
    m_Localized: "H\xE3y tr\u1EDF v\u1EC1 L\xE0ng \u0111\u1EC3 nh\u1EADn ph\u1EA7n
      th\u01B0\u1EDFng c\u1EE7a b\u1EA1n!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1037743258804224
    m_Localized: "Tr\xE1i Tim M\xF9a \u0110\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1037743258804225
    m_Localized: "T\xECm \u0111\u01B0\u1EE3c Tinh Th\u1EC3 B\u0103ng, t\u1EE9c Tr\xE1i
      Tim M\xF9a \u0110\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631225851904
    m_Localized: "H\u1EA1t Gi\u1ED1ng S\u1EE9c M\u1EA1nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823424
    m_Localized: "T\xECm 3 B\xF4ng Hoa"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823438
    m_Localized: "Chi\u1EBFc G\u1EADy M\u1EDBi C\u1EE7a Pinequeak"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823439
    m_Localized: "T\xECm m\u1ED9t chi\u1EBFc g\u1EADy m\u1EDBi cho Pinequeak"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823425
    m_Localized: "<i>B\u1EA1n b\u1EAFt g\u1EB7p Golomo \u0111ang t\u1EC9 m\u1EA9n
      x\u1EBFp m\u1ED9t \u0111\u1ED1ng g\u1EADy g\u1ED9c. R\u1ED3i c\u1EADu ta l\xF9i
      l\u1EA1i m\u1ED9t b\u01B0\u1EDBc, h\xEDt m\u1ED9t h\u01A1i th\u1EADt s\xE2u...</i><br><br>Gooo\u2013<wiggle>LOMO!</wiggle><br><br><i>\u0110\xF2n
      t\u1EA5n c\xF4ng d\u0169ng m\xE3nh c\u1EE7a sinh v\u1EADt \u1EA5y th\u1ED5i
      bay c\u1EA3 \u0111\u1ED1ng g\u1EADy, nh\u01B0ng... Golomo tr\xF4ng l\u1EA1i
      th\u1EA5t v\u1ECDng m\u1ED9t c\xE1ch l\u1EA1 l\xF9ng r\u1ED3i ng\u1ED3i ph\u1ECBch
      xu\u1ED1ng \u0111\u1EA5t, m\u1EB7t m\xE0y cau c\xF3.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823426
    m_Localized: "Sao l\u1EA1i bu\u1ED3n th\u1EBF, nh\xF3c? M\xE0n v\u1EEBa r\u1ED3i
      ho\xE0nh tr\xE1ng l\u1EAFm m\xE0!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823427
    m_Localized: "<shake>Golomo! GO. LO. MO!</shake> <br><br><i>C\u1EADu ta di\u1EC5n
      m\u1ED9t m\xE0n k\u1ECBch c\xE2m cu\u1ED1ng qu\xFDt: g\u1ED3ng c\u01A1 tay,
      r\u1ED3i nh\u0103n m\u1EB7t m\u1ED9t c\xE1ch qu\xE1 l\u1ED1. C\u1EADu c\u1EA7n
      ph\u1EA3i m\u1EA1nh h\u01A1n! <b>M\u1EA1nh h\u01A1n nhi\u1EC1u!</b><br><br>R\xF5
      r\xE0ng c\u1EADu ta b\u1EF1c b\u1ED9i v\xEC ph\u1EA3i gi\u1EA3i th\xEDch nh\u1EEFng
      \u0111i\u1EC1u c\u01A1 b\u1EA3n \u0111\u1EBFn th\u1EBF cho b\u1EA1n.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823428
    m_Localized: "C\u1EADu mu\u1ED1n m\u1EA1nh h\u01A1n. Hi\u1EC3u r\u1ED3i. T\u1EDB
      gi\xFAp \u0111\u01B0\u1EE3c g\xEC kh\xF4ng?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823429
    m_Localized: "<bounce>Lomo LOMO!</bounce><br><br><i>C\u1EADu ta g\u1EADt \u0111\u1EA7u
      lia l\u1ECBa v\u1EDBi v\u1EBB m\u1EB7t nghi\xEAm ngh\u1ECB nh\u01B0 \u0111\xE1.<br><br><font=\"Rounded-Black
      SDF\">H\u1EA1t gi\u1ED1ng trong r\u1EEBng. Ph\xE9p thu\u1EADt \u0111\u1EA5t.</font>
      \u0110\xF3 l\xE0 t\u1EA5t c\u1EA3 nh\u1EEFng g\xEC b\u1EA1n hi\u1EC3u \u0111\u01B0\u1EE3c
      t\u1EEB tr\xE0ng l\u1EA3m nh\u1EA3m k\xEDch \u0111\u1ED9ng c\u1EE7a c\u1EADu.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823430
    m_Localized: "\u0110\u01B0\u1EE3c th\xF4i, v\u1EADy t\u1EDB \u0111i t\xECm ngay
      \u0111\xE2y!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823436
    m_Localized: "<i>C\u1EADu ta li\u1EBFc nh\xECn \u0111\xE1m h\u1EA1t gi\u1ED1ng
      m\u1ED9t tho\xE1ng... r\u1ED3i v\u1ED9i v\xE0ng nh\xE9t t\u1EA5t t\u1EA7n t\u1EADt
      v\xE0o m\u1ED3m. <br><br>B\u1EA1n nghe th\u1EA5y ti\u1EBFng \xF9ng \u1EE5c
      tr\u1EA7m \u0111\u1EE5c v\u1ECDng l\xEAn t\u1EEB \u0111\xE1y b\u1EE5ng c\u1EADu,
      trong khi ng\u1ECDn l\u1EEDa trong m\u1EAFt c\u1EADu b\xF9ng l\xEAn s\xE1ng
      \u0111\u1EBFn ch\xF3i l\xF2a.</i><br><br>Go.. Lo... <shake>MOOOOO!</shake>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823437
    m_Localized: "Ch\xE0, \u0111\xFAng l\xE0 th\u1EE9 m\u1EA1nh th\u1EADt \u0111\u1EA5y,
      nh\xF3c \xE0!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823440
    m_Localized: "<i>Ch\xFA Pinequeak c\u1EE7a b\u1EA1n lao th\u1EB3ng v\u1EC1 ph\xEDa
      b\u1EA1n, <shake><b>gi\u1EADn s\xF4i m\xE1u</b></shake>. Tr\xF4ng c\u1EADu
      ta d\u1EEF d\u1ED9i th\u1EADt s\u1EF1, ngay c\u1EA3 v\u1EDBi ti\xEAu chu\u1EA9n
      c\u1EE7a m\u1ED9t Pinequeak.</i><br><br>Queek <shake>QUEEEEEK!</shake>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823441
    m_Localized: "Chuy\u1EC7n g\xEC l\xE0m c\u1EADu \u0111i\xEAn ti\u1EBFt th\u1EBF,
      qu\u1EA3 th\xF4ng b\xE9 nh\u1ECF?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823442
    m_Localized: "<i>Pinequeak nheo m\u1EAFt nh\xECn b\u1EA1n \u0111\u1EA7y b\u1EF1c
      d\u1ECDc.<br><br>C\u1EADu ta t\u1EEB t\u1EEB gi\u01A1 chi\u1EBFc g\u1EADy l\xEAn,
      ch\u1EC9 v\xE0o n\xF3, r\u1ED3i k\xEAu</i> <wave>\"Blah!\"</wave><i> ra v\u1EBB
      bu\u1ED3n n\xF4n.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823443
    m_Localized: "C\u1EADu kh\xF4ng th\xEDch chi\u1EBFc g\u1EADy c\u1EE7a m\xECnh
      n\u1EEFa \xE0?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823444
    m_Localized: "<i>C\u1EADu ta nheo m\u1EAFt l\u1EA1i c\xF2n d\u1EEF h\u01A1n,
      nh\u1EA5n m\u1EA1nh r\u1EB1ng c\u1EADu gh\xE9t n\xF3 \u0111\u1EBFn <b>m\u1EE9c
      n\xE0o</b>.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823445
    m_Localized: "\u0110\u01B0\u1EE3c r\u1ED3i, t\u1EDB s\u1EBD \u0111i t\xECm cho
      c\u1EADu chi\u1EBFc g\u1EADy x\u1ECBn h\u01A1n..."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823451
    m_Localized: "<i>Ngay khi b\u1EA1n k\u1ECBp nh\u1EADn ra r\u1EB1ng Pinequeak
      s\u1EBD ch\u1EB3ng s\u1EDBm \u0111\u1ECDc cho b\u1EA1n nghe b\xE0i di\u1EC5n
      v\u0103n c\u1EA3m t\u1EA1 n\xE0o \u0111\xE2u, c\u1EADu ta l\xE8 l\u01B0\u1EE1i
      th\u1ED5i ph\xEC m\u1ED9t c\xE1i r\u1ED3i \xF4m g\u1EADy ch\u1EA1y m\u1EA5t.<br><br>\u0110\u01B0\u1EE3c
      v\xE0i b\u01B0\u1EDBc, c\u1EADu d\u1EEBng l\u1EA1i, li\u1EBFc v\u1EC1 ph\xEDa
      b\u1EA1n v\xE0 ng\u01B0\u1EE3ng ngh\u1ECBu g\u1EADt \u0111\u1EA7u ra v\u1EBB
      ghi nh\u1EADn.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 1040631246823452
    m_Localized: "\xD4i... C\u1EADu ta v\u1EEBa su\xFDt... <i>c\u1EA3m \u01A1n m\xECnh</i>
      \u0111\u1EA5y \xE0? Ch\u1EAFc m\xECnh s\u1EAFp kh\xF3c m\u1EA5t..."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930710503424
    m_Localized: "B\u1EA1n b\u1EAFt g\u1EB7p m\u1ED9t ch\xFA Pinequeak l\u1EBB loi
      \u0111ang nh\xE0n nh\xE3 ngh\u1ECBch m\u1ED9t chi\u1EBFc g\u1EADy. \xD4i c\xE1c
      Th\u1EA7n R\u1ED3ng tr\xEAn cao - \u0111\xF3 \u0111\xFAng l\xE0 <font=\"Rounded-Black
      SDF\">m\u1ED9t chi\u1EBFc g\u1EADy c\u1EF1c \u0111\u1EC9nh.</font>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669248
    m_Localized: "C\u1EADu \u0111ang c\u1EA7m m\u1ED9t chi\u1EBFc g\u1EADy huy ho\xE0ng
      \u0111\u1EA5y, nh\xF3c \xE0."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669249
    m_Localized: "<bounce>Queek queek!</bounce><br><br><i>Ch\xFA Pinequeak ch\xECa
      chi\u1EBFc g\u1EADy ra cho b\u1EA1n v\u1EDBi n\u1EE5 c\u01B0\u1EDDi th\xE2n
      thi\u1EC7n. C\xF3 g\xEC \u0111\xF3 kh\xF4ng \u1ED5n...</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669250
    m_Localized: "<i>C\u1EA7m l\u1EA5y chi\u1EBFc g\u1EADy.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669251
    m_Localized: "<i>Ngay khi tay b\u1EA1n ch\u1EA1m v\xE0o chi\u1EBFc g\u1EADy,
      ti\u1EBFng l\xE1 x\xE0o x\u1EA1c vang l\xEAn t\u1EEB b\u1EE5i r\u1EADm ph\xEDa
      sau l\u01B0ng.<br><br>C\u1EA3 m\u1ED9t b\u1EA7y Pinequeak \u0111i\xEAn cu\u1ED3ng
      lao b\u1ED5 v\u1EC1 ph\xEDa b\u1EA1n \u2014 b\u1EA1n nh\u1EADn ra m\xECnh \u0111\xE3
      s\u1EADp b\u1EABy ph\u1EE5c k\xEDch.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669252
    m_Localized: "\u01A0 k\xECa... Sao m\xECnh l\u1EA1i d\u1EC5 b\u1ECB l\u1EEBa
      \u0111\u1EBFn v\u1EADy ch\u1EE9?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669253
    m_Localized: "<i>L\u0169 Pinequeak nh\xECn b\u1EA1n \u0111\u1EA7y k\xEDnh n\u1EC3
      trong l\xFAc c\u1ED1 l\u1EA5y l\u1EA1i h\u01A1i th\u1EDF.<br><br>B\u1EA1n \u0111\xE3
      ch\u1EE9ng minh m\xECnh x\u1EE9ng \u0111\xE1ng v\u1EDBi <font=\"Rounded-Black
      SDF\">Chi\u1EBFc G\u1EADy</font>.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669254
    m_Localized: "<i>C\u1EA7m l\u1EA5y Chi\u1EBFc G\u1EADy\u2122 (l\u1EA7n n\xE0y
      l\xE0 th\u1EADt).</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669255
    m_Localized: "L\u0169 Pinequeak nh\xECn b\u1EA1n \u0111\u1EA7y khinh mi\u1EC7t.
      R\xF5 r\xE0ng b\u1EA1n kh\xF4ng x\u1EE9ng v\u1EDBi Chi\u1EBFc G\u1EADy."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2558930735669256
    m_Localized: "Gi\u1EEF l\u1EA5y c\xE1i g\u1EADy ngu ng\u1ED1c c\u1EE7a c\xE1c
      ng\u01B0\u1EDDi \u0111i. Mu\u1ED1n <i>c\u1EAFm</i> v\xE0o \u0111\xE2u th\xEC
      c\u1EAFm."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563712
    m_Localized: "<i>Iceling b\u1EADt d\u1EADy ngay khi v\u1EEBa tr\xF4ng th\u1EA5y
      b\u1EA1n.</i> <br><br><wave>Ling?</wave>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563713
    m_Localized: "T\u1EDB t\xECm \u0111\u01B0\u1EE3c c\xE1i n\xE0y cho c\u1EADu.
      C\xF3 th\u1EC3 n\xF3 kh\xF4ng ph\u1EA3i Tr\xE1i Tim M\xF9a \u0110\xF4ng, nh\u01B0ng
      v\u1EABn to\xE1t ra s\u1EE9c m\u1EA1nh \u0111\xE1ng n\u1EC3 l\u1EAFm."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563714
    m_Localized: Ling ling... <shake>LING</shake> ling!
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563715
    m_Localized: "T\u1EDB v\u1EABn \u0111ang t\xECm m\xE0, th\u1EADt \u0111\u1EA5y!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563716
    m_Localized: "<i>Sinh v\u1EADt \u1EA5y g\u1EADt \u0111\u1EA7u ra v\u1EBB th\u1EA5u
      hi\u1EC3u, bi\u1EBFt r\u1EB1ng b\u1EA1n c\xF2n nhi\u1EC1u vi\u1EC7c quan tr\u1ECDng
      h\u01A1n ph\u1EA3i lo.<br><br>C\xF3 \u0111i\u1EC1u c\u1EADu ta ch\u1EB3ng gi\u1ECFi
      gi\u1EA5u n\u1ED7i th\u1EA5t v\u1ECDng c\u1EE7a m\xECnh cho l\u1EAFm...</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563717
    m_Localized: "T\u1EDB s\u1EBD kh\xF4ng l\xE0m c\u1EADu th\u1EA5t v\u1ECDng \u0111\xE2u,
      t\u1EDB h\u1EE9a \u0111\u1EA5y."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563718
    m_Localized: "<i>B\u1EA1n v\u1ED7 vai Golomo v\xE0 ch\xECa cho c\u1EADu ta xem
      \u0111\xE1m h\u1EA1t gi\u1ED1ng m\xECnh t\xECm \u0111\u01B0\u1EE3c.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563719
    m_Localized: "\u0110\xFAng lo\u1EA1i n\xE0y kh\xF4ng?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563720
    m_Localized: "Go...<wiggle>LOMO!</wiggle> <br><br><i>B\u1EA1n th\u1EA5y Golomo
      nghi\u1EC1n n\xE1t th\xEAm m\u1ED9t \u0111\u1ED1ng g\u1EADy n\u1EEFa, r\u1ED3i
      l\u1EAFc \u0111\u1EA7u th\u1EA5t v\u1ECDng v\xE0 quay l\u1EA1i x\u1EBFp \u0111\u1ED1ng
      m\u1EDBi. Xem ra vi\u1EC7c r\xE8n luy\u1EC7n c\u1EE7a c\u1EADu ta ch\u1EB3ng
      su\xF4n s\u1EBB ch\xFAt n\xE0o n\u1EBFu thi\u1EBFu m\u1EA5y h\u1EA1t gi\u1ED1ng
      kia...</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563721
    m_Localized: "T\u1EDB s\u1EBD l\u1EA5y ch\xFAng v\u1EC1 cho c\u1EADu.<br>Ch\u1EC9
      c\u1EA7n \u0111\u1EEBng l\xE0m m\xECnh b\u1ECB th\u01B0\u01A1ng, \u0111\u01B0\u1EE3c
      ch\u1EE9?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563722
    m_Localized: "<i>Golomo li\u1EBFc x\xE9o b\u1EA1n \u0111\u1EA7y ho\xE0i nghi,
      r\u1ED3i quay l\u1EA1i v\u1EDBi \u0111\xE1m g\u1EADy c\u1EE7a m\xECnh, m\u1EB7t
      m\xE0y chua nh\u01B0 gi\u1EA5m.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563723
    m_Localized: "T\u1EDB s\u1EBD l\u1EA5y \u0111\u01B0\u1EE3c m\xE0! Ngo\xE9o tay
      h\u1EE9a \u0111\u1EA5y!<br><size=75%><i>M\xE0 c\u1EADu ta c\xF3 ng\xF3n \xFAt
      kh\xF4ng nh\u1EC9?</i></size>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563724
    m_Localized: "<i>Pinequeak nh\xECn th\u1EA5y chi\u1EBFc g\u1EADy b\u1EA1n \u0111ang
      c\u1EA7m t\u1EEB r\u1EA5t l\xE2u tr\u01B0\u1EDBc khi nh\xECn th\u1EA5y b\u1EA1n.
      \u0110\xF3 l\xE0 chi\u1EBFc g\u1EADy ng\u1EA7u nh\u1EA5t c\u1EADu ta t\u1EEBng
      th\u1EA5y!<br><br>C\u1EADu lao v\u1EE5t v\u1EC1 ph\xEDa b\u1EA1n, h\xFAc v\u0103ng
      b\u1EA5t c\u1EE9 ai v\xF4 t\xECnh c\u1EA3n \u0111\u01B0\u1EDDng, r\u1ED3i nh\u1EA3y
      l\xEAn gi\u1EADt ph\u0103ng n\xF3 kh\u1ECFi tay b\u1EA1n.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563725
    m_Localized: "\xCA n\xE0y! Ng\u01B0\u1EDDi ta t\u1EB7ng qu\xE0 th\xEC ph\u1EA3i
      n\xF3i g\xEC n\xE0o?"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563726
    m_Localized: "<i>Pinequeak nh\xECn b\u1EA1n \u0111\u1EA7y mong \u0111\u1EE3i.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563727
    m_Localized: "Xin l\u1ED7i nh\xE9, t\u1EDB v\u1EABn ch\u01B0a t\xECm \u0111\u01B0\u1EE3c
      chi\u1EBFc g\u1EADy n\xE0o \u0111\u1EE7 x\u1ECBn."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563728
    m_Localized: "<i>Nghe v\u1EADy, m\u1EB7t c\u1EADu ta x\u1ECB xu\u1ED1ng ngay
      l\u1EADp t\u1EE9c r\u1ED3i b\u1ECF \u0111i, l\u1EA7m b\u1EA7m m\u1ED9t m\xECnh
      v\xE0 m\u1EAFng chi\u1EBFc g\u1EADy c\u0169 v\xEC t\u1ED9i x\u1EA5u x\xED.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 2579197784563729
    m_Localized: "N\xF3i chuy\u1EC7n v\u1EDBi c\u1EADu l\xFAc n\xE0o c\u0169ng vui
      gh\xEA..."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 3633746967789568
    m_Localized: "LING <b><shake>LING!</shake></b><br><br><i>C\u1EADu ta gi\u1EADm
      ch\xE2n m\u1ED9t c\xE1i \u0111\u1EC3 nh\u1EA5n m\u1EA1nh \xFD m\xECnh.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 3633746980372480
    m_Localized: "\u0110\u01B0\u1EE3c, \u0111\u01B0\u1EE3c - t\u1EDB s\u1EBD \u0111i
      t\xECm. Nh\u01B0ng kh\xF4ng h\u1EE9a tr\u01B0\u1EDBc \u0111\xE2u \u0111\u1EA5y!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 3633746980372481
    m_Localized: "Goooolomo... :)<br><br><i>C\u1EADu ta \xF4m b\u1EA1n m\u1ED9t c\xE1i
      th\u1EADt ch\u1EB7t v\xE0 c\u1EE9ng ng\u1EAFc, r\u1ED3i quay l\u01B0ng tr\u1EDF
      l\u1EA1i v\u1EDBi \u0111\xE1m g\u1EADy c\u1EE7a m\xECnh. B\u1EA1n th\u1EA5y
      gi\u1EDD ch\xFAng \u0111\xE3 m\u1ECDc ra nh\u1EEFng chi\u1EBFc gai tr\xF4ng
      th\u1EADt \u0111\xE1ng s\u1EE3.</i>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
  - m_Id: 3633746980372482
    m_Localized: "M\u1EEBng l\xE0 ch\xFAng c\xF3 t\xE1c d\u1EE5ng!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405568
