%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Story_fr
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: fr
  m_SharedData: {fileID: 11400000, guid: ef7c34a5b6b91b74bbd4d9f8df67b47c, type: 2}
  m_Metadata:
    m_Items:
    - rid: 8829885829830410423
  m_TableData:
  - m_Id: 69984989718061056
    m_Localized: "L'\xC9clipse est l\xE0\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 69984989747421184
    m_Localized: "Pr\xE9pare-toi au pire, il est temps d'affronter tes plus grandes
      terreurs."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 69984989747421185
    m_Localized: "Je n'ai pas peur. Finissons-en\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341088931840
    m_Localized: "<i>Il semble y avoir un \xE9trange embouteillage sur la place principale.<br><br>Un
      Glarexus est assis en plein milieu, lan\xE7ant des regards noirs aux villageois
      qui le bousculent et perturbent sa m\xE9ditation.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341122486272
    m_Localized: "Tu ne crois pas que tu pourrais aller t'installer ailleurs\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341122486273
    m_Localized: "<i>Il vous foudroie \xE0 votre tour du regard et recommence \xE0
      m\xE9diter. \xC0 cet instant, vous remarquez qu'il est install\xE9 sur une
      splendide mosa\xEFque dont les carreaux repr\xE9sentent le soleil entour\xE9
      des deux lunes.<br><br>Se pourrait-il qu'il soit en train de prier, pr\xE9occup\xE9
      par l'approche de l'\xC9clipse\_?</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341122486274
    m_Localized: "Ne t'inqui\xE8te pas, nous emp\xEAcherons l'\xC9clipse. Et tes
      pri\xE8res nous y aideront."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680576
    m_Localized: "<i>Vos paroles rassurantes ont l'effet souhait\xE9, et il se d\xE9tend
      l\xE9g\xE8rement.<br><br>Il se d\xE9place un peu, juste assez pour ne plus
      g\xEAner la circulation, et recommence \xE0 prier.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680577
    m_Localized: "Merci\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680578
    m_Localized: "<i>Vous voyez un Golomo \xE0 c\xF4t\xE9 d'une grosse pierre.<br><br>Il
      agite les bras en tous sens, sans quitter la roche du regard.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680579
    m_Localized: "Se pourrait-il qu'ils soient en train de... discuter, tous les
      deux\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680580
    m_Localized: "<i>Non seulement \xE7a, mais on dirait bien que le Golomo est en
      train de <font=\"Rounded-Black SDF\">draguer</font> le rocher, en fait\_!<br><br>Il
      est vrai que les Golomos sont autant connus pour leur nature sociable que pour
      leur tr\xE8s mauvaise vue...</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680581
    m_Localized: "Me permets-tu de parler \xE0 ta <i>dame</i> quelques instants\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680582
    m_Localized: "<i>Prenant la pierre, vous faites appel \xE0 tout votre sens artistique
      pour donner vie \xE0 \"Madame Golomo\".<br><br>Le Golomo est fou de joie quand
      il voit sa splendide promise\_! Il a l'air tr\xE8s amoureux\_!</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680583
    m_Localized: "Tous mes v\u0153ux de bonheur au jeune couple\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680584
    m_Localized: "<i>Du coin de l'\u0153il, vous remarquez qu'un Iceling vous suit
      comme votre ombre. Le regard riv\xE9 par terre, il semble essayer de trouver
      le courage de vous demander quelque chose.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680585
    m_Localized: "Qu'y a-t-il, bonhomme\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680586
    m_Localized: "<i>D'un geste de la t\xEAte, il vous montre timidement un gros
      bloc de glace,<br>\xE0 l'int\xE9rieur duquel se trouve une balle en cuir...
      l'un de ses jouets pr\xE9f\xE9r\xE9s.<br><br>Il a d\xFB la geler par accident
      en jouant avec.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680587
    m_Localized: "Ne t'inqui\xE8te pas, je sais quoi faire\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680588
    m_Localized: "<i>Prenant la boule gel\xE9e, vous l'amenez jusqu'\xE0 la cuisine
      et la posez \xE0 c\xF4t\xE9 de la marmite bouillonnante.<br><br>Bien vite,
      la chaleur du feu fait fondre la glace et l'Iceling est fou de joie en voyant
      sa balle lib\xE9r\xE9e de sa prison.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 68879341126680589
    m_Localized: "Tiens, amuse-toi\_! Et fais un peu plus attention, la prochaine
      fois\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770012102656
    m_Localized: "<i>Un cri d\xE9chirant vous perce les tympans et brise toutes les
      fen\xEAtres \xE0 la ronde. Le responsable\_? Un petit Pinequeak en train de
      pleurer.<br><br>Vous n'avez pas d'autre choix que de vous \xE9poumoner pour
      tenter de vous faire entendre au milieu de ce vacarme.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770028879872
    m_Localized: "QU'EST-CE QUI T'ARRIVE, BONHOMME\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770028879873
    m_Localized: "<i>Le petit Pinequeak tourne la t\xEAte vers vous et cesse instantan\xE9ment
      de crier.<br><br>Il vous regarde droit dans les yeux et son expression change
      aussit\xF4t...</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770028879874
    m_Localized: Oh-ho...
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770028879875
    m_Localized: "<i>Avec un sourire plein de malice, il vous lance une bombe \xE0
      crottes en plein visage et \xE9clate de rire.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770028879876
    m_Localized: "Cette fois, tu as r\xE9ussi \xE0 m'avoir, petit monstre\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 69947439804055552
    m_Localized: Iceling
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 69947439816638464
    m_Localized: Golomo
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 69947439816638465
    m_Localized: Glarexus
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 81528770028879877
    m_Localized: Pinequeak
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132052172800
    m_Localized: Eftus
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950016
    m_Localized: Prowler
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950017
    m_Localized: Frogmar
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950018
    m_Localized: Fale
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950019
    m_Localized: Bolb
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950020
    m_Localized: "<i>Cet Eftus se retient difficilement de pleurer. Vous ne l'avez
      jamais vu dans un tel \xE9tat.<br><br>Il a une canne \xE0 p\xEAche cass\xE9e
      entre les mains.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950021
    m_Localized: "Oh, non\_! Qu'est-ce qui t'est arriv\xE9\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950022
    m_Localized: "<i>Il tend le bras en direction d'un Pinequeak qui se trouve sur
      le terrain d'entra\xEEnement.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950023
    m_Localized: "Encore eux\_? Ne t'inqui\xE8te pas, je vais te trouver une nouvelle
      canne \xE0 p\xEAche\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950024
    m_Localized: "<i>La canne \xE0 p\xEAche de votre jeunesse doit encore se trouver
      quelque part sous votre tente. Elle n'a rien de sp\xE9cial, mais elle est con\xE7ue
      pour p\xEAcher sous la glace. Et elle n'est pas tr\xE8s grande, elle devrait
      donc \xEAtre parfaite pour les petites mains de l'Eftus\_!</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950025
    m_Localized: "Tiens, j'esp\xE8re qu'elle te plaira\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950026
    m_Localized: "<i>Le regard de l'Eftus s'illumine d'un seul coup.<br><br>D\xE8s
      qu'il prend la canne, vous cessez d'exister pour lui.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950027
    m_Localized: "Bon, ben... amuse-toi bien, alors\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950028
    m_Localized: <i>Ce Prowler vous regarde avec ses grands yeux expressifs.</i>
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950029
    m_Localized: Oh, non...
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950030
    m_Localized: "<i>Vous vous sentez incapable de r\xE9sister \xE0 son regard craquant.<br><br>Et
      vous \xE9prouvez soudain le besoin irr\xE9pressible de lui donner quelque chose
      qui brille.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950031
    m_Localized: Dois... donner... brillant...
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950032
    m_Localized: "<i>D\xE8s que vous lui donnez une babiole luisante, le sort qui
      vous hypnotisait cesse de faire effet et le Prowler s'enfuit avec son butin.<br><br>Vous
      le suivez et il finit par vous amener \xE0 un v\xE9ritable tr\xE9sor brillant
      de mille feux.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950033
    m_Localized: "C'est donc l\xE0 que se trouve tout mon or qui avait disparu\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950034
    m_Localized: "<i>Les Frogmars s'occupent g\xE9n\xE9ralement des fours du village,
      les rallumant \xE0 l'aide de leur souffle br\xFBlant d\xE8s qu'ils font mine
      de s'\xE9teindre, mais celui-ci semble avoir un probl\xE8me.<br><br>Les braises
      sont mourantes et le pauvre Frogmar n'arrive pas \xE0 les rallumer...</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950035
    m_Localized: "Tout va bien\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950036
    m_Localized: "<i>Il ne vous r\xE9pond pas, tout occup\xE9 qu'il est \xE0 essayer
      de souffler sur le charbon de bois. Mais il a la respiration sifflante et il
      ne parvient plus \xE0 cracher de flammes.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950037
    m_Localized: "Je crois savoir quel est le probl\xE8me..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950038
    m_Localized: "<i>Vous lui envoyez plusieurs boulettes de charbon de bois, qu'il
      croque avec joie.<br><br>D\xE8s qu'il a le ventre plein, il inspire profond\xE9ment
      et souffle une grande gerbe de flammes qui rallument instantan\xE9ment les
      braises\_!</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950039
    m_Localized: "Il faut toujours manger avant de se mettre au travail, tu sais\_!
      Le petit-d\xE9jeuner, c'est le repas le plus important de la journ\xE9e\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950040
    m_Localized: "<i>Alors que vous vous promenez sur la jet\xE9e, de l'eau vous
      \xE9clabousse soudain le visage et vous voyez un Fale nageant tout pr\xE8s
      qui vous observe, guettant votre r\xE9action.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950041
    m_Localized: "Alors, c'est comme \xE7a que tu veux la jouer, hein\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950042
    m_Localized: "<i>Il batifole \xE0 la surface, tout heureux d'avoir enfin trouv\xE9
      quelqu'un qui accepte de s'amuser avec lui\_!</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950043
    m_Localized: "C'est le moment de faire des vagues... au sens propre\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950044
    m_Localized: "<i>Vous \xE9claboussez le Fale, qui pousse un grand cri de joie.
      Et, bien vite, vous vous livrez \xE0 une grande bataille d'eau qui trempe totalement
      la jet\xE9e. Quand vous arr\xEAtez enfin, le souffle court, vous \xE9clatez
      tous les deux de rire, hilares.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950045
    m_Localized: "Merci, mon pote\_! On s'est bien marr\xE9s\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950046
    m_Localized: "<i>Vous sentez le sol trembler alors que vous approchez de la silhouette
      imposante au centre de la place. Ce Bolb saute en tous sens en tentant de jouer
      des maracas, mais il n'a clairement pas la coordination n\xE9cessaire pour
      arriver \xE0 faire ce qu'il veut.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950047
    m_Localized: "Tu voudrais danser, mon grand\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950048
    m_Localized: "<i>Il tourne la t\xEAte vers vous et vous met d'office les maracas
      dans les mains, tout en vous suppliant du regard de l'aider.</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950049
    m_Localized: "Tu veux que je joue de la musique pour toi\_? D'accord, allons-y\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950050
    m_Localized: "<i>Vous secouez les maracas et le Bolb se met \xE0 danser en cadence.
      Qui e\xFBt cru qu'il avait autant d'\xE9nergie\_? Esp\xE9rons que le sol en
      mosa\xEFque y survivra\_!</i>"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 77944132068950051
    m_Localized: "En avant les secousses\_!"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312693272576
    m_Localized: "Puis-je avoir ton attention\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855488
    m_Localized: "Oui\_? C'est \xE0 quel sujet\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855489
    m_Localized: "La d\xE9termination que tu montres \xE0 prot\xE9ger notre village
      est digne d'\xE9loges, mais h\xE9las, j'ai bien peur que m\xEAme le choix du
      Dragon Gardien ne suffise pas \xE0 nous sauver des implications de l'\xC9clipse..."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855490
    m_Localized: "Pouvez-vous me dire ce que c'est que cette \xC9clipse, au juste\_?"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855491
    m_Localized: "Vois-tu, il y a bien longtemps, nous partagions notre monde avec
      des \xEAtres appel\xE9s cr\xE9atures f\xE9\xE9riques, et nous vivions en harmonie.
      Leur ma\xEEtrise des arts magiques \xE9tait sans pareille, mais un jour, nous
      ignorons comment... ils ont ouvert une faille \xE0 destination d'un autre monde.
      Un monde qui n'avait rien d'amical."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855492
    m_Localized: "Le passage a finalement \xE9t\xE9 referm\xE9 gr\xE2ce au sacrifice
      des Dragons Gardiens, mais il en est rest\xE9 quelque chose. La lune du Royaume
      des Ombres, comme nous l'appelons, est depuis visible dans notre ciel.<br>Et
      tous les mille ans, lorsque les deux lunes \xE9clipsent notre soleil, le portail
      \xE0 destination du Royaume des Ombres s'ouvre de nouveau."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855493
    m_Localized: Sauf qu'aujourd'hui, les Dragons Gardiens ne sont plus.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855494
    m_Localized: "C'est pour cela que je suis oblig\xE9 de te demander... de te supplier
      de consentir un autre sacrifice pour notre village et le reste du monde."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855495
    m_Localized: "Terrasse la cr\xE9ature qui garde le portail et, une fois \xE0
      l'int\xE9rieur du Royaume des Ombres, localise ce qui envoie ces monstres dans
      notre monde."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  - m_Id: 80485312705855496
    m_Localized: "Tout ce que tu as accompli jusque-l\xE0 me donne l'espoir que tes
      intr\xE9pides Mystlings et toi serez capables d'arr\xEAter l'\xC9clipse."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410423
  references:
    version: 2
    RefIds:
