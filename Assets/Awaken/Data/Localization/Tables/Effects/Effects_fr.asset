  m_TableData:
  - m_Id: 1054703992832
    m_Localized: <style="Blue">Activer</style>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1106876940288
    m_Localized: "D\xE9clenche la capacit\xE9 d'activation du Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1137247895552
    m_Localized: "<style=\"Blue\">\xC9tourdissement</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1167065202688
    m_Localized: "La cr\xE9ature est incapable d'agir pendant 1 {Effect0.ValueInt}\_round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1203266240512
    m_Localized: <style="Blue">Blessure</style>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1233293262848
    m_Localized: "Type de <style=\"Blue\">d\xE9g\xE2ts</style> ignorant les boucliers."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1349962022912
    m_Localized: Action ultime
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1396862730240
    m_Localized: "Action sp\xE9ciale particuli\xE8rement puissante de l'ennemi."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 12301384671113216
    m_Localized: <style="Blue">Invocation</style>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 12301419358007296
    m_Localized: Appelle des compagnons qui rejoignent le champ de bataille.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1266516344832
    m_Localized: Exclure l'expiration
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 1311223431168
    m_Localized: 'Turns off chosen expiration of the status. '
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 71045737244336128
    m_Localized: "<style=\"Blue\">\u05A5\xC9vanoui</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 71045737273696256
    m_Localized: "Une cr\xE9ature \xE9vanouie ne peut plus prendre part au combat
      tant qu'elle n'a pas \xE9t\xE9 ranim\xE9e (notez que certaines cr\xE9atures
      sont instantan\xE9ment ranim\xE9es en cas d'\xE9vanouissement\_; il est donc
      possible que vous ne vous rendiez m\xEAme pas compte qu'elles se sont \xE9vanouies)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 55757007826788352
    m_Localized: Buff
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 55757007851954176
    m_Localized: "D\xE9buff"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 55757007851954177
    m_Localized: "\xC9tourdissement"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 55757007851954178
    m_Localized: Activation
    m_Metadata:
