  - m_Id: 59806798797979648
    m_Localized: "Accumulation\_!"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84836185721085952
    m_Localized: "Enchantement de l'ar\xE8ne"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84844454871113728
    m_Localized: "D\xE9but du round\_: conf\xE8re {Effect0.ValueInt}\_<style=\"Blue\">boucliers</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 85091811579731968
    m_Localized: "D\xE9but du round\_: conf\xE8re {Effect0.ValueInt}\_en <style=\"Blue\">Force</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84844454871113730
    m_Localized: "D\xE9but du round\_: inflige {Effect0.ValueInt}\_x\_<style=\"Blue\">Vuln\xE9rabilit\xE9</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84844454871113731
    m_Localized: "R\xE9duit tous les <style=\"Blue\">d\xE9g\xE2ts</style> subis de
      {Effect0.ValueInt} tant que la cr\xE9ature reste dans cette position."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84844454871113732
    m_Localized: "D\xE9but du round\_: soigne\_{Effect0.ValueInt}\_<style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84844454871113733
    m_Localized: "Augmente la Puissance de {Effect0.ValueInt} tant que le Mystling
      reste \xE0 cette position.<br>D\xE9but du round\_: subit {Effect1.ValueInt}\_de
      <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 85478340458258432
    m_Localized: "Augmente la Puissance de {Effect0.ValueInt} tant que le Mystling
      reste \xE0 cette position.<br>D\xE9but du round\_: subit {Effect1.ValueInt}
      de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654794
  - m_Id: 84844454871113734
    m_Localized: "Fin du round\_: <style=\"Blue\">activation</style>."
