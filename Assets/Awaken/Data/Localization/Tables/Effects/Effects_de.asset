      m_Items:
      - rid: 2105433060097654795
  - m_Id: 1167065202688
    m_Localized: "Die n\xE4chste Aktion wird um {Effect0.ValueInt} Runde verz\xF6gert."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654795
  - m_Id: 1203266240512
    m_Localized: <style="Blue">Verwunden</style>
    m_Metadata:
      m_Items:
      - rid: 2105433060097654795
  - m_Id: 1233293262848
    m_Localized: Dieser Schadenstyp ignoriert Schilde.
