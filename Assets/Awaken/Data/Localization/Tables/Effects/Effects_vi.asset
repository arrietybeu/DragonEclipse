  m_TableData:
  - m_Id: 1054703992832
    m_Localized: "<style=\"Blue\">K\xEDch Ho\u1EA1t</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1137247895552
    m_Localized: "<style=\"Blue\">Cho\xE1ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1203266240512
    m_Localized: "<style=\"Blue\">Th\u01B0\u01A1ng T\xEDch</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1266516344832
    m_Localized: "Lo\u1EA1i Tr\u1EEB H\u1EBFt H\u1EA1n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1349962022912
    m_Localized: "H\xE0nh \u0110\u1ED9ng T\u1ED1i Th\u01B0\u1EE3ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1106876940288
    m_Localized: "K\xEDch ho\u1EA1t K\u1EF9 n\u0103ng K\xEDch Ho\u1EA1t c\u1EE7a
      Mystling"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1167065202688
    m_Localized: "H\xE0nh \u0111\u1ED9ng s\u1EAFp t\u1EDBi b\u1ECB tr\xEC ho\xE3n
      {Effect0.ValueInt} V\xF2ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1233293262848
    m_Localized: "Lo\u1EA1i s\xE1t th\u01B0\u01A1ng b\u1ECF qua Khi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1311223431168
    m_Localized: "T\u1EAFt \u0111i\u1EC1u ki\u1EC7n h\u1EBFt h\u1EA1n \u0111\xE3
      ch\u1ECDn c\u1EE7a tr\u1EA1ng th\xE1i. "
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 1396862730240
    m_Localized: "H\xE0nh \u0111\u1ED9ng \u0111\u1EB7c bi\u1EC7t m\u1EA1nh m\u1EBD
      c\u1EE7a k\u1EBB \u0111\u1ECBch"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 12301384671113216
    m_Localized: "<style=\"Blue\">Tri\u1EC7u H\u1ED3i</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 12301419358007296
    m_Localized: "Tri\u1EC7u h\u1ED3i \u0111\u1ED3ng \u0111\u1ED9i ra chi\u1EBFn
      tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 55757007826788352
    m_Localized: "T\u0103ng C\u01B0\u1EDDng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 55757007851954176
    m_Localized: "Suy Y\u1EBFu"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 55757007851954177
    m_Localized: "Cho\xE1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 55757007851954178
    m_Localized: "K\xEDch ho\u1EA1t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 55757007851954179
    m_Localized: "T\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 59806798797979648
    m_Localized: "T\xEDch L\u0169y!"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 71045737244336128
    m_Localized: "<style=\"Blue\">Ng\u1EA5t</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 71045737273696256
    m_Localized: "Sinh v\u1EADt b\u1ECB ng\u1EA5t kh\xF4ng tham gia Tr\u1EADn \u0111\u1EA5u
      cho \u0111\u1EBFn khi \u0111\u01B0\u1EE3c h\u1ED3i sinh (sinh v\u1EADt b\u1ECB
      ng\u1EA5t r\u1ED3i \u0111\u01B0\u1EE3c h\u1ED3i sinh ngay l\u1EADp t\u1EE9c
      c\u0169ng k\xEDch ho\u1EA1t Ng\u1EA5t)"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84836185721085952
    m_Localized: "Ph\xF9 Ph\xE9p \u0110\u1EA5u Tr\u01B0\u1EDDng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113728
    m_Localized: "\u0110\u1EA7u V\xF2ng: \xC1p {Effect0.ValueInt} <style=\"Blue\">Khi\xEAn</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113730
    m_Localized: "\u0110\u1EA7u V\xF2ng: \xC1p {Effect0.ValueInt} <style=\"Blue\">Mong
      Manh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113731
    m_Localized: "Gi\u1EA3m {Effect0.ValueInt} m\u1ECDi s\xE1t th\u01B0\u01A1ng nh\u1EADn
      v\xE0o khi \u0111\u1EE9ng \u1EDF V\u1ECB Tr\xED n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113732
    m_Localized: "\u0110\u1EA7u V\xF2ng: H\u1ED3i {Effect0.ValueInt} M\xE1u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113733
    m_Localized: "T\u0103ng {Effect0.ValueInt} S\u1EE9c m\u1EA1nh khi \u0111\u1EE9ng
      \u1EDF V\u1ECB Tr\xED n\xE0y.<br>\u0110\u1EA7u V\xF2ng: Nh\u1EADn {Effect1.ValueInt}
      s\xE1t th\u01B0\u01A1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113734
    m_Localized: "Cu\u1ED1i V\xF2ng: <style=\"Blue\">K\xEDch Ho\u1EA1t</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 84844454871113735
    m_Localized: "\u0110\u1EA7u V\xF2ng: Nh\u1EADn {Effect0.ValueInt} s\xE1t th\u01B0\u01A1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 85091811579731968
    m_Localized: "\u0110\u1EA7u V\xF2ng: \xC1p {Effect0.ValueInt} <style=\"Blue\">C\u01B0\u1EDDng
      L\u1EF1c</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 85478340458258432
    m_Localized: "T\u0103ng {Effect0.ValueInt} S\u1EE9c m\u1EA1nh khi \u0111\u1EE9ng
      \u1EDF V\u1ECB Tr\xED n\xE0y.<br>\u0110\u1EA7u V\xF2ng: Nh\u1EADn {Effect1.ValueInt}
      s\xE1t th\u01B0\u01A1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 97530737351184384
    m_Localized: "\u0110\xE3 ch\u1EB7n {StatusName}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 113733529649422336
    m_Localized: "N\xE9 Tr\xE1nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405573
  - m_Id: 113733529682976768
    m_Localized: "Ngh\u1EC9 Ng\u01A1i"
