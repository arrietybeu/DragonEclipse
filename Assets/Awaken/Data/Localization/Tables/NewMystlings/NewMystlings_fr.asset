  m_TableData:
  - m_Id: 5776446886887424
    m_Localized: Pinequeak
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053248
    m_Localized: "Pinequeak exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053249
    m_Localized: "Naturellement malicieux, les Pinequeaks ont le regard noir et toujours
      un sale tour dans leur manche. Leur mauvaise r\xE9putation est parfaitement
      justifi\xE9e. On leur donne parfois d'autres noms dans d'autres villes, Pulpins
      et Firples \xE9tant les plus courants."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053250
    m_Localized: "<style=\"Blue\">Attaque</style> un ennemi au hasard \xE0 {Effect0.Attack.PowerModifier}\_%
      de <style=\"Blue\">Puissance</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053251
    m_Localized: "Quand Pinequeak est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>\_:
      ajoutez la carte <style=\"Blue\">{Effect0.ValueString}</style> \xE0 votre main."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053252
    m_Localized: "Quand Pinequeak est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>\_:
      ajoutez deux exemplaires non am\xE9lior\xE9s de la carte <style=\"Blue\">{Effect0.ValueString}</style>
      \xE0 votre main."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053253
    m_Localized: "Quand Pinequeak est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>\_:
      ajoutez la carte <style=\"Blue\">{Effect0.ValueString}</style> \xE0 votre main."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053255
    m_Localized: "Quand Pinequeak est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>\_:
      ajoutez deux exemplaires non am\xE9lior\xE9s de la carte <style=\"Blue\">{Effect0.ValueString}</style>
      \xE0 votre main."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053256
    m_Localized: "Augmente la <style=\"Blue\">sant\xE9</style> pour la faire passer
      \xE0 {Mystling.Health}."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12276047190016000
    m_Localized: "Augmente la <style=\"Blue\">Puissance</style> pour la faire passer
      \xE0 {Mystling.Power}."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053258
    m_Localized: Iceling
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053259
    m_Localized: "Iceling exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053260
    m_Localized: "Les Icelings vivent g\xE9n\xE9ralement en reclus, mais certains
      peuvent faire preuve d'une grande curiosit\xE9 qui les pousse \xE0 quitter
      leurs montagnes enneig\xE9es. Ceux-l\xE0 sont g\xE9n\xE9ralement extravertis
      et tr\xE8s courageux."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053261
    m_Localized: "Iceling conf\xE8re {Effect0.ValueInt} en <smallcaps><style=\"Blue\">Force</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style> (peut \xEAtre lui-m\xEAme)."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053262
    m_Localized: "Iceling gagne un surcro\xEEt de <style=\"Blue\">Puissance</style>
      \xE9gal au <style=\"Blue\">nombre de cartes</style> que vous avez en main."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053263
    m_Localized: "Iceling gagne un surcro\xEEt de <style=\"Blue\">Puissance</style>
      \xE9gal au <style=\"Blue\">nombre de cartes</style> que vous avez en main.\nD\xE9but
      du combat\_: <style=\"Blue\">piochez</style> {Effect0.ValueInt}\_cartes."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053264
    m_Localized: "Iceling gagne un surcro\xEEt de <style=\"Blue\">Puissance</style>
      \xE9gal au <style=\"Blue\">nombre de cartes</style> que vous avez en main.\nFin
      du round\_: double la <style=\"Blue\">Force</style> du Mystling en <style=\"Blue\">premi\xE8re
      ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12304182178594816
    m_Localized: "Iceling gagne un surcro\xEEt de <style=\"Blue\">Puissance</style>
      \xE9gal au <style=\"Blue\">nombre de cartes</style> que vous avez en main.\nD\xE9but
      du combat\_: <smallcaps><style=\"Blue\">\xE9tourdit</style></smallcaps>\_tous
      les ennemis."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053266
    m_Localized: "D\xE9but du combat\_: <style=\"Blue\">piochez</style> {Effect0.ValueInt}\_cartes."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053267
    m_Localized: "Fin du round\_: double la <smallcaps><style=\"Blue\">Force</style></smallcaps>
      du Mystling en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12304182178594817
    m_Localized: "D\xE9but du combat\_: <smallcaps><style=\"Blue\">\xE9tourdit</style></smallcaps>\_tous
      les ennemis."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053269
    m_Localized: Golomo
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053270
    m_Localized: "Golomo exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053271
    m_Localized: "Les Golomos vivent en petites communaut\xE9s, \xE9vitant g\xE9n\xE9ralement
      tout contact avec les humains et les autres cr\xE9atures. Quand ils se sentent
      menac\xE9s, ils peuvent devenir fous furieux, attaquant tout ce qui bouge et
      causant de petits tremblements de terre."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053272
    m_Localized: "Golomo inflige {Effect0.ValueInt}\_x\_<smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      \xE0 l'ennemi en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053273
    m_Localized: Golomo <smallcaps><style="Blue">se ranime</style></smallcaps> une
      fois par combat.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053274
    m_Localized: Golomo <smallcaps><style="Blue">se ranime</style></smallcaps> deux
      fois par combat.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053275
    m_Localized: "Golomo <smallcaps><style=\"Blue\">se ranime</style></smallcaps>
      une fois par combat.\nD\xE9but du combat\_: Golomo gagne {Effect1.ValueInt}\_x\_<smallcaps><style=\"Blue\">Attaques
      multiples</style></smallcaps> permanentes."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12295938882256896
    m_Localized: "Golomo <smallcaps><style=\"Blue\">se ranime</style></smallcaps>
      une fois par combat.\nQuand il <style=\"Blue\">s'\xE9vanouit</style>, la valeur
      de <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps> de tous
      les ennemis est doubl\xE9e."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053277
    m_Localized: Golomo <smallcaps><style="Blue">se ranime</style></smallcaps> deux
      fois par combat.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053278
    m_Localized: "D\xE9but du combat\_: Golomo gagne {Effect1.ValueInt}\_x\_<smallcaps><style=\"Blue\">Attaques
      multiples</style></smallcaps> permanentes."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12295938882256897
    m_Localized: "Quand Golomo <style=\"Blue\">s'\xE9vanouit</style>, la valeur de
      <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps> de tous
      les ennemis est doubl\xE9e."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053280
    m_Localized: Glarexus
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053281
    m_Localized: "Glarexus exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053282
    m_Localized: "Les Glarexus sont des \xEAtres sto\xEFques et hautains. N'ayant
      pas besoin de se nourrir, ils restent g\xE9n\xE9ralement \xE0 l'\xE9cart du
      monde, d\xE9truisant sans la moindre h\xE9sitation tout ce qui les emp\xEAche
      de m\xE9diter en paix. Parfois, ils peuvent transformer la lumi\xE8re en mat\xE9riau
      solide, ce qui en fait leur meilleure arme, mais aussi leur meilleure armure.
      Il se murmure aussi qu'un Glarexus peut parfois appara\xEEtre devant un d\xE9funt
      pour guider son \xE2me vers un nouveau corps."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053283
    m_Localized: "Glarexus gagne {Effect0.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053284
    m_Localized: "Glarexus perd {Effect1.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      \xE0 la fin du round, au lieu de tous les perdre."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053285
    m_Localized: "Glarexus garde tous ses\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      \xE0 la fin du round."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053286
    m_Localized: "Glarexus perd {Effect1.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      \xE0 la fin du round, au lieu de tous les perdre.\nFin du round\_: Glarexus
      inflige des <style=\"Blue\">d\xE9g\xE2ts</style> \xE9gaux \xE0 {Effect2.AdditionalValueString}\_%
      de son total de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12286811510521856
    m_Localized: "Glarexus perd {Effect2.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      \xE0 la fin du round, au lieu de tous les perdre.\nChaque fois qu'une attaque
      ennemie est <style=\"Blue\">totalement par\xE9e</style> par les <smallcaps><style=\"Blue\">boucliers</style></smallcaps>,
      {Effect1.AdditionalValueString}\_% des <style=\"Blue\">d\xE9g\xE2ts</style>
      sont renvoy\xE9s \xE0 l'attaquant."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053288
    m_Localized: "Glarexus garde tous ses\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      \xE0 la fin du round."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053289
    m_Localized: "Fin du round\_: Glarexus inflige des <style=\"Blue\">d\xE9g\xE2ts</style>
      \xE9gaux \xE0 {Effect2.AdditionalValueString}\_% de son total de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 12286811510521857
    m_Localized: "Chaque fois qu'une attaque ennemie est <style=\"Blue\">totalement
      par\xE9e</style> par les <smallcaps><style=\"Blue\">boucliers</style></smallcaps>,
      {Effect1.AdditionalValueString}\_% des <style=\"Blue\">d\xE9g\xE2ts</style>
      sont renvoy\xE9s \xE0 l'attaquant."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053291
    m_Localized: Prowler
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053292
    m_Localized: Prowler
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053293
    m_Localized: "Petits et silencieux, les Prowlers r\xF4dent en for\xEAt, o\xF9
      ils se nourrissent de baies, de noix et de petits animaux. Leurs nids douillets,
      o\xF9 ils dorment en journ\xE9e, sont cach\xE9s dans des arbres creux. Beaucoup
      de dompteurs ont re\xE7u des demandes de domestication d'un Prowler. La plupart
      ont refus\xE9 pour une question d'\xE9thique, mais quelques-uns ont tout de
      m\xEAme essay\xE9, \xE9chouant lamentablement car les Prowlers sont trop fiers
      et dangereux pour s'entendre avec les humains."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053294
    m_Localized: "<style=\"Blue\">Piochez</style> {Effect0.ValueInt}\_carte."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053295
    m_Localized: "D\xE9but du combat\_: <style=\"Blue\">gagne</style> {Effect0.ValuePercentage}\_%
      de votre total de <style=\"Blue\">Mystibaies</style>. Les Prowlers ne peuvent
      pas \xE9voluer."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053335
    m_Localized: Drosithia
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053336
    m_Localized: "Drosithia exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053337
    m_Localized: "Les Drosithias sont des Mystlings serviables mais naturellement
      timides. Pour une raison inconnue, les Dragons Gardiens ont tendance \xE0 les
      chasser, \xE0 tel point qu'ils sont menac\xE9s d'extinction."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053338
    m_Localized: "Drosithia inflige {Effect0.ValueInt} de <style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 un ennemi <style=\"Blue\">au hasard</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053339
    m_Localized: "Ne peut pas \xEAtre <style=\"Blue\">ranim\xE9</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053343
    m_Localized: "Activation\_: Drosithia inflige 5 de <style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 un ennemi <style=\"Blue\">au hasard</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 32555650210930688
    m_Localized: Aura de dragon
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 32555650231902208
    m_Localized: "Fait <style=\"Blue\">\xE9voluer</style> Drosithia en dragon au
      bout de {Effect0.Conditions.0}\_combats."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053346
    m_Localized: Bolb
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053347
    m_Localized: "Bolb exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053348
    m_Localized: "Les Bolbs aiment l\xE9zarder et passer leur temps \xE0 ne rien
      faire, ce qui les a incit\xE9s \xE0 ma\xEEtriser l'art du camouflage et des
      pi\xE8ges. Il est possible d'en rencontrer en bordure des mar\xE9cages proches
      des grands lacs, mais c'est extr\xEAmement rare. En effet, ils ne quittent
      g\xE9n\xE9ralement leur habitat naturel que quand ils ont faim depuis au moins
      deux semaines."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053349
    m_Localized: "Bolb se <style=\"Blue\">soigne</style> et r\xE9cup\xE8re {Effect0.ValueInt}
      de <style=\"Blue\">sant\xE9</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053350
    m_Localized: "<style=\"Blue\">Renvoie</style> sur les attaquants {Effect1.AdditionalValueString}\_%
      des <style=\"Blue\">d\xE9g\xE2ts</style> re\xE7us. Bolb ne peut pas recevoir
      de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053351
    m_Localized: "<style=\"Blue\">Renvoie</style> sur les attaquants {Effect1.AdditionalValueString}\_%
      des <style=\"Blue\">d\xE9g\xE2ts</style> re\xE7us. Bolb ne peut pas recevoir
      de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053353
    m_Localized: "<style=\"Blue\">Renvoie</style> sur les attaquants {Effect1.AdditionalValueString}\_%
      des <style=\"Blue\">d\xE9g\xE2ts</style> re\xE7us. Bolb ne peut pas recevoir
      de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053354
    m_Localized: "Augmente la <style=\"Blue\">sant\xE9<style=\"Blue\"> de {Mystling.Health}."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053355
    m_Localized: "Activation\_: Bolb se <style=\"Blue\">soigne</style> et r\xE9cup\xE8re
      {Effect2.ValueInt} de <style=\"Blue\">sant\xE9</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053356
    m_Localized: "Renvoie sur les attaquants {Effect1.ValueInt}\_% des <style=\"Blue\">d\xE9g\xE2ts</style>
      re\xE7us."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053324
    m_Localized: Frogmar
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053325
    m_Localized: "Frogmar exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053326
    m_Localized: "\xC9nergiques et d'un temp\xE9rament explosif, les Frogmars sont
      connus pour leur propension \xE0 se venger. En effet, lorsque quelqu'un les
      \xE9nerve, ils ne connaissent pas le repos avant de l'avoir puni. Les Frogmars
      appr\xE9cient les humains et les autres Mystlings, mais ces derniers pr\xE9f\xE8rent
      les \xE9viter, en raison de leurs fr\xE9quentes crises de col\xE8re."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053327
    m_Localized: "Frogmar gagne {Effect0.ValueInt} en <smallcaps><style=\"Blue\">Force</style></smallcaps>
      mais perd {Effect1.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053328
    m_Localized: "Frogmar double son nombre de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      gagn\xE9s."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053329
    m_Localized: "Frogmar double son nombre de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      gagn\xE9s.\nSa premi\xE8re attaque lors d'un combat inflige des <style=\"Blue\">d\xE9g\xE2ts</style>
      tripl\xE9s."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053330
    m_Localized: "Frogmar triple son nombre de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      gagn\xE9s."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053331
    m_Localized: "Frogmar double son nombre de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      gagn\xE9s."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053332
    m_Localized: "Changement de talent\_: la premi\xE8re attaque de Frogmar lors
      d'un combat inflige des <style=\"Blue\">d\xE9g\xE2ts</style> tripl\xE9s."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053333
    m_Localized: "Frogmar triple son nombre de <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      gagn\xE9s."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053334
    m_Localized: "<smallcaps><style=\"Blue\">Activation</style></smallcaps>\_: Frogmar
      gagne {Effect1.ValueInt} en <smallcaps><style=\"Blue\">Force</style></smallcaps>
      mais perd {Effect2.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053313
    m_Localized: Fale
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053314
    m_Localized: "Fale exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053315
    m_Localized: "Les Fales sont amicaux et adorables. Ils aiment barboter dans l'eau,
      plonger en compagnie des cr\xE9atures marines, ou encore se promener sur la
      plage sur leurs petites pattes. En d\xE9pit de leur apparence, on peut toutefois
      les entra\xEEner \xE0 combattre, auquel cas ils peuvent devenir d'excellents
      assistants et protecteurs. Qui plus est, ils adorent la comp\xE9tition."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053316
    m_Localized: Fale <smallcaps><style="Blue">active</style></smallcaps> tous les
      autres Mystlings.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053317
    m_Localized: "Fale <smallcaps><style=\"Blue\">ranime</style></smallcaps> le premier
      Mystling <style=\"Blue\">\xE9vanoui</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053318
    m_Localized: "Fale <smallcaps><style=\"Blue\">ranime</style></smallcaps> les
      deux premiers autres Mystlings <style=\"Blue\">\xE9vanouis</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053319
    m_Localized: "Fale <smallcaps><style=\"Blue\">ranime</style></smallcaps> le premier
      Mystling <style=\"Blue\">\xE9vanoui</style>.\nFale gagne {Effect0.ValueInt}
      en <smallcaps><style=\"Blue\">Force</style></smallcaps> quand les autres Mystlings
      <smallcaps><style=\"Blue\">s'activent</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053320
    m_Localized: "Fale <smallcaps><style=\"Blue\">ranime</style></smallcaps> le premier
      Mystling <style=\"Blue\">\xE9vanoui</style>.\nQuand n'importe quel autre Mystling
      <style=\"Blue\">s'\xE9vanouit</style>, <smallcaps><style=\"Blue\">\xE9tourdit</style></smallcaps>
      tous les ennemis."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053321
    m_Localized: "Fale <smallcaps><style=\"Blue\">ranime</style></smallcaps> les
      deux premiers autres Mystlings <style=\"Blue\">\xE9vanouis</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053322
    m_Localized: Fale gagne {Effect0.ValueInt} en <smallcaps><style="Blue">Force</style></smallcaps>
      quand les autres Mystlings <smallcaps><style="Blue">s'activent</style></smallcaps>.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053323
    m_Localized: "Quand n'importe quel autre Mystling <style=\"Blue\">s'\xE9vanouit</style>,
      <smallcaps><style=\"Blue\">\xE9tourdit</style></smallcaps> tous les ennemis."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053302
    m_Localized: Eftus
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053303
    m_Localized: "Eftus exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053304
    m_Localized: "Les Eftus n'ont rien contre les autres cr\xE9atures, du moment
      que celles-ci leur laissent pratiquer leurs activit\xE9s incompr\xE9hensibles.
      Ils ont tendance \xE0 ignorer les dompteurs et les autres Mystlings, ne r\xE9agissant
      que lorsqu'ils se sentent attaqu\xE9s. On raconte qu'un jour, une bande d'Eftus
      se seraient empar\xE9s d'un vaisseau pirate et que, depuis, ils parcourraient
      les sept mers \xE0 son bord. "
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053305
    m_Localized: "Eftus inflige {Effect0.ValueInt} de\_<style=\"Blue\">d\xE9g\xE2ts</style>
      au <style=\"Blue\">dernier</style> ennemi."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053306
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: +{Effect0.ValueInt}\_Mystibaie."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053307
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: +{Effect0.ValueInt}\_Mystibaie,
      Eftus gagne {Effect1.ValueInt} en <style=\"Blue\">sant\xE9</style> de mani\xE8re
      permanente."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053308
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: +{Effect0.ValueInt}\_Mystibaie,
      Eftus gagne {Effect1.ValueInt} en <style=\"Blue\">Puissance</style> de mani\xE8re
      permanente."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053309
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: +{Effect0.ValueInt}\_Mystibaie
      et +{Effect1.ValueInt} en <style=\"Blue\">\xE9nergie</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053310
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: Eftus gagne {Effect1.ValueInt}
      en <style=\"Blue\">sant\xE9</style> de mani\xE8re permanente."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053311
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: Eftus gagne {Effect1.ValueInt}
      en <style=\"Blue\">Puissance</style> de mani\xE8re permanente."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 5776446912053312
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: +{Effect1.ValueInt} en <style=\"Blue\">\xE9nergie</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 31100841666019328
    m_Localized: "Les Fales sont amicaux et adorables. Ils aiment barboter dans l'eau,
      plonger en compagnie des cr\xE9atures marines, ou encore se promener sur la
      plage sur leurs petites pattes. Mais en d\xE9pit de leur apparence, on peut
      toutefois les entra\xEEner \xE0 combattre."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 31100841678602240
    m_Localized: "Petits et silencieux, les Prowlers r\xF4dent en for\xEAt, o\xF9
      ils se nourrissent de baies, de noix et de petits animaux. Leurs nids douillets,
      o\xF9 ils dorment en journ\xE9e, sont cach\xE9s dans des arbres creux."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 63394363265777664
    m_Localized: "Ces Mystlings des montagnes pr\xE9f\xE8rent vivre \xE0 l'\xE9cart,
      mais les plus courageux d'entre eux n'h\xE9sitent pas \xE0 s'aventurer loin
      de leur habitat naturel. Contre toute attente, les Icelings sont particuli\xE8rement
      endurants, et ils adorent s'entra\xEEner."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 63747457782644736
    m_Localized: "La petite taille des Pinequeaks ne doit pas faire oublier leur
      exub\xE9rance. Ils ont un caract\xE8re bien tremp\xE9, et leur fureur peut
      changer le cours d'une bataille pour peu qu'on sache l'utiliser \xE0 bon escient."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 31100841678602241
    m_Localized: "Les Glarexus sont des \xEAtres sto\xEFques et hautains. N'ayant
      pas besoin de se nourrir, ils restent g\xE9n\xE9ralement \xE0 l'\xE9cart du
      monde, d\xE9truisant sans la moindre h\xE9sitation tout ce qui les emp\xEAche
      de m\xE9diter en paix."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139486171136
    m_Localized: Emberling
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336960
    m_Localized: "Emberling exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336961
    m_Localized: "Emberling inflige {Effect0.ValueInt} de\_<style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 tous les ennemis, ainsi que {Effect1.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>
      aux autres Mystlings."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336962
    m_Localized: "Emberling peut choisir sa cible librement quand il attaque \xE0
      l'aide d'une carte (ne s'applique pas aux cartes ciblant tous les ennemis ou
      un ennemi au hasard)."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336965
    m_Localized: "Emberling peut choisir sa cible librement quand il attaque \xE0
      l'aide d'une carte (ne s'applique pas aux cartes ciblant tous les ennemis ou
      un ennemi au hasard).\nAttaque\_: l'ennemi situ\xE9 <style=\"Blue\">derri\xE8re</style>
      la cible subit 50\_% de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336966
    m_Localized: "Activation\_: Emberling inflige {Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 tous les ennemis, ainsi que {Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>
      aux autres Mystlings."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336967
    m_Localized: Augmente la <style="Blue">Puissance</style> d'Emberling de {Mystling.Power}.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336968
    m_Localized: "Attaque\_: l'ennemi situ\xE9 <style=\"Blue\">derri\xE8re</style>
      la cible subit 50\_% de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336969
    m_Localized: Luminesca
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336970
    m_Localized: "Luminesca exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336971
    m_Localized: "Luminesca conf\xE8re {Effect0.ValueInt}\_en <smallcaps><style=\"Blue\">Force</style></smallcaps>
      et {Effect1.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style>, tout en le <style=\"Blue\">soignant</style>
      de {Effect2.ValueInt}\_<style=\"Blue\">PV</style>. Puis, Luminesca est <smallcaps><style=\"Blue\">assomm\xE9</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336972
    m_Localized: "Toutes les deux fois o\xF9 Luminesca est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>,
      il gagne {Effect0.ValueInt}\_x\_<smallcaps><style=\"Blue\">Esquive</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336976
    m_Localized: "\xC0 l'<smallcaps><style=\"Blue\">activation</style></smallcaps>,
      Luminesca conf\xE8re {Effect1.ValueInt} de <smallcaps><style=\"Blue\">Force</style></smallcaps>
      en plus au Mystling en <style=\"Blue\">premi\xE8re ligne</style> (m\xEAme si
      c'est lui)."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336977
    m_Localized: "\xC0 l'<smallcaps><style=\"Blue\">activation</style></smallcaps>,
      Luminesca conf\xE8re {Effect2.ValueInt} <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style> (m\xEAme si c'est
      lui)."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 45921139511336978
    m_Localized: "\xC0 l'<smallcaps><style=\"Blue\">activation</style></smallcaps>,
      Luminesca <style=\"Blue\">soigne</style> de {Effect3.ValueInt}\_<style=\"Blue\">PV</style>
      le Mystling en <style=\"Blue\">premi\xE8re ligne</style> (m\xEAme si c'est
      lui)."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999243939840
    m_Localized: Gaiadon
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105665
    m_Localized: "Forme de base\_: Gaiadon gagne {Effect0.ValueInt}\_<style=\"Blue\">Charge
      draconique</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105666
    m_Localized: "\xC0 5\_<style=\"Blue\">Charges draconiques</style>, Gaiadon prend
      sa Forme de dragon jusqu'\xE0 la fin du round.\nForme de dragon\_: +{Effect3.ValueInt}
      en <style=\"Blue\">Force</style>, +{Effect2.ValueInt}\_<style=\"Blue\">boucliers</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105673
    m_Localized: Lear
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105674
    m_Localized: "Lear exalt\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105675
    m_Localized: "Lear gagne {Effect0.ValueInt}\_<style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105676
    m_Localized: "Quand Lear est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>\_:
      il gagne autant en <smallcaps><style=\"Blue\">Force</style></smallcaps> qu'il
      a perdu de <style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105678
    m_Localized: "R\xE9duit de mani\xE8re permanente les <style=\"Blue\">d\xE9g\xE2ts</style>
      subis de {Effect0.AdditionalValueString}\_%.<br><smallcaps><style=\"Blue\">Bless\xE9</style></smallcaps>\_:
      gagne autant en <smallcaps><style=\"Blue\">Force</style></smallcaps> qu'il
      a perdu de <style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 55722999269105679
    m_Localized: "Augmente de mani\xE8re permanente les <style=\"Blue\">d\xE9g\xE2ts</style>
      subis de {Effect1.AdditionalValueString}\_%.<br><style=\"Blue\">Bless\xE9</style>\_:
      gagne deux fois plus de <style=\"Blue\">Force</style> qu'il a perdu de <style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 56431011013140483
    m_Localized: "Le maximum de\_<style=\"Blue\">sant\xE9</style> de Lear augmente
      de {Effect1.ValueInt} chaque fois qu'il <smallcaps><style=\"Blue\">s'active</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 56431011013140484
    m_Localized: "<style=\"Blue\">R\xE9duit de mani\xE8re permanente les d\xE9g\xE2ts</style>
      subis de {Effect0.AdditionalValueString}\_%."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
  - m_Id: 56431011013140485
    m_Localized: "Augmente de mani\xE8re permanente les <style=\"Blue\">d\xE9g\xE2ts</style>
      subis de {Effect1.AdditionalValueString}\_%, gain de <smallcaps><style=\"Blue\">Force</style></smallcaps>
      doubl\xE9 quand il est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410419
