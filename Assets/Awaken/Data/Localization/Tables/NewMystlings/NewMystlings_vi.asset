  - m_Id: 5776446912053303
    m_Localized: "Eftus Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053304
    m_Localized: "Eftus ch\u1EB3ng b\u1EADn t\xE2m \u0111\u1EBFn ai, mi\u1EC5n l\xE0
      ng\u01B0\u1EDDi ta \u0111\u1EC3 y\xEAn cho ch\xFAng l\xE0m nh\u1EEFng vi\u1EC7c
      kh\xF3 hi\u1EC3u c\u1EE7a m\xECnh. Ch\xFAng ph\u1EDBt l\u1EDD c\xE1c Mystling
      kh\xE1c, ph\u1EDBt l\u1EDD c\u1EA3 Tamer, v\xE0 ch\u1EC9 ph\u1EA3n \u1EE9ng
      khi c\xF3 th\u1EE9 g\xEC \u0111\xF3 l\xE0m ch\xFAng \u0111au. Ng\u01B0\u1EDDi
      ta \u0111\u1ED3n r\u1EB1ng t\u1EEBng c\xF3 m\u1ED9t b\u0103ng Eftus chi\u1EBFm
      \u0111\u01B0\u1EE3c c\u1EA3 m\u1ED9t con t\xE0u c\u01B0\u1EDBp bi\u1EC3n, v\xE0
      t\u1EEB \u0111\xF3 \u0111\u1EBFn nay ch\xFAng v\u1EABn rong ru\u1ED5i tr\xEAn
      nh\u1EEFng v\xF9ng bi\u1EC3n \u0111\u1ED9ng. "
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053305
    m_Localized: "Eftus g\xE2y {Effect0.ValueInt} <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      l\xEAn k\u1EBB \u0111\u1ECBch <style=\"Blue\">cu\u1ED1i h\xE0ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053306
    m_Localized: "<style=\"Blue\">H\u1EA1 G\u1EE5c</style>: Nh\u1EADn {Effect0.ValueInt}
      Mystberry"
