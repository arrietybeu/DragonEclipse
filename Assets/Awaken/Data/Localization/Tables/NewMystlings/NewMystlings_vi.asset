      - rid: 8099901647879405571
  - m_Id: 56431011013140483
    m_Localized: "M\u1ED7i l\u1EA7n <smallcaps><style=\"Blue\">K\xEDch ho\u1EA1t</style></smallcaps>,
      Lear nh\u1EADn {Effect1.ValueInt} <style=\"Blue\">M\xE1u</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105673
    m_Localized: Lear
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105674
    m_Localized: "Lear Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105675
    m_Localized: "Lear nh\u1EADn {Effect0.ValueInt} <style=\"Blue\">M\xE1u</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105676
    m_Localized: "Khi Lear <smallcaps><style=\"Blue\">B\u1ECB Th\u01B0\u01A1ng</style></smallcaps>:
      Lear nh\u1EADn <smallcaps><style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style></smallcaps>
      b\u1EB1ng l\u01B0\u1EE3ng M\xE1u \u0111\xE3 m\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105677
    m_Localized: "Khi Lear <smallcaps><color=#40E0D0>B\u1ECB Th\u01B0\u01A1ng</color=#40E0D0></smallcaps>:
      Lear nh\u1EADn <smallcaps><color=#40E0D0>C\u01B0\u1EDDng L\u1EF1c</color=#40E0D0></smallcaps>
      b\u1EB1ng l\u01B0\u1EE3ng M\xE1u \u0111\xE3 m\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105678
    m_Localized: "Gi\u1EA3m v\u0129nh vi\u1EC5n {Effect0.AdditionalValueString}%
      <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style> nh\u1EADn v\xE0o <br><smallcaps><style=\"Blue\">B\u1ECB
      Th\u01B0\u01A1ng</style></smallcaps>: Nh\u1EADn <smallcaps><style=\"Blue\">C\u01B0\u1EDDng
      L\u1EF1c</style></smallcaps> b\u1EB1ng l\u01B0\u1EE3ng <style=\"Blue\">M\xE1u</style>
      \u0111\xE3 m\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 55722999269105679
    m_Localized: "T\u0103ng v\u0129nh vi\u1EC5n {Effect1.AdditionalValueString}%
      <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style> nh\u1EADn v\xE0o <br><style=\"Blue\">B\u1ECB
      Th\u01B0\u01A1ng</style>: Nh\u1EADn <style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style>
      b\u1EB1ng hai l\u1EA7n l\u01B0\u1EE3ng <style=\"Blue\">M\xE1u</style> \u0111\xE3
      m\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 56431011013140484
    m_Localized: "V\u0129nh vi\u1EC5n <style=\"Blue\">gi\u1EA3m s\xE1t th\u01B0\u01A1ng</style>
      nh\u1EADn v\xE0o {Effect0.AdditionalValueString}%"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 56431011013140485
    m_Localized: "V\u0129nh vi\u1EC5n <style=\"Blue\">t\u0103ng s\xE1t th\u01B0\u01A1ng</style>
      nh\u1EADn v\xE0o {Effect1.AdditionalValueString}%, nh\xE2n \u0111\xF4i l\u01B0\u1EE3ng
      <smallcaps><style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style></smallcaps> nh\u1EADn
      \u0111\u01B0\u1EE3c khi <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59051605030412288
    m_Localized: "M\xF3n Qu\xE0 c\u1EE7a Pinequeak"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59051605059772416
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: <color=#40E0D0>R\xFAt</color=#40E0D0>
      2 l\xE1 b\xE0i <color=#40E0D0>C\u01A1n Gi\u1EADn M\xF9 Qu\xE1ng</color=#40E0D0>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59051605059772417
    m_Localized: "M\xF3n Qu\xE0 c\u1EE7a Iceling"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59051605059772418
    m_Localized: "C\u1EE9 m\u1ED7i V\xF2ng th\u1EE9 2: <color=#40E0D0>R\xFAt</color=#40E0D0>
      1 l\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59051605059772419
    m_Localized: "M\xF3n Qu\xE0 c\u1EE7a Golomo"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59051605059772420
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Golomo \xE1p d\u1EE5ng 3
      <smallcaps><color=#40E0D0>Mong Manh</color=#40E0D0></smallcaps> cho K\u1EBB
      \u0111\u1ECBch \u0111\u1EE9ng \u0111\u1EA7u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 63394363265777664
    m_Localized: "Nh\u1EEFng sinh v\u1EADt mi\u1EC1n s\u01A1n c\u01B0\u1EDBc n\xE0y
      s\u1ED1ng \u1EA9n d\u1EADt, nh\u01B0ng c\xE1c c\xE1 th\u1EC3 t\xF2 m\xF2 nh\u1EA5t
      l\u1EA1i d\u1EA5n b\u01B0\u1EDBc \u0111i xa, v\xE0 b\u1EA1n c\xF3 th\u1EC3
      b\u1EAFt g\u1EB7p ch\xFAng \u1EDF nh\u1EEFng v\xF9ng th\u1EA5p h\u01A1n. B\u1EA5t
      ng\u1EDD thay, Iceling s\u1EDF h\u1EEFu s\u1EE9c s\u1ED1ng phi th\u01B0\u1EDDng
      v\xE0 r\u1EA5t m\xEA luy\u1EC7n t\u1EADp."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 63747457782644736
    m_Localized: "D\xE1ng h\xECnh b\xE9 nh\u1ECF c\u1EE7a Pinequeak l\u1EA1i gi\u1EA5u
      trong m\xECnh m\u1ED9t tinh th\u1EA7n tr\xE0n \u0111\u1EA7y h\u0103ng h\xE1i.
      T\xEDnh kh\xED s\u1EAFc nh\u01B0 dao c\u1EA1o c\xF9ng c\u01A1n th\u1ECBnh n\u1ED9
      nh\u1EAFm chu\u1EA9n x\xE1c c\u1EE7a ch\xFAng c\xF3 th\u1EC3 xoay chuy\u1EC3n
      c\u1EE5c di\u1EC7n c\u1EE7a b\u1EA5t k\u1EF3 tr\u1EADn \u0111\u1EA5u n\xE0o."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
