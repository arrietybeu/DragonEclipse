  m_TableData:
  - m_Id: 5776446886887424
    m_Localized: Pinequeak
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053248
    m_Localized: "Pinequeak Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053250
    m_Localized: "<style=\"Blue\">T\u1EA5n c\xF4ng</style> m\u1ED9t k\u1EBB \u0111\u1ECBch
      ng\u1EABu nhi\xEAn v\u1EDBi {Effect0.Attack.PowerModifier}% <style=\"Blue\">S\u1EE9c
      m\u1EA1nh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053251
    m_Localized: "Khi Pinequeak <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>:
      Th\xEAm l\xE1 b\xE0i <style=\"Blue\">{Effect0.ValueString}</style> v\xE0o tay
      b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053258
    m_Localized: Iceling
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053259
    m_Localized: "Iceling Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053261
    m_Localized: "Iceling \xE1p d\u1EE5ng {Effect0.ValueInt} <smallcaps><style=\"Blue\">C\u01B0\u1EDDng
      L\u1EF1c</style></smallcaps> cho Mystling \u0111\u1EE9ng \u0111\u1EA7u (c\xF3
      th\u1EC3 l\xE0 ch\xEDnh n\xF3)"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053262
    m_Localized: "Iceling nh\u1EADn th\xEAm <style=\"Blue\">S\u1EE9c m\u1EA1nh</style>
      b\u1EB1ng <style=\"Blue\">s\u1ED1 l\xE1 b\xE0i</style> tr\xEAn tay b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053269
    m_Localized: Golomo
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053270
    m_Localized: "Golomo Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053272
    m_Localized: "Golomo \xE1p d\u1EE5ng {Effect0.ValueInt} <smallcaps><style=\"Blue\">Mong
      Manh</style></smallcaps> cho K\u1EBB \u0111\u1ECBch \u0111\u1EE9ng \u0111\u1EA7u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053273
    m_Localized: "Golomo <smallcaps><style=\"Blue\">H\u1ED3i Sinh</style></smallcaps>
      m\u1ED9t l\u1EA7n m\u1ED7i Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053280
    m_Localized: Glarexus
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053281
    m_Localized: "Glarexus Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053284
    m_Localized: "Cu\u1ED1i V\xF2ng, Glarexus ch\u1EC9 m\u1EA5t {Effect1.ValueInt}
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps> thay v\xEC to\xE0n
      b\u1ED9"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053291
    m_Localized: Prowler
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053292
    m_Localized: Prowler
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053295
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: <style=\"Blue\">Nh\u1EADn</style>
      {Effect0.ValuePercentage}% t\u1ED5ng s\u1ED1 <style=\"Blue\">Mystberries</style>
      c\u1EE7a b\u1EA1n. Prowler kh\xF4ng th\u1EC3 ti\u1EBFn h\xF3a"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053335
    m_Localized: Drosithia
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053336
    m_Localized: "Drosithia Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053337
    m_Localized: "Drosithia v\u1ED1n nh\xFAt nh\xE1t nh\u01B0ng t\u1ED1t b\u1EE5ng,
      ch\u1EC9 c\xF3 \u0111i\u1EC1u ho\xE0n c\u1EA3nh \u0111\xE3 bu\u1ED9c ch\xFAng
      ph\u1EA3i r\u1EE5t r\xE8 h\u01A1n n\u1EEFa. V\xEC m\u1ED9t l\xFD do kh\xF4ng
      ai r\xF5, c\xE1c H\u1ED9 V\u1EC7 R\u1ED3ng lu\xF4n s\u0103n l\xF9ng Drosithia,
      \u0111\u1EA9y c\u1EA3 gi\u1ED1ng lo\xE0i n\xE0y \u0111\u1EBFn s\xE1t b\u1EDD
      v\u1EF1c tuy\u1EC7t ch\u1EE7ng."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053339
    m_Localized: "Kh\xF4ng th\u1EC3 \u0111\u01B0\u1EE3c <style=\"Blue\">h\u1ED3i
      sinh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053340
    m_Localized: '-'
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053343
    m_Localized: "K\xEDch ho\u1EA1t: Drosithia g\xE2y 5 <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      l\xEAn k\u1EBB \u0111\u1ECBch <style=\"Blue\">ng\u1EABu nhi\xEAn</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053338
    m_Localized: "Drosithia g\xE2y {Effect0.ValueInt} <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      l\xEAn m\u1ED9t k\u1EBB \u0111\u1ECBch <style=\"Blue\">ng\u1EABu nhi\xEAn</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053249
    m_Localized: "T\xEDnh kh\xED hi\u1EC3m \u0111\u1ED9c, \xE1nh m\u1EAFt gian x\u1EA3o,
      lu\xF4n gi\u1EA5u s\u1EB5n v\xE0i tr\xF2 b\u1EA9n trong tay \xE1o \u2013 ti\u1EBFng
      x\u1EA5u c\u1EE7a Pinequeak l\xE0 ho\xE0n to\xE0n x\u1EE9ng \u0111\xE1ng. Gi\u1ED1ng
      nh\u01B0 m\u1ECDi lo\xE0i ph\xE1 ph\xE1ch kh\xE1c, ch\xFAng c\xF3 t\xEAn g\u1ECDi
      ri\xEAng \u1EDF t\u1EEBng th\xE0nh ph\u1ED1. Hai bi\u1EBFn th\u1EC3 ph\u1ED5
      bi\u1EBFn nh\u1EA5t l\xE0 Pulpin v\xE0 Firple."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053252
    m_Localized: "Khi Pinequeak <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>:
      Th\xEAm hai l\xE1 b\xE0i <style=\"Blue\">{Effect0.ValueString}</style> ch\u01B0a
      n\xE2ng c\u1EA5p v\xE0o tay b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053253
    m_Localized: "Khi Pinequeak <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>:
      Th\xEAm l\xE1 b\xE0i <style=\"Blue\">{Effect0.ValueString}</style> v\xE0o tay
      b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053255
    m_Localized: "Khi Pinequeak <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>:
      Th\xEAm hai l\xE1 b\xE0i <style=\"Blue\">{Effect0.ValueString}</style> ch\u01B0a
      n\xE2ng c\u1EA5p v\xE0o tay b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053256
    m_Localized: "T\u0103ng <style=\"Blue\">M\xE1u</style> th\xEAm {Mystling.Health}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053260
    m_Localized: "Iceling ph\u1EA7n l\u1EDBn l\xE0 nh\u1EEFng sinh v\u1EADt \u1EA9n
      d\u1EADt, nh\u01B0ng v\u1EABn c\xF3 nh\u1EEFng con nu\xF4i d\u01B0\u1EE1ng
      n\u1ED7i t\xF2 m\xF2 tr\u1ED7i d\u1EADy trong tim. C\xE1c c\xE1 th\u1EC3 d\xE1m
      r\u1EDDi kh\u1ECFi \u0111\u1EC9nh n\xFAi tuy\u1EBFt thu\u1ED9c h\xE0ng d\u0169ng
      c\u1EA3m v\xE0 c\u1EDFi m\u1EDF nh\u1EA5t trong mu\xF4n lo\xE0i."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053263
    m_Localized: "Iceling nh\u1EADn th\xEAm <style=\"Blue\">S\u1EE9c m\u1EA1nh</style>
      b\u1EB1ng <style=\"Blue\">s\u1ED1 l\xE1 b\xE0i</style> tr\xEAn tay b\xE0i.\n\u0110\u1EA7u
      Tr\u1EADn \u0111\u1EA5u: <style=\"Blue\">R\xFAt</style> {Effect0.ValueInt}
      l\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053264
    m_Localized: "Iceling nh\u1EADn th\xEAm <style=\"Blue\">S\u1EE9c m\u1EA1nh</style>
      b\u1EB1ng <style=\"Blue\">s\u1ED1 l\xE1 b\xE0i</style> tr\xEAn tay b\xE0i.\nCu\u1ED1i
      V\xF2ng: Nh\xE2n \u0111\xF4i <style=\"Blue\">C\u01B0\u1EDDng L\u1EF1c</style>
      c\u1EE7a Mystling \u0111\u1EE9ng \u0111\u1EA7u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053266
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: <style=\"Blue\">R\xFAt</style>
      {Effect0.ValueInt} l\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053267
    m_Localized: "Cu\u1ED1i V\xF2ng: Nh\xE2n \u0111\xF4i <smallcaps><style=\"Blue\">C\u01B0\u1EDDng
      L\u1EF1c</style></smallcaps> c\u1EE7a Mystling \u0111\u1EE9ng \u0111\u1EA7u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053271
    m_Localized: "Golomo s\u1ED1ng kh\xE9p k\xEDn trong nh\u1EEFng c\u1ED9ng \u0111\u1ED3ng
      g\u1EAFn b\xF3 c\u1EE7a ri\xEAng m\xECnh, tr\xE1nh m\u1ECDi ti\u1EBFp x\xFAc
      v\u1EDBi con ng\u01B0\u1EDDi hay c\xE1c sinh v\u1EADt kh\xE1c. Khi b\u1ECB
      d\u1ED3n v\xE0o th\u1EBF nguy, Golomo c\xF3 th\u1EC3 n\u1ED5i c\u01A1n th\u1ECBnh
      n\u1ED9, t\u1EA5n c\xF4ng m\u1ECDi th\u1EE9 trong t\u1EA7m m\u1EAFt v\xE0 g\xE2y
      ra nh\u1EEFng tr\u1EADn \u0111\u1ED9ng \u0111\u1EA5t nh\u1ECF."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053274
    m_Localized: "Golomo <smallcaps><style=\"Blue\">H\u1ED3i Sinh</style></smallcaps>
      hai l\u1EA7n m\u1ED7i Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053275
    m_Localized: "Golomo <smallcaps><style=\"Blue\">H\u1ED3i Sinh</style></smallcaps>
      m\u1ED9t l\u1EA7n m\u1ED7i Tr\u1EADn \u0111\u1EA5u\n\u0110\u1EA7u Tr\u1EADn
      \u0111\u1EA5u: Golomo nh\u1EADn {Effect1.ValueInt} <smallcaps><style=\"Blue\">\u0110a
      K\xEDch</style></smallcaps> v\u0129nh vi\u1EC5n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053277
    m_Localized: "Golomo <smallcaps><style=\"Blue\">H\u1ED3i Sinh</style></smallcaps>
      hai l\u1EA7n m\u1ED7i Tr\u1EADn \u0111\u1EA5u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053278
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Golomo nh\u1EADn {Effect1.ValueInt}
      <smallcaps><style=\"Blue\">\u0110a K\xEDch</style></smallcaps> v\u0129nh vi\u1EC5n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053282
    m_Localized: "Glarexus \u0111i\u1EC1m t\u0129nh v\xE0 cao ng\u1EA1o, th\u1EDD
      \u01A1 v\u1EDBi th\u1EBF gi\u1EDBi b\xEAn ngo\xE0i v\xEC ch\xFAng ch\u1EB3ng
      c\u1EA7n \u0103n u\u1ED1ng. N\u1EBFu c\xF3 th\u1EE9 g\xEC ph\xE1 v\u1EE1 s\u1EF1
      t\u0129nh l\u1EB7ng thi\u1EC1n \u0111\u1ECBnh \u1EA5y, ch\xFAng s\u1EBD l\u1EADp
      t\u1EE9c t\xECm c\xE1ch x\xF3a s\u1ED5 ch\u01B0\u1EDBng ng\u1EA1i \u0111\xF3.
      B\u1EB1ng c\xE1ch n\xE0o \u0111\xF3, Glarexus c\xF3 th\u1EC3 bi\u1EBFn \xE1nh
      s\xE1ng th\xE0nh v\u1EADt ch\u1EA5t r\u1EAFn, khi\u1EBFn n\xF3 v\u1EEBa l\xE0
      v\u0169 kh\xED v\u1EEBa l\xE0 \xE1o gi\xE1p l\u1EE3i h\u1EA1i nh\u1EA5t c\u1EE7a
      m\xECnh. Ng\u01B0\u1EDDi ta c\xF2n k\u1EC3 r\u1EB1ng m\u1ED9t Glarexus c\xF3
      th\u1EC3 hi\u1EC7n ra tr\u01B0\u1EDBc ng\u01B0\u1EDDi v\u1EEBa khu\u1EA5t \u0111\u1EC3
      d\u1EABn d\u1EAFt linh h\u1ED3n h\u1ECD sang m\u1ED9t th\xE2n x\xE1c m\u1EDBi."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053285
    m_Localized: "Cu\u1ED1i V\xF2ng, Glarexus gi\u1EEF nguy\xEAn to\xE0n b\u1ED9
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053286
    m_Localized: "Cu\u1ED1i V\xF2ng, Glarexus ch\u1EC9 m\u1EA5t {Effect1.ValueInt}
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps> thay v\xEC to\xE0n
      b\u1ED9\nCu\u1ED1i V\xF2ng: Glarexus g\xE2y <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      b\u1EB1ng {Effect2.AdditionalValueString}% gi\xE1 tr\u1ECB <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>
      c\u1EE7a n\xF3"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053288
    m_Localized: "Cu\u1ED1i V\xF2ng, Glarexus gi\u1EEF nguy\xEAn to\xE0n b\u1ED9
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053289
    m_Localized: "Cu\u1ED1i V\xF2ng: Glarexus g\xE2y <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      b\u1EB1ng {Effect2.AdditionalValueString}% gi\xE1 tr\u1ECB <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 10447510648725505
    m_Localized: "K\xEDch ho\u1EA1t Mystling ph\xEDa tr\u01B0\u1EDBc hai l\u1EA7n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053293
    m_Localized: "Nh\u1ECF b\xE9 v\xE0 l\u1EB7ng l\u1EBD, Prowler r\xECnh r\u1EADp
      kh\u1EAFp r\u1EEBng s\xE2u, s\u0103n nh\u1EEFng con v\u1EADt t\xED hon, nh\u1EB7t
      qu\u1EA3 m\u1ECDng v\xE0 h\u1EA1t d\u1EBB. T\u1ED5 \u1EA5m \xEAm \xE1i c\u1EE7a
      ch\xFAng \u0111\u01B0\u1EE3c gi\u1EA5u k\u1EF9 trong h\u1ED1c c\xE2y, n\u01A1i
      ch\xFAng ng\u1EE7 v\xF9i su\u1ED1t ban ng\xE0y. C\xE1c Tamer t\u1EEBng nh\u1EADn
      v\xF4 s\u1ED1 l\u1EDDi nh\u1EDD thu\u1EA7n h\xF3a m\u1ED9t con Prowler. Ph\u1EA7n
      l\u1EDBn \u0111\xE3 t\u1EEB ch\u1ED1i v\xEC l\xFD do \u0111\u1EA1o \u0111\u1EE9c,
      nh\u01B0ng c\u0169ng c\xF3 ng\u01B0\u1EDDi th\u1EED. V\xE0 t\u1EA5t c\u1EA3
      \u0111\u1EC1u th\u1EA5t b\u1EA1i th\u1EA3m h\u1EA1i, b\u1EDFi Prowler qu\xE1
      ki\xEAu h\xE3nh v\xE0 nguy hi\u1EC3m \u0111\u1EC3 chung s\u1ED1ng v\u1EDBi
      gia \u0111\xECnh lo\xE0i ng\u01B0\u1EDDi."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053294
