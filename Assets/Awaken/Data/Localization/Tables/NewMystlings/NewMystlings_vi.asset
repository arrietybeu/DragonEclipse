  - m_Id: 5776446912053324
    m_Localized: Frogmar
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053325
    m_Localized: "Frogmar Si\xEAu Vi\u1EC7t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053326
    m_Localized: "\u0110\u1EA7y n\u0103ng l\u01B0\u1EE3ng v\xE0 n\xF3ng n\u1EA3y,
      Frogmar n\u1ED5i ti\u1EBFng v\u1EDBi b\u1EA3n t\xEDnh th\xF9 dai. C\u1EE9 ch\u1ECDc
      gi\u1EADn m\u1ED9t con Frogmar m\xE0 xem, n\xF3 s\u1EBD kh\xF4ng y\xEAn cho
      t\u1EDBi khi b\u1EA1n th\u1EA5m th\xEDa th\u1EBF n\xE0o l\xE0 \u0111au \u0111\u1EDBn.
      Frogmar qu\xFD con ng\u01B0\u1EDDi v\xE0 c\xE1c Mystling kh\xE1c, nh\u01B0ng
      l\u1EA1i th\u01B0\u1EDDng b\u1ECB xa l\xE1nh v\xEC ai c\u0169ng s\u1EE3 nh\u1EEFng
      c\u01A1n b\xF9ng n\u1ED5 gi\u1EADn d\u1EEF c\u1EE7a ch\xFAng."
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053327
    m_Localized: "Frogmar nh\u1EADn {Effect0.ValueInt} <smallcaps><style=\"Blue\">C\u01B0\u1EDDng
      L\u1EF1c</style></smallcaps> v\xE0 m\u1EA5t {Effect1.ValueInt} <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053328
    m_Localized: "Frogmar nh\xE2n \u0111\xF4i l\u01B0\u1EE3ng <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>
      nh\u1EADn \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 5776446912053329
    m_Localized: "Frogmar nh\xE2n \u0111\xF4i l\u01B0\u1EE3ng <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>
      nh\u1EADn \u0111\u01B0\u1EE3c.\n\u0110\xF2n t\u1EA5n c\xF4ng \u0111\u1EA7u
      ti\xEAn c\u1EE7a Frogmar trong Tr\u1EADn \u0111\u1EA5u g\xE2y g\u1EA5p ba <style=\"Blue\">s\xE1t
      th\u01B0\u01A1ng</style>"
    m_Metadata:
      m_Items:
