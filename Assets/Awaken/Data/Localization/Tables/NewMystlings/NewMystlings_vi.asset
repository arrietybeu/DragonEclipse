  - m_Id: 12286811510521857
    m_Localized: "M\u1ED7i khi m\u1ED9t \u0111\xF2n t\u1EA5n c\xF4ng b\u1ECB <style=\"Blue\">ch\u1EB7n
      ho\xE0n to\xE0n</style> b\u1EDFi <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>,
      ph\u1EA3n {Effect1.AdditionalValueString}% s\xE1t th\u01B0\u01A1ng \u0111\xE3
      nh\u1EADn v\u1EC1 k\u1EBB t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 12286811510521856
    m_Localized: "Cu\u1ED1i V\xF2ng, Glarexus ch\u1EC9 m\u1EA5t {Effect2.ValueInt}
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps> thay v\xEC to\xE0n
      b\u1ED9\nM\u1ED7i khi m\u1ED9t \u0111\xF2n t\u1EA5n c\xF4ng b\u1ECB <style=\"Blue\">ch\u1EB7n
      ho\xE0n to\xE0n</style> b\u1EDFi <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>,
      ph\u1EA3n {Effect1.AdditionalValueString}% s\xE1t th\u01B0\u01A1ng \u0111\xE3
      nh\u1EADn v\u1EC1 k\u1EBB t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 59010102501384192
    m_Localized: "Khi Pinequeek <smallcaps><color=#40E0D0>b\u1ECB th\u01B0\u01A1ng</color=#40E0D0></smallcaps>:
      Th\xEAm l\xE1 b\xE0i <color=#40E0D0>{1}</color=#40E0D0> v\xE0o tay b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 12276047190016000
    m_Localized: "T\u0103ng <style=\"Blue\">S\u1EE9c m\u1EA1nh</style> th\xEAm {Mystling.Power}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 12295938882256896
    m_Localized: "Golomo <smallcaps><style=\"Blue\">H\u1ED3i Sinh</style></smallcaps>
      m\u1ED9t l\u1EA7n m\u1ED7i Tr\u1EADn \u0111\u1EA5u.\nKhi Golomo <style=\"Blue\">G\u1EE5c
      Ng\xE3</style>, nh\xE2n \u0111\xF4i <smallcaps><style=\"Blue\">Mong Manh</style></smallcaps>
      tr\xEAn to\xE0n b\u1ED9 K\u1EBB \u0111\u1ECBch"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 12295938882256897
    m_Localized: "Khi Golomo <style=\"Blue\">G\u1EE5c Ng\xE3</style>, nh\xE2n \u0111\xF4i
      <smallcaps><style=\"Blue\">Mong Manh</style></smallcaps> tr\xEAn to\xE0n b\u1ED9
      K\u1EBB \u0111\u1ECBch"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405571
  - m_Id: 12304182178594816
    m_Localized: "Iceling nh\u1EADn th\xEAm <style=\"Blue\">S\u1EE9c m\u1EA1nh</style>
      b\u1EB1ng <style=\"Blue\">s\u1ED1 l\xE1 b\xE0i</style> tr\xEAn tay b\xE0i.\n\u0110\u1EA7u
      Tr\u1EADn \u0111\u1EA5u: G\xE2y <smallcaps><style=\"Blue\">Cho\xE1ng</style></smallcaps>
      cho to\xE0n b\u1ED9 K\u1EBB \u0111\u1ECBch"
