  - m_Id: 3202074980499471
    m_Localized: "Obra\u017Cenia"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499472
    m_Localized: Kara
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499473
    m_Localized: Odpoczynek
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499474
    m_Localized: "Og\u0142uszenie"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499475
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> mystlinga <style=\"Blue\">z
      przodu</style> i zada mu {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499477
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> <style=\"Blue\">ostatniego</style>
      mystlinga i zada mu {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499478
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> <style=\"Blue\">losowego</style>
      mystlinga i zada mu {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499479
    m_Localized: "Ten stw\xF3r zada {Action.Repeat} razy {Effect0.ValueInt} p. <style=\"Blue\">obra\u017Ce\u0144</style>
      <style=\"Blue\">losowym</style> mystlingom"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499480
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> <style=\"Blue\">wszystkie
      mystlingi</style> i zada im {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499481
    m_Localized: "Ten stw\xF3r zadaje <style=\"Blue\">obra\u017Cenia</style> r\xF3wne
      swojemu aktualnemu <style=\"Blue\">zdrowiu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499482
    m_Localized: Odpoczynek
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499483
    m_Localized: "Ten stw\xF3r przydzieli premi\u0119"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499484
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy kar\u0119"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499485
    m_Localized: "Przenosisz mystlinga na prz\xF3d."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499486
    m_Localized: "Ten stw\xF3r <style=\"Blue\">przywo\u0142a</style> innego stwora"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 14838014429700096
    m_Localized: Premia
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18375964392235008
    m_Localized: "Przenosi mystlinga z <style=\"Blue\">najmniejszym zdrowiem<style=\"Blue\">
      na <style=\"Blue\">prz\xF3d</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
