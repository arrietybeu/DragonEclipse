      - rid: 2105433060097654810
  - m_Id: 41239606510821377
    m_Localized: Skitterpaw
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 43421786716577792
    m_Localized: "Kryszta\u0142 za\u0107mienia"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 32864254625390593
    m_Localized: "Zdolno\u015B\u0107 specjalna"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30040975221006343
    m_Localized: "Kiedy ten stw\xF3r <style=\"Blue\">omdleje</style>, przywo\u0142a
      jedn\u0105 ma\u0142\u0105 larw\u0119"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30040975221006344
    m_Localized: "Kiedy ten stw\xF3r <style=\"Blue\">omdleje</style>, przywo\u0142a
      jedn\u0105 ma\u0142\u0105 nekrolarw\u0119"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499495
    m_Localized: "Pocz\u0105tek rundy: ten stw\xF3r zyskuje {Effect0.ValueInt} p.
      <style=\"Blue\">cierni</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 32874378098188288
    m_Localized: "Ten stw\xF3r jest niewra\u017Cliwy na <style=\"Blue\">og\u0142uszenie</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 32875559818174464
    m_Localized: "Wyssanie \u017Cycia na sta\u0142e"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 32885125649866752
    m_Localized: "Pocz\u0105tek rundy: wykrada {Effect1.ValueInt} szt. mystjagody
      LUB {Effect0.ValueInt} szt. z\u0142ota"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 42678251386118144
    m_Localized: "Kiedy ten stw\xF3r zostaje <style=\"Blue\">zaatakowany</style>,
      zyskuje {Effect0.ValueInt} p. <style=\"Blue\">gniewu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 42678251419672576
    m_Localized: "Kiedy ten stw\xF3r zostaje <style=\"Blue\">zaatakowany</style>,
      daje napastnikowi {Effect0.ValueInt} p. <style=\"Blue\">bezbronno\u015Bci</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 41288302829051905
    m_Localized: "Kiedy ten stw\xF3r wy\u0142ania si\u0119 z ziemi, zyskuje 10 p.
      maks. zdrowia oraz 3. p. <style=\"Blue\">gniewu</style> za ka\u017Cdy brakuj\u0105cy
      p. zdrowia.\nPo zakopaniu si\u0119 w ziemi zyskuje <style=\"Blue\">izolacj\u0119</style>,
      a jego maks. zdrowie maleje"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 41288302829051906
    m_Localized: "Kiedy ten stw\xF3r wy\u0142ania si\u0119 z ziemi, wybucha i zadaje
      wszystkim stworzeniom 20 p. obra\u017Ce\u0144"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 63368020864647168
    m_Localized: "Poni\u017Cej po\u0142owy zdrowia: zyskuje {Effect0.ValueInt} p.
      <style=\"Blue\">os\u0142abienia</style> "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28198348632694784
    m_Localized: "Poni\u017Cej po\u0142owy zdrowia: zyskuje {Effect0.ValueInt} p.
      <style=\"Blue\">gniewu</style> "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 69187890344738816
    m_Localized: "Ten stw\xF3r w ka\u017Cdej turze zyskuje {Effect0.ValueInt} p.
      <style=\"Blue\">bezbronno\u015Bci</style> "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28204206989058048
    m_Localized: "Poni\u017Cej po\u0142owy zdrowia: zyskuje na sta\u0142e {Effect0.ValueInt}
      <style=\"Blue\">{Effect0.ValueIntInt:p:wielocios|wielociosy|wielocios\xF3w}</style>\n"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 29980607761162240
    m_Localized: "Inny Gremlin <style=\"Blue\">omdlewa</style>: odzyskuje pe\u0142ni\u0119
      zdrowia, zyskuje {Effect1.ValueInt} p. <style=\"Blue\">os\u0142ony</style>
      oraz {Effect3.ValueInt} p. <style=\"Blue\">gniewu</style> <br>Zachowuje <style=\"Blue\">os\u0142on\u0119</style>
      na koniec rundy"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 70619883288772609
    m_Localized: "Pocz\u0105tek rundy: daje ostatniemu atakuj\u0105cemu mystlingowi
      {Effect0.ValueInt} p. <style=\"Blue\">os\u0142abienia</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 70619883288772610
    m_Localized: "Pocz\u0105tek rundy: zyskuje {Effect0.ValueInt} p. <style=\"Blue\">uniku<style=\"Blue\">"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30317001696157696
    m_Localized: "</style>Zaatakowany{Effect0.ValueInt}: zyskuje <style=\"Blue\">
      p. <style=\"Blue\">gniewu</style> <br>Co czwart\u0105 rund\u0119 staje si\u0119
      <style=\"Blue\">ods\u0142oni\u0119ty</style> (otrzymywane obra\u017Cenia s\u0105
      zwi\u0119kszane o 100% na jedn\u0105 tur\u0119, po trafieniu zyskuje <style=\"Blue\">os\u0142abienie</style>
      zamiast <style=\"Blue\">gniewu</style>)"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 32885125670838272
    m_Localized: "Niewra\u017Cliwo\u015B\u0107 na <style=\"Blue\">og\u0142uszenie</style>
      <br>Pocz\u0105tek walki: zyskuje {Effect1.ValueInt} p. <style=\"Blue\">uniku</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 32885125670838273
    m_Localized: "Niewra\u017Cliwo\u015B\u0107 na <style=\"Blue\">og\u0142uszenie</style>
      <br>Pocz\u0105tek rundy: je\u015Bli to mo\u017Cliwe, przywo\u0142uje 2 widma.
      <br>Widmo <style=\"Blue\">omdlewa</style>: traci {Effect3.ValueInt} p. <style=\"Blue\">zdrowia</style>
      i zyskuje {Effect2.ValueInt} p. <style=\"Blue\">gniewu</style> "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 51448208810909700
    m_Localized: "Zachowuje <style=\"Blue\">os\u0142on\u0119</style> mi\u0119dzy
      rundami <br><style=\"Blue\">Zaatakowane</style>: zyskuje {Effect0.ValueInt}
      p. <style=\"Blue\">cierni</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 51448208810909701
    m_Localized: "<style=\"Blue\">Omdlenie</style>: daje wszystkim wrogom {Effect0.ValueInt}
      p. <style=\"Blue\">cierni</style> za ka\u017Cd\u0105 rund\u0119, w kt\xF3rej
      by\u0142o \u017Cywe"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 51448208810909703
    m_Localized: 'Zagranie karty: leczy {Effect0.ValueInt} PZ'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 61231874130952192
    m_Localized: '<style="Blue">Zraniony</style>: zyskuje {Effect0.ValueInt} p. <style="Blue">uniku</style>'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499499
    m_Localized: "Zagranie karty: zyskuje {Effect0.ValueInt} p. <style=\"Blue\">si\u0142y</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28200547500761088
    m_Localized: "Kiedy zostaje <style=\"Blue\">zraniony</style>: zyskuje {Effect0.ValueInt}
      p. <style=\"Blue\">bezbronno\u015Bci</style>, a atakuj\u0105cemu mystlingowi
      daje {Effect1.ValueInt} p. <style=\"Blue\">bezbronno\u015Bci</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 41240425125715968
    m_Localized: "Niewra\u017Cliwo\u015B\u0107 na <style=\"Blue\">og\u0142uszenie</style>
      <br>Poni\u017Cej po\u0142owy zdrowia: na pocz\u0105tku nast\u0119pnej rundy
      poch\u0142ania znajduj\u0105ce si\u0119 za nim jajo i zyskuje {Effect2.ValueInt}
      p. maks. zdrowia oraz {Effect1.ValueInt} p. <style=\"Blue\">gniewu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30026794803470336
    m_Localized: "<style=\"Blue\">Zaatakowany</style>: zyskuje {Effect0.ValueInt}
      <style=\"Blue\">{Effect0.ValueIntInt:p:wielocios|wielociosy|wielocios\xF3w}</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30026794803470337
    m_Localized: "Poni\u017Cej po\u0142owy zdrowia: zyskuje na sta\u0142e {Effect0.ValueInt}
      <style=\"Blue\">{Effect0.ValueIntInt:p:wielocios|wielociosy|wielocios\xF3w}</style>\n"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30026794803470339
    m_Localized: "Zawsze przesuwa si\u0119 naprz\xF3d <br>Pocz\u0105tek walki: zyskuje
      {Effect1.ValueInt} p. <style=\"Blue\">os\u0142ony</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 29987945507266560
    m_Localized: "Ten stw\xF3r zada <style=\"Blue\">sobie</style> {Action.Power}
      p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 53218264817410048
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> mystlinga z przodu
      i zada mu trzy razy {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 41237795473268736
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> mystlinga z przodu
      i zada mu sze\u015B\u0107 razy {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 33956972315353088
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> mystlinga z przodu
      i zada mu dziesi\u0119\u0107 razy {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 21275692424437760
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> <style=\"Blue\">\u015Brodkowego</style>
      mystlinga i zada mu {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 43809184386457600
    m_Localized: "Ten stw\xF3r zada {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>
      <style=\"Blue\">wszystkim</style> stworzeniom"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 40897011834232832
    m_Localized: "Ten stw\xF3r <style=\"Blue\">wybuchnie</style> po ataku"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 21275692445409280
    m_Localized: "Ten stw\xF3r <style=\"Blue\">zaatakuje</style> mystlinga z <style=\"Blue\">najmniejszym
      zdrowiem</style> i zada mu {Action.Power} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 63760706464907264
    m_Localized: "Ten stw\xF3r <style=\"Blue\">nic nie zrobi</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28209715775348736
    m_Localized: "Ten stw\xF3r przygotowuje <style=\"Blue\">silny atak</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 76760452109836288
    m_Localized: Daje unik wrogowi z przodu
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 63320537472024576
    m_Localized: "Przenosi <style=\"Blue\">ostatniego mystlinga</style> na <style=\"Blue\">prz\xF3d</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 41266718798061568
    m_Localized: "Ten stw\xF3r przejdzie do innej <style=\"Blue\">fazy</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499503
    m_Localized: 4. runda
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499504
    m_Localized: 5. runda
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 3202074980499505
    m_Localized: 6. runda
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 14838014450671616
    m_Localized: "Kl\u0105twa"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 14838014450671617
    m_Localized: "Jeden p. energii mniej w ka\u017Cdej rundzie"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 14838014450671618
    m_Localized: "Wk\u0142ada do talii <style=\"Blue\">kart\u0119 kl\u0105twy</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 14838014450671619
    m_Localized: "Zwi\u0119ksza koszt w energii nast\u0119pnej dobranej karty"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 31416745155698688
    m_Localized: "Zwi\u0119ksza koszt w energii nast\u0119pnych {Effect0.ValueInt}
      dobranych kart"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 15098057276334080
    m_Localized: Wykrada graczowi mystjagody
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 15107087159861248
    m_Localized: "Na jedn\u0105 tur\u0119 zmniejsza wielko\u015B\u0107 r\u0119ki
      gracza"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 41634209193861120
    m_Localized: "W nast\u0119pnej rundzie wszystkie zagrywane karty b\u0119d\u0105
      wyczerpane"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28205321759563776
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy na <style=\"Blue\">siebie</style>
      <smallcaps><style=\"Blue\">os\u0142abienie</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598528
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">os\u0142abienie</style></smallcaps>
      na mystlinga <style=\"Blue\">z przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598529
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">os\u0142abienie</style></smallcaps>
      na <style=\"Blue\">losowego</style> mystlinga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28218877917863936
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy na <style=\"Blue\">siebie</style>
      <smallcaps><style=\"Blue\">bezbronno\u015B\u0107</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598530
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">bezbronno\u015B\u0107</style></smallcaps>
      na mystlinga <style=\"Blue\">z przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 63320537492996096
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">bezbronno\u015B\u0107</style></smallcaps>
      na <style=\"Blue\">ostatniego</style> mystlinga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18385638579576832
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">bezbronno\u015B\u0107</style></smallcaps>
      na <style=\"Blue\">wszystkie</style> mystlingi"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18386934791479296
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">bezbronno\u015B\u0107</style></smallcaps>
      na mystlinga z <style=\"Blue\">najmniejszym zdrowiem</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 20988887249788928
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">bezbronno\u015B\u0107</style></smallcaps>
      na <style=\"Blue\">losowego</style> mystlinga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18373772805480448
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">og\u0142uszenie</style></smallcaps>
      na mystlinga <style=\"Blue\">z przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18373772805480449
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">og\u0142uszenie</style></smallcaps>
      na <style=\"Blue\">\u015Brodkowego</style> mystlinga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 29990354140864512
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">og\u0142uszenie</style></smallcaps>
      na <style=\"Blue\">losowego</style> mystlinga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 34099718414868480
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">og\u0142uszenie</style></smallcaps>
      na <style=\"Blue\">wszystkie</style> mystlingi"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 51714386443706368
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">kwas</style></smallcaps>
      na mystlinga <style=\"Blue\">z przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 51715039991767040
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">kwas</style></smallcaps>
      na <style=\"Blue\">losowego</style> mystlinga"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598531
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">unik</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598532
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">gniew</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598533
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">gniew</style></smallcaps>
      na wroga <style=\"Blue\">z przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598534
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">gniew</style></smallcaps>
      na <style=\"Blue\">wszystkich</style> wrog\xF3w"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598535
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">os\u0142on\u0119</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598536
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">ciernie</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598537
    m_Localized: "Ten stw\xF3r na\u0142o\u017Cy <smallcaps><style=\"Blue\">ciernie</style></smallcaps>
      na wroga <style=\"Blue\">z przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598538
    m_Localized: "Ten stw\xF3r <style=\"Blue\">uleczy</style> <style=\"Blue\">siebie</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 18372613688598539
    m_Localized: "Ten stw\xF3r <style=\"Blue\">uleczy</style> wroga <style=\"Blue\">z
      przodu</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 40919038213300224
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">wyssanie \u017Cycia</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 51712258333548544
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">niezniszczalno\u015B\u0107</style></smallcaps>
      na jedn\u0105 rund\u0119"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 40937100899590144
    m_Localized: "Ten stw\xF3r przybierze <smallcaps><style=\"Blue\">cienist\u0105
      posta\u0107</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 40937100899590145
    m_Localized: "Ten stw\xF3r porzuci <smallcaps><style=\"Blue\">cienist\u0105 posta\u0107</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 23882141503791104
    m_Localized: "<smallcaps><style=\"Blue\">Rani</style></smallcaps> za {Effect0.ValueInt}
      p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 23882141503791105
    m_Localized: "<smallcaps><style=\"Blue\">Rani</style></smallcaps> \u015Brodkowego
      mystlinga za {Effect0.ValueInt} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 23882141503791106
    m_Localized: "<smallcaps><style=\"Blue\">Rani</style></smallcaps> ostatniego
      mystlinga za {Effect0.ValueInt} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 23882141503791107
    m_Localized: "<smallcaps><style=\"Blue\">Rani</style></smallcaps> wszystkie mystlingi
      za {Effect0.ValueInt} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 23882141503791108
    m_Localized: "<smallcaps><style=\"Blue\">Rani</style></smallcaps> losowego mystlinga
      za {Effect0.ValueInt} p. <style=\"Blue\">obra\u017Ce\u0144</style>"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28624890869432320
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">gard\u0119</style></smallcaps>
      na {Effect0.ValueInt] rund"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 28624890886209536
    m_Localized: "Ten stw\xF3r zyska <smallcaps><style=\"Blue\">ods\u0142oni\u0119cie</style></smallcaps>
      na {Effect0.ValueInt] rund"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30047564703277056
    m_Localized: "Ten stw\xF3r rzuci <style=\"Blue\">kl\u0105tw\u0119</style>: <smallcaps><style=\"Blue\">wykrada</style></smallcaps>
      {Effect0.ValueInt} szt. z\u0142ota lub 1 mystjagod\u0119"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
  - m_Id: 30047428094795776
    m_Localized: "Ten stw\xF3r rzuci <style=\"Blue\">kl\u0105tw\u0119</style>: usuwa
      z mystlinga z przodu wszystkie premie"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654810
