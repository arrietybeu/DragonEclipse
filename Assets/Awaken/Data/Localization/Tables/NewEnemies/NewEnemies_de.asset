    m_Localized: Schaden
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499472
    m_Localized: "Schw\xE4chung"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499473
    m_Localized: Ausruhen
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499474
    m_Localized: "Bet\xE4ubt"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499475
    m_Localized: "Diese Kreatur f\xFChrt einen <style=\"Blue\">Angriff</style> gegen
      den <style=\"Blue\">vordersten</style> Mystling aus und bewirkt {Action.Power}
      <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499477
    m_Localized: "Diese Kreatur f\xFChrt einen <style=\"Blue\">Angriff</style> gegen
      den <style=\"Blue\">letzten</style> Mystling aus und bewirkt {Action.Power}
      <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499478
    m_Localized: "Diese Kreatur f\xFChrt einen <style=\"Blue\">Angriff</style> gegen
      einen <style=\"Blue\">zuf\xE4lligen</style> Mystling aus und bewirkt {Action.Power}
      <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499479
    m_Localized: "Diese Kreatur bewirkt {Action.Repeat}-mal {Effect0.ValueInt} <style=\"Blue\">Schaden</style>
      bei <style=\"Blue\">zuf\xE4lligen</style> Mystlingen."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499480
    m_Localized: "Diese Kreatur f\xFChrt einen <style=\"Blue\">Angriff</style> gegen
      <style=\"Blue\">alle Mystlinge</style> aus und bewirkt {Action.Power} <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499481
    m_Localized: "Diese Kreatur bewirkt <style=\"Blue\">Schaden</style> in H\xF6he
      ihrer aktuellen <style=\"Blue\">Gesundheit</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499482
    m_Localized: Ausruhen
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499483
    m_Localized: "Diese Kreatur bewirkt eine St\xE4rkung."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499484
    m_Localized: "Diese Kreatur bewirkt eine Schw\xE4chung."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499485
    m_Localized: Bewege einen Mystling an die vorderste Position.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499486
    m_Localized: "Diese Kreatur <style=\"Blue\">beschw\xF6rt</style> eine Kreatur."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 14838014429700096
    m_Localized: "St\xE4rkung"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18375964392235008
    m_Localized: Ziehe den Mystling mit der <style="Blue">niedrigsten Gesundheit</style>
      nach <style="Blue">vorne</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30040975212617728
    m_Localized: Wurm
    m_Metadata:
