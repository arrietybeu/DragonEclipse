      - rid: 2105433060097654812
  - m_Id: 32864254625390592
    m_Localized: Umbra
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41239606510821377
    m_Localized: Skitterpaw
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 43421786716577792
    m_Localized: Kristall der Finsternis
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 32864254625390593
    m_Localized: "Spezialf\xE4higkeit"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30040975221006343
    m_Localized: "Wenn diese Kreatur <style=\"Blue\">kampfunf\xE4hig</style> wird,
      beschw\xF6rt sie einen Kleinen Wurm."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30040975221006344
    m_Localized: "Wenn diese Kreatur <style=\"Blue\">kampfunf\xE4hig</style> wird,
      beschw\xF6rt sie einen Nekrowurm."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499495
    m_Localized: "Rundenbeginn: Diese Kreatur erh\xE4lt {Effect0.ValueInt} <style=\"Blue\">Dornen</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 32874378098188288
    m_Localized: "Diese Kreatur ist immun gegen <style=\"Blue\">Bet\xE4uben</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 32875559818174464
    m_Localized: Permanenter Lebensraub
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 32885125649866752
    m_Localized: 'Rundenbeginn: Stiehl {Effect1.ValueInt} Mystbeere ODER {Effect0.ValueInt}
      Gold.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 42678251386118144
    m_Localized: "Wenn diese Kreatur <style=\"Blue\">angegriffen</style> wird, erh\xE4lt
      sie {Effect0.ValueInt} <style=\"Blue\">Zorn</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 42678251419672576
    m_Localized: Wenn diese Kreatur <style="Blue">angegriffen</style> wird, bewirkt
      sie {Effect0.ValueInt} <style="Blue">Verwundbarkeit</style> beim angreifenden
      Mystling.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41288302829051905
    m_Localized: "Nachdem diese Kreatur aus dem Boden aufsteigt, erh\xE4lt sie 10
      max. Gesundheit und 3 <style=\"Blue\">Zorn</style> je 1 fehlende Gesundheit.\nWenn
      sie in den Boden eintaucht, erh\xE4lt sie <style=\"Blue\">Abschirmen</style>
      und reduziert ihre max. Gesundheit."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41288302829051906
    m_Localized: Nachdem diese Kreatur aus dem Boden aufsteigt, explodiert sie und
      bewirkt 20 Schaden bei jeder Kreatur.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 63368020864647168
    m_Localized: "Gesundheit unter H\xE4lfte: Erhalte {Effect0.ValueInt} <style=\"Blue\">Schw\xE4che</style>. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28198348632694784
    m_Localized: "Gesundheit unter H\xE4lfte: Erhalte {Effect0.ValueInt} <style=\"Blue\">Zorn</style>. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 69187890344738816
    m_Localized: "Diese Kreatur erh\xE4lt jeden Zug {Effect0.ValueInt} <style=\"Blue\">Verwundbarkeit</style>. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28204206989058048
    m_Localized: "Gesundheit unter H\xE4lfte: Erhalte {Effect0.ValueInt} <style=\"Blue\">Permanenter
      Mehrfachangriff</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 29980607761162240
    m_Localized: "Anderer Gremlin wird <style=\"Blue\">kampfunf\xE4hig</style>: Stelle
      die volle Gesundheit wieder her, erhalte {Effect1.ValueInt} <style=\"Blue\">Schilde</style>
      und {Effect3.ValueInt} <style=\"Blue\">Zorn</style>.<br>Behalte <style=\"Blue\">Schilde</style>
      am Ende der Runde."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 70619883288772609
    m_Localized: "Rundenbeginn: Wirke {Effect0.ValueInt} <style=\"Blue\">Schw\xE4che</style>
      beim letzten angreifenden Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 70619883288772610
    m_Localized: 'Rundenbeginn: Erhalte {Effect0.ValueInt} <style="Blue">Ausweichen</style>.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30317001696157696
    m_Localized: "Wenn <style=\"Blue\">angegriffen</style>: Erhalte {Effect0.ValueInt}
      <style=\"Blue\">Zorn</style><br>Werde jede 4. Runde <style=\"Blue\">ungesch\xFCtzt</style>
      (Erh\xF6he den erlittenen Schaden f\xFCr einen Zug um 100 % und erhalte anschlie\xDFend
      <style=\"Blue\">Schw\xE4che</style> statt <style=\"Blue\">Zorn</style>)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 32885125670838272
    m_Localized: "Immunit\xE4t gegen <style=\"Blue\">Bet\xE4ubung</style>.<br>Kampfbeginn:
      Erhalte {Effect1.ValueInt} <style=\"Blue\">Ausweichen</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 32885125670838273
    m_Localized: "Immunit\xE4t gegen <style=\"Blue\">Bet\xE4uben</style>.<br>Rundenbeginn:
      Beschw\xF6re 2 Phantome, wenn m\xF6glich.<br>Phantom <style=\"Blue\">kampfunf\xE4hig</style>:
      Verliere {Effect3.ValueInt} <style=\"Blue\">LP</style> und erhalte {Effect2.ValueInt}
      <style=\"Blue\">Zorn</style>. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 51448208810909700
    m_Localized: 'Behalte <style="Blue">Schilde</style> zwischen Runden.<br>Wenn
      <style="Blue">angegriffen</style>: Erhalte {Effect0.ValueInt} <style="Blue">Dornen</style>.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 51448208810909701
    m_Localized: "<style=\"Blue\">Kampfunf\xE4hig</style>: Wirke {Effect0.ValueInt}
      <style=\"Blue\">Dornen</style> gegen alle Gegner f\xFCr jede \xFCberlebte Runde."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 51448208810909703
    m_Localized: 'Karte gespielt: Heile {Effect0.ValueInt} Gesundheit.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 61231874130952192
    m_Localized: '<style="Blue">Verletzt</style>: Erhalte {Effect0.ValueInt}<style="Blue">Ausweichen</style>.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499499
    m_Localized: "Karte gespielt: Erhalte {Effect0.ValueInt} <style=\"Blue\">St\xE4rke</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28200547500761088
    m_Localized: '<style="Blue">Verletzt</style>: Erhalte {Effect0.ValueInt} <style="Blue">Verwundbarkeit</style>
      und wirke {Effect1.ValueInt} <style="Blue">Verwundbarkeit</style> auf den angreifenden
      Mystling.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41240425125715968
    m_Localized: "Immunit\xE4t gegen <style=\"Blue\">Bet\xE4ubung</style>.<br>Gesundheit
      unter H\xE4lfte: Absorbiere ein hinteres Ei und erhalte {Effect2.ValueInt}
      max. Gesundheit und {Effect1.ValueInt} <style=\"Blue\">Zorn</style> zu Beginn
      der n\xE4chsten Runde."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30026794803470336
    m_Localized: 'Wenn <style="Blue">angegriffen</style>: Erhalte {Effect0.ValueInt}
      <style="Blue">Mehrfachangriff</style>.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30026794803470337
    m_Localized: "Gesundheit unter H\xE4lfte: Erhalte {Effect0.ValueInt} <style=\"Blue\">Permanenter
      Mehrfachangriff</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30026794803470339
    m_Localized: 'Geht immer ganz nach vorn.<br>Kampfbeginn: Erhalte {Effect1.ValueInt}
      <style="Blue">Schilde</style>.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 29987945507266560
    m_Localized: Diese Kreatur bewirkt {Action.Power} <style="Blue">Schaden</style>
      bei <style="Blue">sich selbst</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 53218264817410048
    m_Localized: "Diese Kreatur f\xFChrt 3-mal einen <style=\"Blue\">Angriff</style>
      gegen den vordersten Mystling aus und bewirkt {Action.Power} <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41237795473268736
    m_Localized: "Diese Kreatur f\xFChrt 6-mal einen <style=\"Blue\">Angriff</style>
      gegen den vordersten Mystling aus und bewirkt {Action.Power} <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 33956972315353088
    m_Localized: "Diese Kreatur f\xFChrt 10-mal einen <style=\"Blue\">Angriff</style>
      gegen den vordersten Mystling aus und bewirkt {Action.Power} <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 21275692424437760
    m_Localized: "Diese Kreatur f\xFChrt einen <style=\"Blue\">Angriff</style> gegen
      den <style=\"Blue\">mittleren</style> Mystling aus und bewirkt {Action.Power}
      <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 43809184386457600
    m_Localized: Diese Kreatur bewirkt {Action.Power} <style="Blue">Schaden</style>
      bei <style="Blue">allen</style> Kreaturen.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 40897011834232832
    m_Localized: Diese Kreatur <style="Blue">explodiert</style>, nachdem sie angegriffen
      hat.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 21275692445409280
    m_Localized: "Diese Kreatur f\xFChrt einen <style=\"Blue\">Angriff</style> gegen
      den Mystling mit der <style=\"Blue\">niedrigsten Gesundheit</style> aus und
      bewirkt {Action.Power} <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 63760706464907264
    m_Localized: Diese Kreatur <style="Blue">tut nichts</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28209715775348736
    m_Localized: Diese Kreatur bereitet einen <style="Blue">Starken Angriff</style>
      vor.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 76760452109836288
    m_Localized: Wirke Ausweichen auf den vordersten Gegner.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 63320537472024576
    m_Localized: Ziehe den <style="Blue">letzten Mystling</style> nach <style="Blue">vorne</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41266718798061568
    m_Localized: Diese Kreatur tritt in eine andere <style="Blue">Phase</style> ein.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499503
    m_Localized: In Runde 4
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499504
    m_Localized: In Runde 5
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 3202074980499505
    m_Localized: In Runde 6
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 14838014450671616
    m_Localized: Fluch
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 14838014450671617
    m_Localized: "1 Energiepunkt weniger n\xE4chste Runde."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 14838014450671618
    m_Localized: "F\xFCge dem Deck 1 <style=\"Blue\">Fluchkarte</style> hinzu."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 14838014450671619
    m_Localized: "Erh\xF6he die Energiekosten der n\xE4chsten gezogenen Karte."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 31416745155698688
    m_Localized: "Erh\xF6he die Energiekosten der n\xE4chsten {Effect0.ValueInt}
      gezogenen Karten."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 15098057276334080
    m_Localized: Stiehl Mystbeeren vom Spieler.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 15107087159861248
    m_Localized: "Reduziere das Kartenlimit des Spielers f\xFCr eine Runde."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 41634209193861120
    m_Localized: "Alle in der n\xE4chsten Runde gespielten Karten sind ersch\xF6pft."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28205321759563776
    m_Localized: "Diese Kreatur wirkt <smallcaps><style=\"Blue\">Schw\xE4che</style></smallcaps>
      auf <style=\"Blue\">sich selbst</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598528
    m_Localized: "Diese Kreatur wirkt <smallcaps><style=\"Blue\">Schw\xE4che</style></smallcaps>
      auf den <style=\"Blue\">vordersten</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598529
    m_Localized: "Diese Kreatur wirkt <smallcaps><style=\"Blue\">Schw\xE4che</style></smallcaps>
      auf einen <style=\"Blue\">zuf\xE4lligen</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28218877917863936
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Verwundbarkeit</style></smallcaps>
      auf <style="Blue">sich selbst</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598530
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Verwundbarkeit</style></smallcaps>
      auf den <style="Blue">vordersten</style> Mystling.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 63320537492996096
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Verwundbarkeit</style></smallcaps>
      auf den <style="Blue">letzten</style> Mystling.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18385638579576832
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Verwundbarkeit</style></smallcaps>
      auf <style="Blue">alle</style> Mystlinge.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18386934791479296
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Verwundbarkeit</style></smallcaps>
      auf den Mystling mit der <style="Blue">niedrigsten</style> Gesundheit.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 20988887249788928
    m_Localized: "Diese Kreatur wirkt <smallcaps><style=\"Blue\">Verwundbarkeit</style></smallcaps>
      auf einen <style=\"Blue\">zuf\xE4lligen</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18373772805480448
    m_Localized: "Diese Kreatur <smallcaps><style=\"Blue\">bet\xE4ubt</style></smallcaps>
      den <style=\"Blue\">vordersten</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18373772805480449
    m_Localized: "Diese Kreatur <smallcaps><style=\"Blue\">bet\xE4ubt</style></smallcaps>
      den <style=\"Blue\">mittleren</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 29990354140864512
    m_Localized: "Diese Kreatur <smallcaps><style=\"Blue\">bet\xE4ubt</style></smallcaps>
      einen <style=\"Blue\">zuf\xE4lligen</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 34099718414868480
    m_Localized: "Diese Kreatur <smallcaps><style=\"Blue\">bet\xE4ubt</style></smallcaps>
      <style=\"Blue\">alle</style> Mystlinge."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 51714386443706368
    m_Localized: "Diese Kreatur wirkt <smallcaps><style=\"Blue\">S\xE4ure</style></smallcaps>
      auf den <style=\"Blue\">vordersten</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 51715039991767040
    m_Localized: "Diese Kreatur wirkt <smallcaps><style=\"Blue\">S\xE4ure</style></smallcaps>
      auf einen <style=\"Blue\">zuf\xE4lligen</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598531
    m_Localized: "Diese Kreatur erh\xE4lt <smallcaps><style=\"Blue\">Ausweichen</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598532
    m_Localized: "Diese Kreatur erh\xE4lt <smallcaps><style=\"Blue\">Zorn</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598533
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Zorn</style></smallcaps>
      auf den <style="Blue">vordersten</style> Gegner.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598534
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Zorn</style></smallcaps>
      auf <style="Blue">alle</style> Gegner.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598535
    m_Localized: "Diese Kreatur erh\xE4lt <smallcaps><style=\"Blue\">Schilde</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598536
    m_Localized: "Diese Kreatur erh\xE4lt <smallcaps><style=\"Blue\">Dornen</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598537
    m_Localized: Diese Kreatur wirkt <smallcaps><style="Blue">Dornen</style></smallcaps>
      auf den <style="Blue">vordersten</style> Gegner.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598538
    m_Localized: Diese Kreatur <style="Blue">heilt</style> <style="Blue">sich selbst</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 18372613688598539
    m_Localized: Diese Kreatur <style="Blue">heilt</style> den <style="Blue">vordersten</style>
      Gegner.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 40919038213300224
    m_Localized: "Diese Kreatur erh\xE4lt <smallcaps><style=\"Blue\">Lebensraub</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 51712258333548544
    m_Localized: "Diese Kreatur wird f\xFCr eine Runde <smallcaps><style=\"Blue\">unzerst\xF6rbar</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 40937100899590144
    m_Localized: Diese Kreatur nimmt eine <smallcaps><style="Blue">Schattengestalt</style></smallcaps>
      an.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 40937100899590145
    m_Localized: Diese Kreatur legt ihre <smallcaps><style="Blue">Schattengestalt</style></smallcaps>
      ab.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 23882141503791104
    m_Localized: <smallcaps><style="Blue">Verwunde</style></smallcaps> und bewirke
      {Effect0.ValueInt} <style="Blue">Schaden</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 23882141503791105
    m_Localized: <smallcaps><style="Blue">Verwunde</style></smallcaps> den mittleren
      Mystling und bewirke {Effect0.ValueInt} <style="Blue">Schaden</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 23882141503791106
    m_Localized: <smallcaps><style="Blue">Verwunde</style></smallcaps> den letzten
      Mystling und bewirke {Effect0.ValueInt} <style="Blue">Schaden</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 23882141503791107
    m_Localized: <smallcaps><style="Blue">Verwunde</style></smallcaps> alle Mystlinge
      und bewirke {Effect0.ValueInt} <style="Blue">Schaden</style>.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 23882141503791108
    m_Localized: "<smallcaps><style=\"Blue\">Verwunde</style></smallcaps> einen zuf\xE4lligen
      Mystling und bewirke {Effect0.ValueInt} <style=\"Blue\">Schaden</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28624890869432320
    m_Localized: "Diese Kreatur geht f\xFCr {Effect0.ValueInt} Runden in <smallcaps><style=\"Blue\">Abwehrhaltung</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 28624890886209536
    m_Localized: "Diese Kreatur ist f\xFCr {Effect0.ValueInt} Runde <smallcaps><style=\"Blue\">ungesch\xFCtzt</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30047564703277056
    m_Localized: 'Diese Kreatur wirkt einen <style="Blue">Fluch</style>: <smallcaps><style="Blue">Stiehl</style></smallcaps>
      {Effect0.ValueInt} Gold oder 1 Mystbeere.'
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
  - m_Id: 30047428094795776
    m_Localized: "Diese Kreatur wirkt einen <style=\"Blue\">Fluch</style>: Entferne
      alle St\xE4rkungen vom vordersten Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654812
