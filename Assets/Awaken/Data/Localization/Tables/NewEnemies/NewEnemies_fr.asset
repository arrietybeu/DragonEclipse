      \xE0 un Mystling <style=\"Blue\">au hasard</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28218877917863936
    m_Localized: "Cette cr\xE9ature va s'infliger <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      \xE0 <style=\"Blue\">elle-m\xEAme</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598530
    m_Localized: "Cette cr\xE9ature va infliger <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 63320537492996096
    m_Localized: "Cette cr\xE9ature va infliger <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      au <style=\"Blue\">dernier</style> Mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18385638579576832
    m_Localized: "Cette cr\xE9ature va infliger <smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      \xE0 <style=\"Blue\">tous</style> les Mystlings."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
