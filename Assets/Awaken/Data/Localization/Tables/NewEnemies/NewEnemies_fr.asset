      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499495
    m_Localized: "D\xE9but du round\_: cette cr\xE9ature gagne {Effect0.ValueInt}\_<style=\"Blue\">\xC9pines</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 32874378098188288
    m_Localized: "Cette cr\xE9ature est immunis\xE9e contre l'<style=\"Blue\">\xE9tourdissement</style>."
