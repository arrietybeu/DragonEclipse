      - rid: 2105433060097654811
  - m_Id: 3202074980499475
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le Mystling
      en <style=\"Blue\">premi\xE8re ligne</style> et lui infliger {Action.Power}\_de
      <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499477
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le <style=\"Blue\">dernier</style>
      Mystling et lui infliger {Action.Power}\_de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499478
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> un Mystling
      <style=\"Blue\">au hasard</style> et lui infliger {Action.Power}\_de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499479
    m_Localized: "Cette cr\xE9ature va infliger {Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 {Action.Repeat}\_reprises \xE0 des Mystlings <style=\"Blue\">au hasard</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499480
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> <style=\"Blue\">tous
      les Mystlings</style> et leur infliger {Action.Power}\_de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499481
    m_Localized: "Cette cr\xE9ature inflige des <style=\"Blue\">d\xE9g\xE2ts</style>
      \xE9gaux \xE0 sa <style=\"Blue\">sant\xE9</style> actuelle."
