      m_Items:
      - rid: 2105433060097654811
  - m_Id: 32875559818174464
    m_Localized: Vol de vie permanent
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 32885125649866752
    m_Localized: "D\xE9but du round\_: vole {Effect1.ValueInt}\_Mystibaie OU {Effect0.ValueInt}\_or."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 42678251386118144
    m_Localized: "Quand cette cr\xE9ature est <style=\"Blue\">attaqu\xE9e</style>,
      elle gagne {Effect0.ValueInt}\_en <style=\"Blue\">Col\xE8re</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 42678251419672576
    m_Localized: "Quand cette cr\xE9ature est <style=\"Blue\">attaqu\xE9e</style>,
      elle inflige {Effect0.ValueInt}\_x\_<style=\"Blue\">Vuln\xE9rabilit\xE9</style>
      au Mystling qui l'attaque."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 41288302829051905
    m_Localized: "Apr\xE8s avoir \xE9merg\xE9 du sol, cette cr\xE9ature gagne +10
      \xE0 son maximum de <style=\"Blue\">sant\xE9</style> et 3 en <style=\"Blue\">Col\xE8re</style>
      par <style=\"Blue\">PV</style> manquant.\nQuand elle retourne sous terre, elle
      gagne <style=\"Blue\">\xC9cran</style> mais son maximum de <style=\"Blue\">sant\xE9</style>
      est r\xE9duit."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 41288302829051906
    m_Localized: "Apr\xE8s avoir \xE9merg\xE9 du sol, cette cr\xE9ature explose,
      ce qui inflige 20\_<style=\"Blue\">d\xE9g\xE2ts</style> \xE0 toutes les cr\xE9atures."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 63368020864647168
    m_Localized: "En dessous de 50\_% de <style=\"Blue\">sant\xE9</style>\_: subit
      {Effect0.ValueInt}\_x\_<style=\"Blue\">Faiblesse<style=\"Blue\">. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28198348632694784
    m_Localized: "En dessous de 50\_% de <style=\"Blue\">sant\xE9</style>\_: gagne
      {Effect0.ValueInt} en <style=\"Blue\">Col\xE8re<style=\"Blue\">. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 69187890344738816
    m_Localized: "La <style=\"Blue\">Vuln\xE9rabilit\xE9</style> de cette cr\xE9ature
      augmente de {Effect0.ValueInt} \xE0 chaque tour. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28204206989058048
    m_Localized: "En dessous de 50\_% de <style=\"Blue\">sant\xE9</style>\_: gagne
      {Effect0.ValueInt}\_x\_<style=\"Blue\">Attaques multiples</style> permanentes."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 29980607761162240
    m_Localized: "Un autre Gremlin <style=\"Blue\">s'\xE9vanouit</style>\_: r\xE9cup\xE8re
      toute sa <style=\"Blue\">sant\xE9</style>, gagne {Effect1.ValueInt}\_<style=\"Blue\">boucliers</style>,
      ainsi que {Effect3.ValueInt} en <style=\"Blue\">Col\xE8re</style>.<br>Conserve
      ses <style=\"Blue\">boucliers</style> \xE0 la fin du round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 70619883288772609
    m_Localized: "D\xE9but du round\_: inflige {Effect0.ValueInt}\_x\_<style=\"Blue\">Faiblesse</style>
      au dernier Mystling \xE0 avoir attaqu\xE9."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 70619883288772610
    m_Localized: "D\xE9but du round\_: gagne {Effect0.ValueInt}\_x\_<style=\"Blue\">Esquive<style=\"Blue\">."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 30317001696157696
    m_Localized: "Quand cette cr\xE9ature est <style=\"Blue\">attaqu\xE9e</style>\_:
      gagne {Effect0.ValueInt} en <style=\"Blue\">Col\xE8re</style>.<br>Elle se retrouve
      <style=\"Blue\">Sans d\xE9fense</style> tous les 4\_rounds (les <style=\"Blue\">d\xE9g\xE2ts</style>
      qu'elle subit sont alors augment\xE9s de 100\_% pour un tour, et elle subit
      <style=\"Blue\">Faiblesse</style> au lieu de gagner <style=\"Blue\">Col\xE8re</style>
      quand elle est touch\xE9e)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 32885125670838272
    m_Localized: "Immunit\xE9 contre l'<style=\"Blue\">\xE9tourdissement</style>.<br>D\xE9but
      du combat\_: gagne {Effect1.ValueInt}\_x\_<style=\"Blue\">Esquive</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 32885125670838273
    m_Localized: "Immunit\xE9 contre l'<style=\"Blue\">\xE9tourdissement</style>.<br>D\xE9but
      du round\_: invoque 2\_Mystlings spectraux si possible.<br>Un Mystling spectral
      <style=\"Blue\">s'\xE9vanouit</style>\_: perd {Effect3.ValueInt}\_<style=\"Blue\">PV</style>
      mais gagne {Effect2.ValueInt} en <style=\"Blue\">Col\xE8re</style>. "
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 51448208810909700
    m_Localized: "Conserve ses <style=\"Blue\">boucliers</style> d'un round \xE0
      l'autre.<br>Quand on l'<style=\"Blue\">attaque</style>\_: gagne {Effect0.ValueInt}\_<style=\"Blue\">\xC9pines</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 51448208810909701
    m_Localized: "Quand ce Mystling <style=\"Blue\">s'\xE9vanouit</style>\_: inflige
      {Effect0.ValueInt}\_<style=\"Blue\">\xC9pines</style> \xE0 tous les autres
      ennemis pour chaque round o\xF9 il a surv\xE9cu."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 51448208810909703
    m_Localized: "Carte jou\xE9e\_: soigne {Effect0.ValueInt}\_<style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 61231874130952192
    m_Localized: "<style=\"Blue\">Bless\xE9</style>\_: Gagne {Effect0.ValueInt}\_x\_<style=\"Blue\">Esquive</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499499
    m_Localized: "Carte jou\xE9e\_: gagne {Effect0.ValueInt} en <style=\"Blue\">Force</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28200547500761088
    m_Localized: "Quand cette cr\xE9ature est <style=\"Blue\">bless\xE9e</style>\_:
      elle subit {Effect0.ValueInt}\_x\_<style=\"Blue\">Vuln\xE9rabilit\xE9</style>
      et inflige {Effect1.ValueInt}\_x\_<style=\"Blue\">Vuln\xE9rabilit\xE9</style>
      au Mystling qui l'attaque."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 41240425125715968
    m_Localized: "Immunit\xE9 contre l'<style=\"Blue\">\xE9tourdissement</style>.<br>En
      dessous de 50\_% de <style=\"Blue\">sant\xE9</style>\_: au d\xE9but du prochain
      round, absorbe un \u0153il et gagne {Effect2.ValueInt}\_au maximum de <style=\"Blue\">sant\xE9</style>,
      ainsi que {Effect1.ValueInt} en <style=\"Blue\">Col\xE8re</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 30026794803470336
    m_Localized: "Quand il est <style=\"Blue\">attaqu\xE9</style>\_: gagne {Effect0.ValueInt}\_x\_<style=\"Blue\">Attaques
      multiples</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 30026794803470337
    m_Localized: "En dessous de 50\_% de <style=\"Blue\">sant\xE9</style>\_: gagne
      {Effect0.ValueInt}\_x\_<style=\"Blue\">Attaques multiples</style> permanentes."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 30026794803470339
    m_Localized: "Se place toujours en <style=\"Blue\">premi\xE8re ligne</style>.<br>D\xE9but
      du combat\_: +{Effect1.ValueInt}\_<style=\"Blue\">boucliers</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 29987945507266560
    m_Localized: "Cette cr\xE9ature va s'infliger {Action.Power} de\_<style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 <style=\"Blue\">elle-m\xEAme</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 53218264817410048
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le Mystling
      en <style=\"Blue\">premi\xE8re ligne</style> et lui infliger {Action.Power}
      de\_<style=\"Blue\">d\xE9g\xE2ts</style> \xE0 3\_reprises."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 41237795473268736
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le Mystling
      en <style=\"Blue\">premi\xE8re ligne</style> et lui infliger {Action.Power}
      de\_<style=\"Blue\">d\xE9g\xE2ts</style> \xE0 6\_reprises."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 33956972315353088
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le Mystling
      en <style=\"Blue\">premi\xE8re ligne</style> et lui infliger {Action.Power}\_de
      <style=\"Blue\">d\xE9g\xE2ts</style> \xE0 10\_reprises."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 21275692424437760
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le Mystling
      du <style=\"Blue\">milieu</style> et lui infliger {Action.Power}\_de <style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 43809184386457600
    m_Localized: "Cette cr\xE9ature va infliger {Action.Power} de\_<style=\"Blue\">d\xE9g\xE2ts</style>
      \xE0 <style=\"Blue\">toutes</style> les cr\xE9atures."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 40897011834232832
    m_Localized: "Cette cr\xE9ature <style=\"Blue\">explosera</style> apr\xE8s avoir
      attaqu\xE9."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 21275692445409280
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">attaquer</style> le Mystling
      ayant <style=\"Blue\">le moins de sant\xE9</style> et lui infliger {Action.Power}
      de\_<style=\"Blue\">d\xE9g\xE2ts</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 63760706464907264
    m_Localized: "Cette cr\xE9ature <style=\"Blue\">ne fera rien</style> pendant
      ce round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28209715775348736
    m_Localized: "Cette cr\xE9ature pr\xE9pare une <style=\"Blue\">Attaque puissante</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 76760452109836288
    m_Localized: "Conf\xE8re <style=\"Blue\">Esquive</style> \xE0 l'ennemi en <style=\"Blue\">premi\xE8re
      ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 63320537472024576
    m_Localized: "Am\xE8ne le <style=\"Blue\">dernier Mystling</style> en <style=\"Blue\">premi\xE8re
      ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 41266718798061568
    m_Localized: "Cette cr\xE9ature va passer dans une autre <style=\"Blue\">phase</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499503
    m_Localized: Au cours du 4e round
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499504
    m_Localized: Au cours du 5e round
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 3202074980499505
    m_Localized: Au cours du 6e round
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 14838014450671616
    m_Localized: "Mal\xE9diction"
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 14838014450671617
    m_Localized: "-1\_en \xE9nergie lors du round suivant."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 14838014450671618
    m_Localized: "Ajoute une <style=\"Blue\">carte Mal\xE9diction</style> \xE0 votre
      deck."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 14838014450671619
    m_Localized: "Augmente le co\xFBt en \xE9nergie de la prochaine carte pioch\xE9e."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 31416745155698688
    m_Localized: "Augmente le co\xFBt en \xE9nergie des {Effect0.ValueInt}\_prochaines
      cartes pioch\xE9es."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 15098057276334080
    m_Localized: Vole des Mystibaies au joueur.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 15107087159861248
    m_Localized: "R\xE9duit la taille de la main du joueur pendant 1\_tour."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 41634209193861120
    m_Localized: "Toutes les cartes jou\xE9es au round suivant seront \xE9puis\xE9es."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28205321759563776
    m_Localized: "Cette cr\xE9ature va s'infliger <smallcaps><style=\"Blue\">Faiblesse</style></smallcaps>
      \xE0 <style=\"Blue\">elle-m\xEAme</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
