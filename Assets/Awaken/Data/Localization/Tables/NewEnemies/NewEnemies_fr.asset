      m_Items:
      - rid: 2105433060097654811
  - m_Id: 29990354140864512
    m_Localized: "Cette cr\xE9ature va <smallcaps><style=\"Blue\">\xE9tourdir</style></smallcaps>
      un Mystling <style=\"Blue\">au hasard</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 34099718414868480
    m_Localized: "Cette cr\xE9ature va <smallcaps><style=\"Blue\">\xE9tourdir</style></smallcaps>
      <style=\"Blue\">tous</style> les Mystlings."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 51714386443706368
    m_Localized: "Cette cr\xE9ature va infliger <smallcaps><style=\"Blue\">Acide</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 51715039991767040
    m_Localized: "Cette cr\xE9ature va infliger <smallcaps><style=\"Blue\">Acide</style></smallcaps>
      \xE0 un Mystling <style=\"Blue\">au hasard</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598531
    m_Localized: "Cette cr\xE9ature va gagner <smallcaps><style=\"Blue\">Esquive</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598532
    m_Localized: "Cette cr\xE9ature va gagner <smallcaps><style=\"Blue\">Col\xE8re</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598533
    m_Localized: "Cette cr\xE9ature va conf\xE9rer <smallcaps><style=\"Blue\">Col\xE8re</style></smallcaps>
      \xE0 l'ennemi en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598534
    m_Localized: "Cette cr\xE9ature va conf\xE9rer <smallcaps><style=\"Blue\">Col\xE8re</style></smallcaps>
      \xE0 <style=\"Blue\">tous</style> les ennemis."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598535
    m_Localized: "Cette cr\xE9ature va gagner des <smallcaps><style=\"Blue\">boucliers</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598536
    m_Localized: "Cette cr\xE9ature va gagner <smallcaps><style=\"Blue\">\xC9pines</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598537
    m_Localized: "Cette cr\xE9ature inflige <smallcaps><style=\"Blue\">\xC9pines</style></smallcaps>
      \xE0 l'ennemi en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598538
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">se soigner</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 18372613688598539
    m_Localized: "Cette cr\xE9ature va <style=\"Blue\">soigner</style> l'ennemi en
      <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 40919038213300224
    m_Localized: "Cette cr\xE9ature va gagner <smallcaps><style=\"Blue\">Vol de vie</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 51712258333548544
    m_Localized: "Cette cr\xE9ature va devenir <smallcaps><style=\"Blue\">Indestructible</style></smallcaps>
      pendant 1\_round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 40937100899590144
    m_Localized: "Cette cr\xE9ature va utiliser sa <smallcaps><style=\"Blue\">Forme
      d'ombre</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 40937100899590145
    m_Localized: "Cette cr\xE9ature va quitter sa <smallcaps><style=\"Blue\">Forme
      d'ombre</style></smallcaps>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 23882141503791104
    m_Localized: "<smallcaps><style=\"Blue\">Blesse</style></smallcaps> le Mystling
      en <style=\"Blue\">premi\xE8re ligne</style> ({Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 23882141503791105
    m_Localized: "<smallcaps><style=\"Blue\">Blesse</style></smallcaps> le Mystling
      du <style=\"Blue\">milieu</style> ({Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 23882141503791106
    m_Localized: "<smallcaps><style=\"Blue\">Blesse</style></smallcaps> le dernier
      Mystling ({Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 23882141503791107
    m_Localized: "<smallcaps><style=\"Blue\">Blesse</style></smallcaps> tous les
      Mystlings ({Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 23882141503791108
    m_Localized: "<smallcaps><style=\"Blue\">Blesse</style></smallcaps> un Mystling
      au hasard ({Effect0.ValueInt}\_de <style=\"Blue\">d\xE9g\xE2ts</style>)."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28624890869432320
    m_Localized: "Cette cr\xE9ature va b\xE9n\xE9ficier d'une <smallcaps><style=\"Blue\">Garde</style></smallcaps>
      pendant {Effect0.ValueInt}\_rounds."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 28624890886209536
    m_Localized: "Cette cr\xE9ature va se retrouver <smallcaps><style=\"Blue\">Sans
      d\xE9fense</style></smallcaps> pendant {Effect0.ValueInt}\_round."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 30047564703277056
    m_Localized: "Cette cr\xE9ature va lancer une <style=\"Blue\">Mal\xE9diction</style>\_:
      <smallcaps><style=\"Blue\">vole</style></smallcaps> {Effect0.ValueInt}\_or
      ou 1\_Mystibaie."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
  - m_Id: 30047428094795776
    m_Localized: "Cette cr\xE9ature va lancer une <style=\"Blue\">Mal\xE9diction</style>\_:
      supprime tous les buffs du Mystling en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
