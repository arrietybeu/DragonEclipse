    m_Localized: "Cette cr\xE9ature va infliger <smallcaps><style=\"Blue\">Faiblesse</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654811
