  - m_Id: 3202074980499475
    m_Localized: "Se inflige {Effect0.ValueInt} de da\xF1o."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499477
    m_Localized: "Se inflige {Effect0.ValueInt} de da\xF1o al \xFAltimo mystling."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499478
    m_Localized: "Se inflige {Effect0.ValueInt} de da\xF1o a un mystling al azar."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499479
    m_Localized: "Se inflige {Effect0.ValueInt} de da\xF1o a un mystling al azar
      {Effect1.ValueInt} veces."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499480
    m_Localized: "Se inflige {Effect0.ValueInt} de da\xF1o a todos los mystlings."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499481
    m_Localized: "Se inflige un da\xF1o equivalente a la salud."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499482
    m_Localized: Descanso.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499483
    m_Localized: Se aplica una mejora.
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499484
    m_Localized: "Se aplica una debilitaci\xF3n."
    m_Metadata:
      m_Items:
      - rid: 2105433060097654813
  - m_Id: 3202074980499485
    m_Localized: Se mueve un mystling al frente.
