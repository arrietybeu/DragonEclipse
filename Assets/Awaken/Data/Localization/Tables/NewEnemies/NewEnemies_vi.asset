      - rid: 8099901647879405577
  - m_Id: 53218264817410048
    m_Localized: "Sinh v\u1EADt n\xE0y s\u1EBD <style=\"Blue\">T\u1EA5n c\xF4ng</style>
      Mystling \u0111\u1EE9ng \u0111\u1EA7u, g\xE2y {Action.Power} <style=\"Blue\">s\xE1t
      th\u01B0\u01A1ng</style> 3 l\u1EA7n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 58687513618882560
    m_Localized: "Tr\u1EDF n\xEAn <style=\"Blue\">S\u01A1 H\u1EDF</style> m\u1ED7i
      4 V\xF2ng (T\u0103ng 100% s\xE1t th\u01B0\u01A1ng ph\u1EA3i nh\u1EADn trong
      m\u1ED9t l\u01B0\u1EE3t)"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 58688421891219456
    m_Localized: "Khi Pinequeak kh\xE1c <style=\"Blue\">ng\u1EA5t</style>: Nh\u1EADn
      1 <style=\"Blue\">\u0110a K\xEDch</style> v\xE0 1 <style=\"Blue\">N\xE9 Tr\xE1nh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 58691717615919104
    m_Localized: "Th\xF4ng L\u1EDBn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 58691793004339200
    m_Localized: "Th\xF4ng Nh\u1ECF"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 61231874130952192
    m_Localized: "<style=\"Blue\">B\u1ECB Th\u01B0\u01A1ng</style>: Nh\u1EADn {Effect0.ValueInt}
      <style=\"Blue\">N\xE9 Tr\xE1nh</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 63320537472024576
    m_Localized: "K\xE9o <style=\"Blue\">Mystling cu\u1ED1i h\xE0ng</style> l\xEAn
      <style=\"Blue\">\u0111\u1EA7u h\xE0ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 63320537492996096
    m_Localized: "Sinh v\u1EADt n\xE0y s\u1EBD \xE1p d\u1EE5ng <smallcaps><style=\"Blue\">Y\u1EBFu
      Th\u1EBF</style></smallcaps> l\xEAn Mystling <style=\"Blue\">cu\u1ED1i h\xE0ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 63368020864647168
    m_Localized: "M\xE1u d\u01B0\u1EDBi m\u1ED9t n\u1EEDa: Nh\u1EADn {Effect0.ValueInt}
      <style=\"Blue\">Suy Y\u1EBFu</style> "
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 63760706464907264
    m_Localized: "Sinh v\u1EADt n\xE0y s\u1EBD <style=\"Blue\">kh\xF4ng l\xE0m g\xEC
      c\u1EA3</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 68491981210370048
    m_Localized: "Tr\u1EDF n\xEAn <color=#40E0D0>S\u01A1 H\u1EDF</color=#40E0D0>
      m\u1ED7i 4 V\xF2ng (T\u0103ng 100% s\xE1t th\u01B0\u01A1ng ph\u1EA3i nh\u1EADn
      trong m\u1ED9t l\u01B0\u1EE3t)"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 69187890315378688
    m_Localized: Uttur
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 69187890344738816
    m_Localized: "Sinh v\u1EADt n\xE0y nh\u1EADn {Effect0.ValueInt} <style=\"Blue\">Y\u1EBFu
      Th\u1EBF</style> m\u1ED7i l\u01B0\u1EE3t "
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 70619883263606784
    m_Localized: "Nh\u1EC7n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 70619883288772608
    m_Localized: "Hi\u1EC7p S\u0129"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 70619883288772609
    m_Localized: "\u0110\u1EA7u V\xF2ng: \xC1p d\u1EE5ng {Effect0.ValueInt} <style=\"Blue\">Suy
      Y\u1EBFu</style> l\xEAn Mystling \u0111\xE3 t\u1EA5n c\xF4ng g\u1EA7n nh\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 70619883288772610
    m_Localized: "\u0110\u1EA7u V\xF2ng: Nh\u1EADn {Effect0.ValueInt} <style=\"Blue\">N\xE9
      Tr\xE1nh<style=\"Blue\">"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
  - m_Id: 76760452109836288
    m_Localized: "\xC1p d\u1EE5ng N\xE9 Tr\xE1nh l\xEAn K\u1EBB \u0111\u1ECBch \u0111\u1EE9ng
      \u0111\u1EA7u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405577
