    m_Localized: Bourse de plantes
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360772
    m_Localized: "Quand ce Mystling est <style=\"Blue\">attaqu\xE9</style>\_: <style=\"Blue\">soigne</style>
      le Mystling de <style=\"Blue\">derri\xE8re</style> et lui rend {Effect0.ValueInt}\_<style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360773
    m_Localized: "Diffuseur de col\xE8re"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360774
    m_Localized: "Quand ce Mystling <style=\"Blue\">s'\xE9vanouit</style>\_: inflige
      {Effect0.ValueInt}\_x\_<smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      \xE0 l'ennemi qui l'a vaincu."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360775
    m_Localized: Absorbeur de vie
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360776
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: <style=\"Blue\">augmente de mani\xE8re
      permanente</style> le maximum de <style=\"Blue\">sant\xE9</style> de ce Mystling
      de {Effect0.ValueInt}."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360777
    m_Localized: Boucle d'oreille maudite
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360778
    m_Localized: "Quand ce Mystling est <style=\"Blue\">attaqu\xE9</style>, il inflige
      {Effect0.ValueInt}\_x\_<smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      \xE0 l'ennemi en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360779
    m_Localized: Aura ardente
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360780
    m_Localized: "Quand ce Mystling est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>,
      il inflige {Effect0.ValueInt}\_x\_<smallcaps><style=\"Blue\">Vuln\xE9rabilit\xE9</style></smallcaps>
      \xE0 tous les ennemis."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360781
    m_Localized: Cape en soie
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360782
    m_Localized: "Chaque fois que les <smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      de ce Mystling parent des <style=\"Blue\">d\xE9g\xE2ts</style>\_: inflige {Effect0.ValueInt}\_de
      <style=\"Blue\">d\xE9g\xE2ts</style> \xE0 un ennemi au hasard."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360783
    m_Localized: "\xC9ventail primitif"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360784
    m_Localized: Ce Mystling prend toujours pour <style="Blue">cible le dernier ennemi</style>
      quand il <style="Blue">attaque</style>.
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360785
    m_Localized: Collation croustillante
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360786
    m_Localized: "Fin du combat\_: <smallcaps><style=\"Blue\">soigne</style></smallcaps>
      ce Mystling en lui rendant {Effect0.ValueInt}\_<style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360787
    m_Localized: Bourse sans fond
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360788
    m_Localized: "Fin du combat\_: +{Effect0.ValueInt} <style=\"Blue\">Mystibaies</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360789
    m_Localized: Rubis de sagesse
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360790
    m_Localized: "Toutes les 2\_<smallcaps><style=\"Blue\">activations</style></smallcaps>
      de ce Mystling\_: conf\xE8re {Effect0.ValueInt} en <smallcaps><style=\"Blue\">Force</style></smallcaps>
      au Mystling <style=\"Blue\">juste devant</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360791
    m_Localized: Graine de vie
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360792
    m_Localized: "Toutes les 5\_<smallcaps><style=\"Blue\">activations</style></smallcaps>
      de ce Mystling\_: <style=\"Blue\">soigne</style> le Mystling ayant le moins
      de <style=\"Blue\">sant\xE9</style> en lui rendant {Effect0.ValueInt}\_<style=\"Blue\">PV</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360793
    m_Localized: Tornade en bouteille
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360794
    m_Localized: "D\xE9but du combat\_: augmente la <style=\"Blue\">Puissance</style>
      de ce Mystling de {Effect0.AdditionalValueString} pour chaque autre Mystling
      \xE9vanoui."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360795
    m_Localized: "Armure renforc\xE9e"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 30751376099360796
    m_Localized: "Quand ce Mystling pare totalement une <style=\"Blue\">attaque</style>\_:
      <style=\"Blue\">piochez</style> {Effect0.ValueInt}\_carte."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 2097134497243153
    m_Localized: Fleur symbiotique
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 2097134497243154
    m_Localized: "Quand ce Mystling est <smallcaps><style=\"Blue\">bless\xE9</style></smallcaps>\_:
      <style=\"Blue\">piochez</style> {Effect0.ValueInt}\_carte."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 32593139952852992
    m_Localized: "Bouclier sacr\xE9"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 32593217694277632
    m_Localized: "Quand ce Mystling <smallcaps><style=\"Blue\">s'active</style></smallcaps>,
      il conf\xE8re {Effect0.ValueInt}\_<smallcaps><style=\"Blue\">boucliers</style></smallcaps>
      au Mystling en <style=\"Blue\">premi\xE8re ligne</style>."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  references:
    version: 2
    RefIds:
