    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263251
    m_Localized: Bougie bleue
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263252
    m_Localized: "Toutes les 10\_<smallcaps><style=\"Blue\">activations</style></smallcaps>
      de ce Mystling\_: <style=\"Blue\">r\xE9duit le co\xFBt en \xE9nergie</style>
      de la prochaine carte pioch\xE9e de {Effect0.ValueIntAbs}."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263253
    m_Localized: Masque de voleur
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263254
    m_Localized: "<style=\"Blue\">K.-O.</style>\_: +{Effect0.ValueInt}\_Mystibaie."
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263257
    m_Localized: "Poids \xE9trange"
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263258
    m_Localized: "Toutes les 3\_fois o\xF9 ce Mystling est <style=\"Blue\">attaqu\xE9</style>\_:
