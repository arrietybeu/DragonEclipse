    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 15183072744030242
    m_Localized: Bouton de cobalt
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 15183072744030243
    m_Localized: "Chaque fois que ce Mystling gagne des <smallcaps><style=\"Blue\">boucliers</style></smallcaps>,
