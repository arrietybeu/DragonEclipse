    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263259
    m_Localized: Racine infernale
    m_Metadata:
      m_Items:
      - rid: 8829885829830410410
  - m_Id: 12574292919263260
    m_Localized: "Ce Mystling conserve sa <smallcaps><style=\"Blue\">Force</style></smallcaps>
