  m_TableData:
  - m_Id: 1054480997097474
    m_Localized: "M\u1ED7i khi b\u1EA1n nh\u1EADn Th\u1ECBnh N\u1ED9, nh\u1EADn th\xEAm
      {0}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1054480997097473
    m_Localized: "X\xFAc T\xE1c Th\u1ECBnh N\u1ED9"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1077412796375040
    m_Localized: "M\xE1y T\u1EA1o Khi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1077412821540864
    m_Localized: "M\u1ED7i khi Mystling n\xE0y nh\u1EADn <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>,
      n\xF3 nh\u1EADn th\xEAm {Effect0.ValueInt}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1077412825735172
    m_Localized: "Khi\xEAn C\u1ED5 \u0110\u1EA1i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1077412825735173
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Mystling n\xE0y nh\u1EADn
      {Effect0.ValueInt} <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1077412825735174
    m_Localized: "Gi\xE1p Glarexus"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 1077412825735175
    m_Localized: "\u0110\u1EA7u V\xF2ng: Mystling n\xE0y nh\u1EADn {Effect0.ValueInt}
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243153
    m_Localized: "Hoa C\u1ED9ng Sinh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243154
    m_Localized: "Khi Mystling n\xE0y <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>:
      <style=\"Blue\">R\xFAt</style> {Effect0.ValueInt} l\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243159
    m_Localized: "B\u1ED9 B\xE0i D\u1EF1 Ph\xF2ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243160
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: <style=\"Blue\">R\xFAt</style>
      {Effect0.ValueInt} l\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243161
    m_Localized: "M\xE1y T\u1EA1o N\u0103ng L\u01B0\u1EE3ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243162
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Nh\u1EADn {Effect0.ValueInt}
      <style=\"Blue\">N\u0103ng l\u01B0\u1EE3ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243163
    m_Localized: "M\xE1y H\xFAt N\u0103ng L\u01B0\u1EE3ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2097134497243164
    m_Localized: "<style=\"Blue\">H\u1EA1 G\u1EE5c</style>: <style=\"Blue\">Gi\u1EA3m
      chi ph\xED N\u0103ng l\u01B0\u1EE3ng</style> c\u1EE7a l\xE1 b\xE0i r\xFAt ti\u1EBFp
      theo \u0111i {Effect0.ValueIntAbs}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2153463886757888
    m_Localized: "Pha L\xEA H\xECnh Tim"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2153463916118016
    m_Localized: "<style=\"Blue\">T\u0103ng v\u0129nh vi\u1EC5n</style> M\xE1u T\u1ED1i
      \u0110a c\u1EE7a Mystling n\xE0y th\xEAm {Blessing.MapEffects.ChangeMaxHealth}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2153463916118019
    m_Localized: "B\xFAt M\u1EF1c \u0110\u1ECF"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 2153463916118020
    m_Localized: "M\u1ED7i l\xE1 b\xE0i th\u1EE9 10 \u0111\u01B0\u1EE3c r\xFAt: <style=\"Blue\">Gi\u1EA3m</style>
      <style=\"Blue\">chi ph\xED</style> c\u1EE7a n\xF3 \u0111i {Effect0.ValueIntAbs}
      \u0111\u1EBFn h\u1EBFt V\xF2ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 32593217694277632
    m_Localized: "Khi Mystling n\xE0y <smallcaps><style=\"Blue\">K\xEDch ho\u1EA1t</style></smallcaps>,
      n\xF3 trao {Effect0.ValueInt} <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>
      cho Mystling \u0111\u1EA7u h\xE0ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 7139979398553600
    m_Localized: "B\xF9a N\u1EB7ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 7139979423719424
    m_Localized: "M\u1ED7i l\u1EA7n Mystling n\xE0y <smallcaps><style=\"Blue\">b\u1ECB
      th\u01B0\u01A1ng</style></smallcaps>: n\xF3 nh\u1EADn {Effect0.ValueInt} <smallcaps><style=\"Blue\">Th\u1ECBnh
      N\u1ED9</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 11226257450672128
    m_Localized: "\xC2n Hu\u1EC7 M\u1EDBi"
