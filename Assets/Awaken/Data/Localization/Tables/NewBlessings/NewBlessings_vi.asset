      - rid: 8099901647879405579
  - m_Id: 12574292919263270
    m_Localized: "T\u0103ng v\u0129nh vi\u1EC5n <style=\"Blue\">S\u1EE9c m\u1EA1nh</style>
      c\u1EE7a Mystling n\xE0y th\xEAm {Blessing.MapEffects.ChangePower}. \u0110\u1EA7u
      Tr\u1EADn \u0111\u1EA5u: <style=\"Blue\">G\xE2y</style> {Effect0.ValueInt}
      <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style> l\xEAn ch\xEDnh Mystling n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616898
    m_Localized: "T\u01B0\u1EE3ng Th\u1EA7n C\u1ED5 \u0110\u1EA1i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616899
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Mystling n\xE0y nh\u1EADn
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps> b\u1EB1ng s\u1ED1 Mystberries
      b\u1EA1n \u0111ang c\xF3"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616900
    m_Localized: "S\u1EEBng Huy\u1EC1n B\xED"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616901
    m_Localized: "Mystling n\xE0y nh\u1EADn {Effect0.ValueInt} <smallcaps><style=\"Blue\">S\u1EE9c
      m\u1EA1nh</style></smallcaps> sau khi b\u1EA5t k\u1EF3 Mystling n\xE0o c\u1EE7a
      b\u1EA1n <style=\"Blue\">ng\u1EA5t</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616902
    m_Localized: "H\u1EA1t Titan"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616903
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: T\u0103ng <style=\"Blue\">S\u1EE9c
      m\u1EA1nh</style> c\u1EE7a Mystling n\xE0y th\xEAm {Effect0.AdditionalValueString}
      cho m\u1ED7i Mystling kh\xE1c c\xF2n s\u1ED1ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616904
    m_Localized: "C\xE0nh C\xE2y Cu\u1ED3ng N\u1ED9"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 12616652625616905
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Mystling n\xE0y nh\u1EADn
      0-10 (ng\u1EABu nhi\xEAn) <smallcaps><style=\"Blue\">Th\u1ECBnh N\u1ED9</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13316158157602816
    m_Localized: "\u0110\xE1 Bay"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13316158174380032
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Trao {Effect0.ValueInt}
      <smallcaps><style=\"Blue\">C\xE1ch Ly</style></smallcaps> cho Mystling n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13353743697428480
    m_Localized: "Kh\u1EBF \u01AF\u1EDBc T\xE0 \xC1c"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13353743722594304
    m_Localized: "<style=\"Blue\">T\u0103ng v\u0129nh vi\u1EC5n</style> M\xE1u T\u1ED1i
      \u0110a c\u1EE7a Mystling n\xE0y th\xEAm {Blessing.MapEffects.ChangeMaxHealth}.
      Mystling n\xE0y kh\xF4ng th\u1EC3 \u0111\u01B0\u1EE3c <smallcaps><style=\"Blue\">h\u1ED3i
      sinh</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13356556225724416
    m_Localized: "V\xF2ng C\u1ED5 An To\xE0n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13356556225724417
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: Nh\u1EADn {Effect0.AdditionalValueString}
      <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps> cho m\u1ED7i \xC2n
      Hu\u1EC7 \u0111\u01B0\u1EE3c trang b\u1ECB l\xEAn Mystling n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13359693867106304
    m_Localized: "L\u1ECD Thu\u1ED1c M\u1EE1"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13359693867106305
    m_Localized: "<smallcaps><style=\"Blue\">H\u1ED3i sinh</style></smallcaps> Mystling
      n\xE0y (sau Tr\u1EADn \u0111\u1EA5u) l\xE0 mi\u1EC5n ph\xED"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13363163160494080
    m_Localized: "M\xF3ng Vu\u1ED1t G\xE0o Th\xE9t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 13363163160494081
    m_Localized: "T\u0103ng <style=\"Blue\">S\u1EE9c m\u1EA1nh</style> c\u1EE7a Mystling
      n\xE0y th\xEAm {Blessing.Charges}. <style=\"Blue\">Gi\u1EA3m</style> gi\xE1
      tr\u1ECB n\xE0y \u0111i {Effect1.ValueIntAbs} <style=\"Blue\">sau m\u1ED7i
      Tr\u1EADn \u0111\u1EA5u</style> cho \u0111\u1EBFn khi c\xF2n {Effect0.AdditionalValueString}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072714670080
    m_Localized: "Qu\u1EA3 S\u1EE9c M\u1EA1nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072739835904
    m_Localized: "T\u0103ng v\u0129nh vi\u1EC5n <style=\"Blue\">S\u1EE9c m\u1EA1nh</style>
      c\u1EE7a Mystling n\xE0y th\xEAm {Blessing.MapEffects.ChangePower}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072744030222
    m_Localized: "Tro L\u1EEDa"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072744030223
    m_Localized: "Sau khi <smallcaps><style=\"Blue\">H\u1ED3i sinh</style></smallcaps>:
      T\u0103ng v\u0129nh vi\u1EC5n <style=\"Blue\">S\u1EE9c m\u1EA1nh</style> c\u1EE7a
      Mystling n\xE0y th\xEAm {Effect0.ValueInt}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072744030224
    m_Localized: "M\u0169 N\u1EA5m Xanh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072744030225
    m_Localized: "<style=\"Blue\">Ng\u1EA5t</style>: <smallcaps><style=\"Blue\">H\u1ED3i
      sinh</style></smallcaps> Mystling n\xE0y v\u1EDBi <style=\"Blue\">\u0111\u1EA7y
      M\xE1u</style>. Ch\u1EC9 c\xF3 t\xE1c d\u1EE5ng m\u1ED9t l\u1EA7n "
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072744030242
    m_Localized: "N\xFAt Cobalt"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 15183072744030243
    m_Localized: "M\u1ED7i l\u1EA7n Mystling n\xE0y nh\u1EADn <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>,
      n\xF3 g\xE2y {Effect0.ValueInt} <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>
      l\xEAn m\u1ED9t K\u1EBB \u0111\u1ECBch ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 28242725364084736
    m_Localized: "X\xFAc T\xE1c Th\u1ECBnh N\u1ED9"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 28242725380861952
    m_Localized: "M\u1ED7i khi Mystling n\xE0y nh\u1EADn <smallcaps><style=\"Blue\">Th\u1ECBnh
      N\u1ED9</style></smallcaps>, n\xF3 nh\u1EADn th\xEAm {Effect0.ValueInt}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376074194944
    m_Localized: "Dao G\u0103m Tr\u1EE3 Th\u1EE7"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360768
    m_Localized: "M\u1ED7i l\u1EA7n Mystling n\xE0y <smallcaps><style=\"Blue\">K\xEDch
      ho\u1EA1t</style></smallcaps>, n\xF3 g\xE2y {Effect0.ValueInt} <smallcaps><style=\"Blue\">Y\u1EBFu
      Th\u1EBF</style></smallcaps> l\xEAn m\u1ED9t K\u1EBB \u0111\u1ECBch Ng\u1EABu
      nhi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360769
    m_Localized: "Totem T\u1EA9m \u0110\u1ED9c"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360770
    m_Localized: "Sau khi Mystling n\xE0y t\u1EA5n c\xF4ng, n\xF3 g\xE2y {Effect0.ValueInt}
      <smallcaps><style=\"Blue\">Y\u1EBFu Th\u1EBF</style></smallcaps> l\xEAn K\u1EBB
      \u0111\u1ECBch b\u1ECB t\u1EA5n c\xF4ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360771
    m_Localized: "T\xFAi Th\u1EA3o D\u01B0\u1EE3c"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360772
    m_Localized: "Khi Mystling n\xE0y b\u1ECB <style=\"Blue\">t\u1EA5n c\xF4ng</style>:
      <style=\"Blue\">H\u1ED3i</style> {Effect0.ValueInt} M\xE1u cho Mystling ph\xEDa
      sau"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360773
    m_Localized: "D\xE2y N\u1ED1i Ph\u1EABn N\u1ED9"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360774
    m_Localized: "Khi Mystling n\xE0y <style=\"Blue\">Ng\u1EA5t</style>, n\xF3 g\xE2y
      {Effect0.ValueInt} <smallcaps><style=\"Blue\">Y\u1EBFu Th\u1EBF</style></smallcaps>
      l\xEAn K\u1EBB \u0111\u1ECBch \u0111\xE3 h\u1EA1 g\u1EE5c n\xF3"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360775
    m_Localized: "M\xE1y H\xFAt Sinh L\u1EF1c"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360776
    m_Localized: "<style=\"Blue\">H\u1EA1 G\u1EE5c</style>: <style=\"Blue\">T\u0103ng
      v\u0129nh vi\u1EC5n</style> M\xE1u T\u1ED1i \u0110a c\u1EE7a Mystling n\xE0y
      th\xEAm {Effect0.ValueInt}"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360777
    m_Localized: "Khuy\xEAn Tai Nguy\u1EC1n R\u1EE7a"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360778
    m_Localized: "Khi Mystling n\xE0y b\u1ECB <style=\"Blue\">t\u1EA5n c\xF4ng</style>,
      n\xF3 g\xE2y {Effect0.ValueInt} <smallcaps><style=\"Blue\">Y\u1EBFu Th\u1EBF</style></smallcaps>
      l\xEAn K\u1EBB \u0111\u1ECBch \u0111\u1EA7u h\xE0ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360779
    m_Localized: "H\xE0o Quang R\u1EF1c L\u1EEDa"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360780
    m_Localized: "Khi Mystling n\xE0y <smallcaps><style=\"Blue\">b\u1ECB th\u01B0\u01A1ng</style></smallcaps>,
      n\xF3 g\xE2y {Effect0.ValueInt} <smallcaps><style=\"Blue\">Y\u1EBFu Th\u1EBF</style></smallcaps>
      l\xEAn to\xE0n b\u1ED9 K\u1EBB \u0111\u1ECBch"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360781
    m_Localized: "\xC1o Cho\xE0ng L\u1EE5a"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360782
    m_Localized: "M\u1ED7i khi <smallcaps><style=\"Blue\">Khi\xEAn</style></smallcaps>
      c\u1EE7a Mystling n\xE0y ch\u1EB7n <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style>:
      G\xE2y {Effect0.ValueInt} <style=\"Blue\">s\xE1t th\u01B0\u01A1ng</style> l\xEAn
      m\u1ED9t K\u1EBB \u0111\u1ECBch ng\u1EABu nhi\xEAn"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360783
    m_Localized: "Qu\u1EA1t Tay Th\xF4 S\u01A1"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360784
    m_Localized: "Mystling n\xE0y lu\xF4n <style=\"Blue\">nh\u1EAFm v\xE0o K\u1EBB
      \u0111\u1ECBch cu\u1ED1i h\xE0ng</style> khi <style=\"Blue\">t\u1EA5n c\xF4ng</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360785
    m_Localized: "B\xE1nh Gi\xF2n"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360786
    m_Localized: "Cu\u1ED1i Tr\u1EADn \u0111\u1EA5u: <smallcaps><style=\"Blue\">H\u1ED3i</style></smallcaps>
      {Effect0.ValueInt} <style=\"Blue\">M\xE1u</style> cho Mystling n\xE0y"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360787
    m_Localized: "T\xFAi \u0110\u1EF1ng S\xE2u"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360788
    m_Localized: "Cu\u1ED1i Tr\u1EADn \u0111\u1EA5u: Nh\u1EADn {Effect0.ValueInt}
      <style=\"Blue\">Mystberries</style>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360789
    m_Localized: "H\u1ED3ng Ng\u1ECDc Tr\xED Tu\u1EC7"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360790
    m_Localized: "M\u1ED7i l\u1EA7n <smallcaps><style=\"Blue\">K\xEDch ho\u1EA1t</style></smallcaps>
      th\u1EE9 2 c\u1EE7a Mystling n\xE0y: Trao {Effect0.ValueInt} <smallcaps><style=\"Blue\">Th\u1ECBnh
      N\u1ED9</style></smallcaps> cho Mystling ph\xEDa tr\u01B0\u1EDBc"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360791
    m_Localized: "H\u1EA1t Gi\u1ED1ng Sinh M\u1EC7nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360792
    m_Localized: "M\u1ED7i l\u1EA7n <smallcaps><style=\"Blue\">K\xEDch ho\u1EA1t</style></smallcaps>
      th\u1EE9 5 c\u1EE7a Mystling n\xE0y: <style=\"Blue\">H\u1ED3i</style> {Effect0.ValueInt}
      M\xE1u cho Mystling c\xF3 M\xE1u th\u1EA5p nh\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360793
    m_Localized: "L\u1ED1c Xo\xE1y \u0110\xF3ng Chai"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360794
    m_Localized: "\u0110\u1EA7u Tr\u1EADn \u0111\u1EA5u: T\u0103ng <style=\"Blue\">S\u1EE9c
      m\u1EA1nh</style> c\u1EE7a Mystling n\xE0y th\xEAm {Effect0.AdditionalValueString}
      cho m\u1ED7i Mystling kh\xE1c \u0111\xE3 ng\u1EA5t"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360795
    m_Localized: "T\u1EA5m Gi\xE1p Gia C\u1ED1"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 30751376099360796
    m_Localized: "Khi Mystling n\xE0y ch\u1EB7n ho\xE0n to\xE0n m\u1ED9t \u0111\xF2n
      <style=\"Blue\">T\u1EA5n c\xF4ng</style>: <style=\"Blue\">R\xFAt</style> {Effect0.ValueInt}
      l\xE1 b\xE0i"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 32593139952852992
    m_Localized: "Khi\xEAn Th\u1EA7n Th\xE1nh"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 39054421041029120
    m_Localized: "M\xE1y Nh\xE2n \u0110\xF4i Th\u1ECBnh N\u1ED9"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 39054421053612032
    m_Localized: "<style=\"Blue\">H\u1EA1 G\u1EE5c</style>: Nh\xE2n \u0111\xF4i <smallcaps><style=\"Blue\">Th\u1ECBnh
      N\u1ED9</style></smallcaps>"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 39054421053612033
    m_Localized: "M\u1EAFt Th\u1EA5u Th\u1ECB"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  - m_Id: 39054421053612034
    m_Localized: "M\u1ED7i l\u1EA7n <smallcaps><style=\"Blue\">K\xEDch ho\u1EA1t</style></smallcaps>
      th\u1EE9 5 c\u1EE7a Mystling n\xE0y: Gi\u1EA3m chi ph\xED <style=\"Blue\">N\u0103ng
      l\u01B0\u1EE3ng</style> c\u1EE7a m\u1ED9t l\xE1 b\xE0i ng\u1EABu nhi\xEAn tr\xEAn
      tay b\u1EA1n \u0111i {Effect0.ValueIntAbs} \u0111\u1EBFn h\u1EBFt V\xF2ng"
    m_Metadata:
      m_Items:
      - rid: 8099901647879405579
  references:
    version: 2
