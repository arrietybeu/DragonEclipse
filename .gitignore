# Unity generated folders (rebuilt locally, never commit)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Keep every .meta file whose asset is tracked
!/[Aa]ssets/**/*.meta

# Autogenerated Rider / VS / VS Code
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
