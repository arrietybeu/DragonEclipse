*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash / diagnostic output
sysinfo.txt
crashlytics-build.properties

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app

# Addressables build output.
# NOTE: Assets/StreamingAssets/aa is the SHIPPED bundle set and IS tracked —
# it is this project's source of truth. Never rebuild Addressables.
/[Ss]erver[Dd]ata/

